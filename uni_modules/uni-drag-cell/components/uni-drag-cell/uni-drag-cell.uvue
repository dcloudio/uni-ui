<template>
	<!-- #ifdef APP-ANDROID -->
	<view class="drag-cell-host" :style="hostStyle">
	<view class="drag-cell" :class="containerClass" :style="containerStyle">
		<view
			v-for="(item, index) in innerList"
			:key="itemIds.length > index ? itemIds[index] : index"
			class="drag-cell-item"
			:class="getItemClass(index)"
			:style="getItemStyle(index)"
			@touchstart.stop="onItemTouchStart($event, index)"
			@touchmove="onItemTouchMove"
			@touchend="onItemTouchEnd"
			@touchcancel="onItemTouchEnd">
			<view class="drag-cell-item-inner">
				<view class="drag-cell-slot-content">
					<slot :item="item" :index="index"></slot>
				</view>
				<view
					v-if="handleModeEnabled"
					class="drag-cell-handle"
					:class="getHandleClass(index)"
					@touchstart.stop="onHandleTouchStart($event, index)"
					@touchend.stop="onHandleTouchEnd"
					@touchcancel.stop="onHandleTouchEnd">
					<slot name="handle" :item="item" :index="index"></slot>
				</view>
			</view>
		</view>
		<view v-if="showAppendSlot && dragging != true" class="drag-cell-append" :style="getAppendStyle()">
			<slot name="append"></slot>
		</view>
		<view v-if="showDeleteBar" class="drag-cell-delete-bar" :class="overDeleteBar ? 'drag-cell-delete-bar-active' : ''">
			<text class="drag-cell-delete-text">{{ deleteBarText }}</text>
		</view>
		<view
			v-if="showAndroidDeleteProxy"
			class="drag-cell-delete-proxy"
			:style="getAndroidDeleteProxyStyle()">
			<view class="drag-cell-delete-proxy-inner">
				<slot :item="innerList[activeIndex]" :index="activeIndex"></slot>
			</view>
		</view>
		<view
			v-if="dragging && showClose != true"
			class="drag-cell-drag-layer"
			@touchmove.stop.prevent="onItemTouchMove"
			@touchend="onItemTouchEnd"
			@touchcancel="onItemTouchEnd">
		</view>
	</view>
	</view>
	<!-- #endif -->

	<!-- #ifndef APP-ANDROID -->
	<view class="drag-cell-host" :style="hostStyle">
	<view class="drag-cell" :class="containerClass" :style="containerStyle">
		<view
			v-for="(item, index) in innerList"
			:key="itemIds.length > index ? itemIds[index] : index"
			class="drag-cell-item"
			:class="getItemClass(index)"
			:style="getItemStyle(index)"
			<!-- #ifdef WEB -->
			@pointerdown.stop="onPointerDown($event, index)"
			@pointermove="onPointerMove"
			@pointerup="onPointerEnd"
			@pointercancel="onPointerEnd"
			<!-- #endif -->
			@touchstart.stop="onItemTouchStart($event, index)"
			@touchmove="onItemTouchMove"
			@touchend="onItemTouchEnd"
			@touchcancel="onItemTouchEnd">
			<view class="drag-cell-item-inner">
				<view class="drag-cell-slot-content">
					<slot :item="item" :index="index"></slot>
				</view>
				<view
					v-if="handleModeEnabled"
					class="drag-cell-handle"
					:class="getHandleClass(index)"
					<!-- #ifdef WEB -->
					@pointerdown.stop.prevent="onHandlePointerDown($event, index)"
					@pointerup.stop="onHandlePointerEnd"
					@pointercancel.stop="onHandlePointerEnd"
					<!-- #endif -->
					@touchstart.stop="onHandleTouchStart($event, index)"
					@touchend.stop="onHandleTouchEnd"
					@touchcancel.stop="onHandleTouchEnd">
					<slot name="handle" :item="item" :index="index"></slot>
				</view>
			</view>
		</view>
		<view v-if="showAppendSlot && dragging != true" class="drag-cell-append" :style="getAppendStyle()">
			<slot name="append"></slot>
		</view>
		<view v-if="showDeleteBar" class="drag-cell-delete-bar" :class="overDeleteBar ? 'drag-cell-delete-bar-active' : ''">
			<text class="drag-cell-delete-text">{{ deleteBarText }}</text>
		</view>
		<view
			v-if="dragging"
			class="drag-cell-drag-layer"
			<!-- #ifdef WEB -->
			@pointermove.stop.prevent="onPointerMove"
			@pointerup="onPointerEnd"
			@pointercancel="onPointerEnd"
			<!-- #endif -->
			@touchmove.stop.prevent="onItemTouchMove"
			@touchend="onItemTouchEnd"
			@touchcancel="onItemTouchEnd">
		</view>
	</view>
	</view>
	<!-- #endif -->
</template>

<script setup lang="uts">

	type ItemLayout = {
		left: number,
		pageTop: number,
		width: number,
		height: number,
		centerX: number,
		centerY: number
	}

	type QueryRect = {
		left: number,
		top: number,
		width: number,
		height: number,
		right?: number,
		bottom?: number,
		x?: number,
		y?: number
	}

	type DeleteBarLayout = {
		left: number,
		pageTop: number,
		right: number,
		bottom: number
	}

	type ContentInset = {
		top: number,
		bottom: number
	}

	type ContainerLayout = {
		left: number,
		pageTop: number,
		width: number,
		height: number
	}

	const props = defineProps({
		modelValue: {
			type: Array,
			required: false
		},
		column: {
			type: Number,
			default: 0
		},
		showClose: {
			type: Boolean,
			default: false
		},
		showAppend: {
			type: Boolean,
			default: true
		},
		handleMode: {
			type: Boolean,
			default: false
		}
	})

	const emit = defineEmits(['update:modelValue', 'change'])
	const instance = getCurrentInstance()
	const slots = useSlots()

	const innerList = ref(props.modelValue != null ? props.modelValue.slice() : [])
	const itemIds = ref<number[]>([])
	const layouts = ref<ItemLayout[]>([])
	const gridColumnCenters = ref<number[]>([])
	const gridRowCenters = ref<number[]>([])
	const previewItemIds = ref<number[]>([])
	const settling = ref(false)
	const dragging = ref(false)
	const activeIndex = ref(-1)
	const hoverIndex = ref(-1)
	const dragOffsetX = ref(0)
	const dragOffsetY = ref(0)
	const startTouchX = ref(0)
	const startTouchY = ref(0)
	const pendingIndex = ref(-1)
	const overDeleteBar = ref(false)
	const deleteBarLayout = ref<DeleteBarLayout | null>(null)
	const containerLayout = ref<ContainerLayout | null>(null)
	const activeViewLeft = ref(0)
	const activeViewTop = ref(0)
	const activeContentInsetTop = ref(0)
	const activeContentInsetBottom = ref(0)
	let activeContentElement : UniElement | null = null
	let activeItemElement : UniElement | null = null
	const dragCoordOffsetX = ref(0)
	const dragCoordOffsetY = ref(0)
	const nextItemId = ref(0)
	let longPressTimer = 0
	const longPressDuration = 350
	const pressCancelDistance = 10
	const dragActiveScale = 1.12
	const deleteBarHeight = 56

	const columnCount = computed(() : number => {
		const currentColumn = props.column as number
		if (currentColumn <= 0) {
			return 0
		}
		return Math.floor(currentColumn)
	})

	const containerClass = computed(() : string => {
		return columnCount.value > 0 ? 'drag-cell-grid' : 'drag-cell-row'
	})

	const showClose = computed(() : boolean => props.showClose == true)
	const showAppendSlot = computed(() : boolean => props.showAppend == true && slots['append'] != null)
	const handleModeEnabled = computed(() : boolean => props.handleMode == true && slots['handle'] != null)
	const showDeleteBar = computed(() : boolean => showClose.value && dragging.value)
	const activeDragScale = computed(() : number => {
		return handleModeEnabled.value ? 1 : dragActiveScale
	})
	const showAndroidDeleteProxy = computed(() : boolean => {
		// #ifdef APP-ANDROID
		return showClose.value == true && dragging.value == true && activeIndex.value >= 0 && activeIndex.value < innerList.value.length
		// #endif
		// #ifndef APP-ANDROID
		return false
		// #endif
	})
	const hostStyle = computed(() : string => {
		const currentContainerLayout = containerLayout.value
		if (dragging.value == true && currentContainerLayout != null) {
			return `height: ${currentContainerLayout.height}px;`
		}
		return ''
	})
	const containerStyle = computed(() : string => {
		const currentContainerLayout = containerLayout.value
		if (dragging.value == true && currentContainerLayout != null) {
			return `height: ${currentContainerLayout.height}px;`
		}
		return ''
	})
	const getAndroidDeleteProxyStyle = () : string => {
		if (showAndroidDeleteProxy.value != true || activeIndex.value < 0 || activeIndex.value >= layouts.value.length) {
			return 'display: none;'
		}
		const sourceLayout = layouts.value[activeIndex.value]
		return `position: fixed; left: ${activeViewLeft.value}px; top: ${activeViewTop.value}px; width: ${sourceLayout.width}px; height: ${sourceLayout.height}px; z-index: 30; transform: translateX(${dragOffsetX.value}px) translateY(${dragOffsetY.value}px) scale(${activeDragScale.value});`
	}
	const appLanguage = uni.getAppBaseInfo().appLanguage ?? 'en'

	type DeleteBarLocale = {
		idle: string,
		active: string
	}

	const getDeleteBarLocale = () : DeleteBarLocale => {
		const language = appLanguage.toLowerCase()
		if (language.indexOf('zh-hant') == 0 || language.indexOf('zh-tw') == 0 || language.indexOf('zh-hk') == 0 || language.indexOf('zh-mo') == 0) {
			return {
				idle: '\u62d6\u5230\u6b64\u8655\u522a\u9664',
				active: '\u9b06\u624b\u522a\u9664'
			}
		}
		if (language.indexOf('zh') == 0) {
			return {
				idle: '\u62d6\u5230\u6b64\u5904\u5220\u9664',
				active: '\u677e\u624b\u5220\u9664'
			}
		}
		if (language.indexOf('fr') == 0) {
			return {
				idle: 'Faites glisser ici pour supprimer',
				active: 'Rel\u00e2chez pour supprimer'
			}
		}
		if (language.indexOf('la') == 0) {
			return {
				idle: 'Huc trahe ut deleas',
				active: 'Dimitte ut deleas'
			}
		}
		return {
			idle: 'Drag here to delete',
			active: 'Release to delete'
		}
	}

	const deleteBarLocale = getDeleteBarLocale()
	const deleteBarText = computed(() : string => {
		return overDeleteBar.value ? deleteBarLocale.active : deleteBarLocale.idle
	})

	const createIdentityOrder = (length : number) : number[] => {
		const order : number[] = []
		for (let i = 0; i < length; i++) {
			order.push(i)
		}
		return order
	}

	const applyPreviewOrder = (order : number[]) => {
		const nextPreviewItemIds : number[] = []
		for (let i = 0; i < order.length; i++) {
			const sourceIndex = order[i]
			if (sourceIndex >= 0 && sourceIndex < itemIds.value.length) {
				nextPreviewItemIds.push(itemIds.value[sourceIndex])
			}
		}
		previewItemIds.value = nextPreviewItemIds
	}

	const findPreviewPosition = (itemId : number) : number => {
		for (let i = 0; i < previewItemIds.value.length; i++) {
			if (previewItemIds.value[i] == itemId) {
				return i
			}
		}
		return -1
	}

	const buildIdList = (length : number) : number[] => {
		const ids : number[] = []
		for (let i = 0; i < length; i++) {
			ids.push(nextItemId.value)
			nextItemId.value = nextItemId.value + 1
		}
		return ids
	}

	function clearLongPressTimer() : void {
		if (longPressTimer != 0) {
			clearTimeout(longPressTimer)
			longPressTimer = 0
		}
	}

	const resetDragState = () => {
		clearLongPressTimer()
		dragging.value = false
		activeIndex.value = -1
		hoverIndex.value = -1
		pendingIndex.value = -1
		overDeleteBar.value = false
		deleteBarLayout.value = null
		activeViewLeft.value = 0
		activeViewTop.value = 0
		activeContentInsetTop.value = 0
		activeContentInsetBottom.value = 0
		activeContentElement = null
		activeItemElement = null
		dragCoordOffsetX.value = 0
		dragCoordOffsetY.value = 0
		dragOffsetX.value = 0
		dragOffsetY.value = 0
		applyPreviewOrder(createIdentityOrder(innerList.value.length))
	}

	const getCurrentTargetRect = (target : UniElement | null) : QueryRect | null => {
		if (target == null) {
			return null
		}
		const rect = target.getBoundingClientRect()
		return {
			left: rect.left,
			top: rect.top,
			width: rect.width,
			height: rect.height,
			right: rect.right,
			bottom: rect.bottom
		}
	}

	const getSlotContentElement = (itemElement : UniElement | null) : UniElement | null => {
		if (itemElement == null) {
			return null
		}
		const slotWrapper = itemElement.querySelector('.drag-cell-slot-content') as UniElement | null
		if (slotWrapper == null) {
			return null
		}
		const firstChild = slotWrapper.firstChild
		if (firstChild != null && firstChild instanceof UniElement) {
			return firstChild as UniElement
		}
		return slotWrapper
	}

	const getContentElement = (currentTarget : UniElement | null, eventTarget : UniElement | null) : UniElement | null => {
		const slotContentElement = getSlotContentElement(currentTarget)
		if (slotContentElement != null) {
			return slotContentElement
		}
		const currentRect = getCurrentTargetRect(currentTarget)
		if (currentRect == null || eventTarget == null) {
			return null
		}
		let directContentElement : UniElement | null = null
		let candidateElement : UniElement | null = null
		let candidateArea = -1.0
		const currentArea = currentRect.width * currentRect.height
		let node : UniElement | null = eventTarget
		let guard = 0
		while (node != null && node != currentTarget && guard < 12) {
			const parent = node.parentElement
			if (parent != null && parent.parentElement == currentTarget) {
				directContentElement = node
			}
			const rect = node.getBoundingClientRect()
			const width = rect.width
			const height = rect.height
			const area = width * height
			if (width > 0 && height > 0 && area < currentArea - 0.5 && area > candidateArea) {
				candidateArea = area
				candidateElement = node
			}
			node = parent
			guard++
		}
		if (directContentElement != null) {
			return directContentElement
		}
		return candidateElement
	}

	const getContentInset = (currentTarget : UniElement | null, contentElement : UniElement | null) : ContentInset => {
		const currentRect = getCurrentTargetRect(currentTarget)
		if (currentRect == null || contentElement == null) {
			return {
				top: 0,
				bottom: 0
			}
		}
		const currentBottom = currentRect.bottom != null ? currentRect.bottom : (currentRect.top + currentRect.height)
		const contentRect = contentElement.getBoundingClientRect()
		let topInset = contentRect.top - currentRect.top
		let bottomInset = currentBottom - contentRect.bottom
		if (topInset < 0) {
			topInset = 0
		}
		if (bottomInset < 0) {
			bottomInset = 0
		}
		return {
			top: topInset,
			bottom: bottomInset
		}
	}

	const rebuildGridAxisCache = (nextLayouts : ItemLayout[]) => {
		const nextColumnCenters : number[] = []
		const nextRowCenters : number[] = []
		const length = nextLayouts.length
		const columns = columnCount.value
		if (columns > 0 && length > 0) {
			const actualColumns = Math.min(columns, length)
			for (let i = 0; i < actualColumns; i++) {
				nextColumnCenters.push(nextLayouts[i].centerX)
			}
			for (let i = 0; i < length; i += actualColumns) {
				nextRowCenters.push(nextLayouts[i].centerY)
			}
		}
		gridColumnCenters.value = nextColumnCenters
		gridRowCenters.value = nextRowCenters
	}



	function measureLayouts() : void {
		if (instance == null || instance.proxy == null) {
			return
		}
		const query = uni.createSelectorQuery().in(instance.proxy)
		query.select('.drag-cell').boundingClientRect((rect) => {
			if (rect != null) {
				const containerRect = rect as NodeInfo
				let top = containerRect.top != null ? containerRect.top : 0
				const height = containerRect.height != null ? containerRect.height : 0
				if (top == 0 && containerRect.bottom != null) {
					top = containerRect.bottom - height
				}
				containerLayout.value = {
					left: containerRect.left != null ? containerRect.left : 0,
					pageTop: top,
					width: containerRect.width != null ? containerRect.width : 0,
					height
				}
			}
		})
		query.selectAll('.drag-cell-item').boundingClientRect((rects) => {
			const nextLayouts : ItemLayout[] = []
			if (rects != null) {
				const rectList = rects as NodeInfo[]
				for (let i = 0; i < rectList.length; i++) {
					const rect = rectList[i]
					const left = rect.left != null ? rect.left : 0
					let top = rect.top != null ? rect.top : 0
					const width = rect.width != null ? rect.width : 0
					const height = rect.height != null ? rect.height : 0
					if (top == 0 && rect.bottom != null) {
						top = rect.bottom - height
					}
					nextLayouts.push({
						left,
						pageTop: top,
						width,
						height,
						centerX: left + width / 2,
						centerY: top + height / 2
					})
				}
			}
			layouts.value = nextLayouts
			rebuildGridAxisCache(nextLayouts)
		})
		query.exec()
	}

	const syncFromModel = () => {
		if (dragging.value) {
			return
		}
		innerList.value = props.modelValue != null ? props.modelValue.slice() : []
		itemIds.value = buildIdList(innerList.value.length)
		resetDragState()
		nextTick(() => {
			measureLayouts()
		})
	}

	const emitChange = () => {
		emit('update:modelValue', innerList.value)
		emit('change', innerList.value)
	}

	watch(() : number => {
		const list = props.modelValue
		return list != null ? list.length : -1
	}, (_newLength : number) => {
		syncFromModel()
	})

	watch(() : number => {
		return columnCount.value
	}, (_newColumn : number) => {
		nextTick(() => {
			measureLayouts()
		})
	})

	const getWebWindowTopOffset = () : number => {
		// #ifdef WEB
		return uni.getWindowInfo().windowTop
		// #endif
		// #ifndef WEB
		return 0
		// #endif
	}

	const measureDeleteBar = () => {
		if (instance == null || instance.proxy == null || showDeleteBar.value != true) {
			deleteBarLayout.value = null
			return
		}
		uni.createSelectorQuery()
			.in(instance.proxy)
			.select('.drag-cell-delete-bar')
			.boundingClientRect((rect) => {
				if (rect != null) {
					const barRect = rect as NodeInfo
					const left = barRect.left != null ? barRect.left : 0
					const top = barRect.top != null ? barRect.top : 0
					const width = barRect.width != null ? barRect.width : 0
					const height = barRect.height != null ? barRect.height : 0
					const right = barRect.right != null ? barRect.right : (left + width)
					const bottom = barRect.bottom != null ? barRect.bottom : (top + height)
					deleteBarLayout.value = {
						left,
						pageTop: top,
						right,
						bottom: bottom
					}
				} else {
					deleteBarLayout.value = null
				}
			})
			.exec()
	}



	const buildPreviewOrder = (length : number, from : number, to : number) : number[] => {
		const order = createIdentityOrder(length)
		if (from == to) {
			return order
		}
		order.splice(from, 1)
		order.splice(to, 0, from)
		return order
	}

	const findNearestAxisIndex = (centers : number[], value : number) : number => {
		let nearestIndex = 0
		let nearestDistance = -1.0
		for (let i = 0; i < centers.length; i++) {
			const distance = Math.abs(centers[i] - value)
			if (nearestDistance < 0 || distance < nearestDistance) {
				nearestDistance = distance
				nearestIndex = i
			}
		}
		return nearestIndex
	}

	const getGridHoverIndex = (centerX : number, centerY : number) : number => {
		const length = layouts.value.length
		const columns = columnCount.value
		if (columns <= 0 || length == 0) {
			return activeIndex.value
		}

		const actualColumns = Math.min(columns, length)
		const columnIndex = findNearestAxisIndex(gridColumnCenters.value, centerX)
		const rowIndex = findNearestAxisIndex(gridRowCenters.value, centerY)
		const rowStart = rowIndex * actualColumns
		const rowEnd = Math.min(rowStart + actualColumns, length)
		let targetIndex = rowStart + columnIndex
		if (targetIndex >= rowEnd) {
			targetIndex = rowEnd - 1
		}
		return targetIndex
	}

	const updateHoverIndex = () => {
		const currentActiveIndex = activeIndex.value
		if (currentActiveIndex < 0 || currentActiveIndex >= layouts.value.length) {
			return
		}
		const sourceLayout = layouts.value[currentActiveIndex]
		const centerX = sourceLayout.left + sourceLayout.width / 2 + dragOffsetX.value
		const centerY = sourceLayout.pageTop + sourceLayout.height / 2 + dragOffsetY.value
		if (columnCount.value > 0) {
			const touchX = startTouchX.value + dragOffsetX.value + dragCoordOffsetX.value
			const touchY = startTouchY.value + dragOffsetY.value + dragCoordOffsetY.value
			const targetIndex = getGridHoverIndex(touchX, touchY)
			if (targetIndex != hoverIndex.value) {
				hoverIndex.value = targetIndex
				applyPreviewOrder(buildPreviewOrder(innerList.value.length, currentActiveIndex, targetIndex))
			}
			return
		}
		let nearestIndex = currentActiveIndex
		let nearestDistance = -1.0
		for (let i = 0; i < layouts.value.length; i++) {
			const layout = layouts.value[i]
			const deltaX = layout.centerX - centerX
			const deltaY = layout.centerY - centerY
			const distance = deltaX * deltaX + deltaY * deltaY
			if (nearestDistance < 0 || distance < nearestDistance) {
				nearestDistance = distance
				nearestIndex = i
			}
		}
		if (nearestIndex != hoverIndex.value) {
			hoverIndex.value = nearestIndex
			applyPreviewOrder(buildPreviewOrder(innerList.value.length, currentActiveIndex, nearestIndex))
		}
	}

	const cancelPendingPress = () => {
		clearLongPressTimer()
		pendingIndex.value = -1
	}

	const setDragContext = (clientX : number, clientY : number, viewLeft : number, viewTop : number, contentInset : ContentInset, contentElement : UniElement | null, itemElement : UniElement | null) => {
		startTouchX.value = clientX
		startTouchY.value = clientY
		activeViewLeft.value = viewLeft
		activeViewTop.value = viewTop
		activeContentInsetTop.value = contentInset.top
		activeContentInsetBottom.value = contentInset.bottom
		activeContentElement = contentElement
		activeItemElement = itemElement
	}

	const prepareDragContext = (clientX : number, clientY : number, itemElement : UniElement | null, eventTarget : UniElement | null) => {
		const rect = getCurrentTargetRect(itemElement)
		const contentElement = getContentElement(itemElement, eventTarget)
		const contentInset = getContentInset(itemElement, contentElement)
		const viewLeft = rect != null ? rect.left : 0
		const viewTop = rect != null ? rect.top : 0
		setDragContext(clientX, clientY, viewLeft, viewTop, contentInset, contentElement, itemElement)
	}

	const getItemElementFromHandle = (handleElement : UniElement | null) : UniElement | null => {
		if (handleElement == null) {
			return null
		}
		const innerElement = handleElement.parentElement
		if (innerElement == null) {
			return null
		}
		return innerElement.parentElement
	}

	function beginDrag(index : number, clientX : number, clientY : number) : void {
		if (layouts.value.length != innerList.value.length || index >= layouts.value.length) {
			measureLayouts()
			cancelPendingPress()
			return
		}
		clearLongPressTimer()
		pendingIndex.value = -1
		startTouchX.value = clientX
		startTouchY.value = clientY
		dragOffsetX.value = 0
		dragOffsetY.value = 0
		dragCoordOffsetX.value = layouts.value[index].left - activeViewLeft.value
		dragCoordOffsetY.value = layouts.value[index].pageTop - activeViewTop.value
		settling.value = false
		dragging.value = true
		activeIndex.value = index
		hoverIndex.value = index
		overDeleteBar.value = false
		applyPreviewOrder(createIdentityOrder(innerList.value.length))
		nextTick(() => {
			measureDeleteBar()
		})
	}

	const beginHandleDrag = (index : number, clientX : number, clientY : number, handleElement : UniElement | null, eventTarget : UniElement | null) => {
		const itemElement = getItemElementFromHandle(handleElement)
		prepareDragContext(clientX, clientY, itemElement, eventTarget)
		beginDrag(index, clientX, clientY)
	}

	const updateDeleteBarState = () => {
		if (showClose.value != true || dragging.value != true || activeIndex.value < 0 || activeIndex.value >= layouts.value.length) {
			overDeleteBar.value = false
			return
		}
		const barLayout = deleteBarLayout.value
		if (barLayout == null) {
			overDeleteBar.value = false
			return
		}
		const sourceLayout = layouts.value[activeIndex.value]
		let contentLeft = sourceLayout.left + dragOffsetX.value
		let contentRight = sourceLayout.left + sourceLayout.width + dragOffsetX.value
		let contentTop = sourceLayout.pageTop + activeContentInsetTop.value + dragOffsetY.value
		let contentBottom = sourceLayout.pageTop + sourceLayout.height - activeContentInsetBottom.value + dragOffsetY.value
		// #ifdef APP-ANDROID
		if (showAndroidDeleteProxy.value == true) {
			const windowInfo = uni.getWindowInfo()
			const barLeftAndroid = 0
			const barRightAndroid = windowInfo.windowWidth
			const barTopAndroid = windowInfo.windowHeight - deleteBarHeight
			const scaledWidth = sourceLayout.width * activeDragScale.value
			const scaledHeight = sourceLayout.height * activeDragScale.value
			const deltaX = (scaledWidth - sourceLayout.width) / 2
			const deltaY = (scaledHeight - sourceLayout.height) / 2
			const scaledTop = activeViewTop.value + dragOffsetY.value - deltaY
			let insetTopAndroid = activeContentInsetTop.value
			let insetBottomAndroid = activeContentInsetBottom.value
			const maxInsetAndroid = Math.max(0, sourceLayout.height / 2 - 1)
			const invalidInsetAndroid = insetTopAndroid < 0 || insetBottomAndroid < 0 || insetTopAndroid > maxInsetAndroid || insetBottomAndroid > maxInsetAndroid || insetTopAndroid + insetBottomAndroid >= sourceLayout.height - 1
			if (invalidInsetAndroid) {
				insetTopAndroid = 0
				insetBottomAndroid = 0
			}
			contentLeft = activeViewLeft.value + dragOffsetX.value - deltaX
			contentRight = contentLeft + scaledWidth
			contentTop = scaledTop + insetTopAndroid * activeDragScale.value
			contentBottom = scaledTop + scaledHeight - insetBottomAndroid * activeDragScale.value
			const horizontalOverlapAndroid = contentRight >= barLeftAndroid && contentLeft <= barRightAndroid
			const bottomReachedDeleteBarAndroid = contentBottom >= barTopAndroid
			const isInsideAndroid = horizontalOverlapAndroid && bottomReachedDeleteBarAndroid
			if (isInsideAndroid != overDeleteBar.value) {
				overDeleteBar.value = isInsideAndroid
				if (isInsideAndroid) {
					hoverIndex.value = activeIndex.value
					applyPreviewOrder(createIdentityOrder(innerList.value.length))
				}
			}
			return
		}
		// #endif
		const windowTopOffset = getWebWindowTopOffset()
		const liveContentRect = getCurrentTargetRect(activeContentElement)
		if (liveContentRect != null) {
			contentLeft = liveContentRect.left
			contentRight = liveContentRect.right != null ? liveContentRect.right : (liveContentRect.left + liveContentRect.width)
			contentTop = liveContentRect.top
			contentBottom = liveContentRect.bottom != null ? liveContentRect.bottom : (liveContentRect.top + liveContentRect.height)
			// #ifdef WEB
			contentTop = contentTop - windowTopOffset
			contentBottom = contentBottom - windowTopOffset
			// #endif
		} else {
			const liveItemRect = getCurrentTargetRect(activeItemElement)
			if (liveItemRect != null && sourceLayout.height > 0) {
				const liveRight = liveItemRect.right != null ? liveItemRect.right : (liveItemRect.left + liveItemRect.width)
				const liveBottom = liveItemRect.bottom != null ? liveItemRect.bottom : (liveItemRect.top + liveItemRect.height)
				const scaleY = liveItemRect.height / sourceLayout.height
				contentLeft = liveItemRect.left
				contentRight = liveRight
				contentTop = liveItemRect.top + activeContentInsetTop.value * scaleY
				contentBottom = liveBottom - activeContentInsetBottom.value * scaleY
				// #ifdef WEB
				contentTop = contentTop - windowTopOffset
				contentBottom = contentBottom - windowTopOffset
				// #endif
			} else if (showClose.value == true) {
				const scaledCenterX = sourceLayout.width / 2
				const scaledCenterY = sourceLayout.height / 2
				const contentTopLocal = activeContentInsetTop.value
				const contentBottomLocal = sourceLayout.height - activeContentInsetBottom.value
				contentLeft = activeViewLeft.value + dragOffsetX.value + scaledCenterX + (0 - scaledCenterX) * activeDragScale.value
				contentRight = activeViewLeft.value + dragOffsetX.value + scaledCenterX + (sourceLayout.width - scaledCenterX) * activeDragScale.value
				contentTop = activeViewTop.value + dragOffsetY.value + scaledCenterY + (contentTopLocal - scaledCenterY) * activeDragScale.value
				contentBottom = activeViewTop.value + dragOffsetY.value + scaledCenterY + (contentBottomLocal - scaledCenterY) * activeDragScale.value
			}
		}
		const measuredTop = barLayout.pageTop
		const horizontalOverlap = contentRight >= barLayout.left && contentLeft <= barLayout.right
		const bottomReachedDeleteBar = contentBottom >= measuredTop
		const isInside = horizontalOverlap && bottomReachedDeleteBar
		if (isInside != overDeleteBar.value) {
			overDeleteBar.value = isInside
			if (isInside) {
				hoverIndex.value = activeIndex.value
				applyPreviewOrder(createIdentityOrder(innerList.value.length))
			}
		}
	}

	const scheduleLongPress = (index : number, clientX : number, clientY : number, viewLeft : number, viewTop : number, contentInset : ContentInset, contentElement : UniElement | null, itemElement : UniElement | null) => {
		clearLongPressTimer()
		pendingIndex.value = index
		setDragContext(clientX, clientY, viewLeft, viewTop, contentInset, contentElement, itemElement)
		longPressTimer = setTimeout(() => {
			longPressTimer = 0
			beginDrag(index, clientX, clientY)
		}, longPressDuration)
	}





	const moveDrag = (clientX : number, clientY : number) => {
		if (dragging.value == true && activeIndex.value >= 0) {
			dragOffsetX.value = clientX - startTouchX.value
			dragOffsetY.value = clientY - startTouchY.value
			updateDeleteBarState()
			if (overDeleteBar.value != true) {
				updateHoverIndex()
			}
			return
		}
		if (pendingIndex.value >= 0) {
			const deltaX = clientX - startTouchX.value
			const deltaY = clientY - startTouchY.value
			const distanceSquare = deltaX * deltaX + deltaY * deltaY
			if (distanceSquare > pressCancelDistance * pressCancelDistance) {
				cancelPendingPress()
			}
		}
	}

	const finishDrag = () => {
		if (pendingIndex.value >= 0) {
			cancelPendingPress()
			return
		}
		if (dragging.value != true || activeIndex.value < 0) {
			return
		}
		const currentActiveIndex = activeIndex.value
		if (showClose.value == true) {
			updateDeleteBarState()
		}
		if (showClose.value == true && overDeleteBar.value == true) {
			const nextList = innerList.value.slice()
			const nextIds = itemIds.value.slice()
			nextList.splice(currentActiveIndex, 1)
			nextIds.splice(currentActiveIndex, 1)
			settling.value = true
			resetDragState()
			innerList.value = nextList
			itemIds.value = nextIds
			emitChange()
			nextTick(() => {
				measureLayouts()
				settling.value = false
			})
			return
		}
		const targetIndex = hoverIndex.value
		if (targetIndex < 0 || targetIndex == currentActiveIndex) {
			resetDragState()
			return
		}

		const nextList = innerList.value.slice()
		const nextIds = itemIds.value.slice()
		const movedItem = nextList.splice(currentActiveIndex, 1)[0]
		const movedId = nextIds.splice(currentActiveIndex, 1)[0]
		nextList.splice(targetIndex, 0, movedItem)
		nextIds.splice(targetIndex, 0, movedId)

		settling.value = true
		resetDragState()
		innerList.value = nextList
		itemIds.value = nextIds
		emitChange()
		nextTick(() => {
			measureLayouts()
			settling.value = false
		})
	}

	// #ifdef APP-ANDROID
	const onItemTouchStart = (event : Any, index : number) => {
		if (handleModeEnabled.value == true) {
			return
		}
		const touchEvent = event as UniTouchEvent
		const touch = touchEvent.touches[0]
		const target = touchEvent.currentTarget as UniElement
		const eventTarget = touchEvent.target as UniElement
		const rect = getCurrentTargetRect(target)
		const contentElement = getContentElement(target, eventTarget)
		const contentInset = getContentInset(target, contentElement)
		const viewLeft = rect != null ? rect.left : 0
		const viewTop = rect != null ? rect.top : 0
		scheduleLongPress(index, touch.clientX, touch.clientY, viewLeft, viewTop, contentInset, contentElement, target)
	}

	const onItemTouchMove = (event : Any) => {
		const touchEvent = event as UniTouchEvent
		const touch = touchEvent.touches[0]
		if (dragging.value == true) {
			touchEvent.preventDefault()
		}
		moveDrag(touch.clientX, touch.clientY)
	}

	const onItemTouchEnd = (_event : Any) => {
		finishDrag()
	}

	const onHandleTouchStart = (event : Any, index : number) => {
		if (handleModeEnabled.value != true) {
			return
		}
		const touchEvent = event as UniTouchEvent
		const touch = touchEvent.touches[0]
		const handleTarget = touchEvent.currentTarget as UniElement
		const eventTarget = touchEvent.target as UniElement
		beginHandleDrag(index, touch.clientX, touch.clientY, handleTarget, eventTarget)
	}

	const onHandleTouchEnd = (_event : Any) => {
		if (dragging.value == true) {
			finishDrag()
			return
		}
		cancelPendingPress()
	}
	// #endif

	// #ifndef APP-ANDROID
	const onItemTouchStart = (event : UniTouchEvent, index : number) => {
		if (handleModeEnabled.value == true) {
			return
		}
		const touch = event.touches[0]
		const target = event.currentTarget as UniElement
		const eventTarget = event.target as UniElement
		const rect = getCurrentTargetRect(target)
		const contentElement = getContentElement(target, eventTarget)
		const contentInset = getContentInset(target, contentElement)
		const viewLeft = rect != null ? rect.left : 0
		const viewTop = rect != null ? rect.top : 0
		scheduleLongPress(index, touch.clientX, touch.clientY, viewLeft, viewTop, contentInset, contentElement, target)
	}

	const onItemTouchMove = (event : UniTouchEvent) => {
		const touch = event.touches[0]
		if (dragging.value == true) {
			// console.log('harmony 应该阻止默认滚动')
			event.preventDefault()  //TODO 鸿蒙上这里无法阻止滚动，导致拖动时页面也跟着滚动 @wangzhitong
		}
		moveDrag(touch.clientX, touch.clientY)
	}

	const onItemTouchEnd = (_event : UniTouchEvent) => {
		finishDrag()
	}

	const onHandleTouchStart = (event : UniTouchEvent, index : number) => {
		if (handleModeEnabled.value != true) {
			return
		}
		const touch = event.touches[0]
		const handleTarget = event.currentTarget as UniElement
		const eventTarget = event.target as UniElement
		beginHandleDrag(index, touch.clientX, touch.clientY, handleTarget, eventTarget)
	}

	const onHandleTouchEnd = (_event : UniTouchEvent) => {
		if (dragging.value == true) {
			finishDrag()
			return
		}
		cancelPendingPress()
	}
	// #endif


	// #ifdef WEB
	const onPointerDown = (event : UniPointerEvent, index : number) => {
		if (handleModeEnabled.value == true) {
			return
		}
		const target = event.currentTarget as UniElement
		const eventTarget = event.target as UniElement
		const rect = getCurrentTargetRect(target)
		const contentElement = getContentElement(target, eventTarget)
		const contentInset = getContentInset(target, contentElement)
		const viewLeft = rect != null ? rect.left : 0
		const viewTop = rect != null ? rect.top : 0
		scheduleLongPress(index, event.x, event.y, viewLeft, viewTop, contentInset, contentElement, target)
	}

	const onPointerMove = (event : UniPointerEvent) => {
		if (dragging.value == true) {
			event.preventDefault()
		}
		moveDrag(event.x, event.y)
	}

	const onPointerEnd = (_event : UniPointerEvent) => {
		finishDrag()
	}

	const onHandlePointerDown = (event : UniPointerEvent, index : number) => {
		if (handleModeEnabled.value != true) {
			return
		}
		const handleTarget = event.currentTarget as UniElement
		const eventTarget = event.target as UniElement
		beginHandleDrag(index, event.x, event.y, handleTarget, eventTarget)
	}

	const onHandlePointerEnd = (_event : UniPointerEvent) => {
		if (dragging.value == true) {
			finishDrag()
			return
		}
		cancelPendingPress()
	}
	// #endif

	const getItemClass = (index : number) : string => {
		if (dragging.value == true && activeIndex.value == index) {
			return 'drag-cell-item-active'
		}
		return ''
	}

	const getHandleClass = (index : number) : string => {
		if (handleModeEnabled.value == true && dragging.value == true && activeIndex.value == index) {
			return 'drag-cell-handle-active'
		}
		return ''
	}

	const getItemStyle = (index : number) : string => {
		let widthStyle = 'width: auto;'
		let positionStyle = ''
		if (columnCount.value > 0) {
			widthStyle = `width: ${100 / columnCount.value}%;`
		}

		let zIndexStyle = 'z-index: 1;'
		let transitionStyle = 'transition-duration: 200ms;'
		let transformStyle = 'translateX(0px) translateY(0px)'

		// #ifdef APP-ANDROID
		if (dragging.value == true && columnCount.value > 0) {
			transitionStyle = 'transition-duration: 0ms;'
		}
		// #endif

		if (settling.value == true) {
			transitionStyle = 'transition-duration: 0ms;'
		}

		const currentContainerLayout = containerLayout.value
		if (dragging.value == true && index < layouts.value.length && currentContainerLayout != null) {
			const sourceLayout = layouts.value[index]
			const baseLeft = sourceLayout.left - currentContainerLayout.left
			const baseTop = sourceLayout.pageTop - currentContainerLayout.pageTop
			widthStyle = ''
			if (activeIndex.value == index) {
				// #ifdef APP-ANDROID
				positionStyle = `position: absolute; left: ${baseLeft}px; top: ${baseTop}px; width: ${sourceLayout.width}px; height: ${sourceLayout.height}px;`
				if (showClose.value == true) {
					zIndexStyle = 'z-index: 0;'
					transitionStyle = 'transition-duration: 0ms;'
					transformStyle = 'translateX(0px) translateY(0px)'
					return `${widthStyle}${positionStyle}${zIndexStyle}${transitionStyle}opacity: 0; transform: ${transformStyle};`
				}
				// #endif
				// #ifndef APP-ANDROID
				if (showClose.value == true) {
					positionStyle = `position: fixed; left: ${activeViewLeft.value}px; top: ${activeViewTop.value}px; width: ${sourceLayout.width}px; height: ${sourceLayout.height}px;`
				} else {
					positionStyle = `position: absolute; left: ${baseLeft}px; top: ${baseTop}px; width: ${sourceLayout.width}px; height: ${sourceLayout.height}px;`
				}
				// #endif
				zIndexStyle = 'z-index: 30;'
				transitionStyle = 'transition-duration: 0ms;'
				transformStyle = `translateX(${dragOffsetX.value}px) translateY(${dragOffsetY.value}px) scale(${activeDragScale.value})`
			} else {
				positionStyle = `position: absolute; left: ${baseLeft}px; top: ${baseTop}px; width: ${sourceLayout.width}px; height: ${sourceLayout.height}px;`
				if (index < itemIds.value.length) {
					const currentItemId = itemIds.value[index]
					const targetPosition = findPreviewPosition(currentItemId)
					if (targetPosition >= 0 && targetPosition < layouts.value.length) {
						const targetLayout = layouts.value[targetPosition]
						const deltaX = targetLayout.left - sourceLayout.left
						const deltaY = targetLayout.pageTop - sourceLayout.pageTop
						transformStyle = `translateX(${deltaX}px) translateY(${deltaY}px)`
					}
				}
			}
		}

		return `${widthStyle}${positionStyle}${zIndexStyle}${transitionStyle}transform: ${transformStyle};`
	}
	const getAppendStyle = () : string => {
		if (columnCount.value > 0) {
			return `width: ${100 / columnCount.value}%;`
		}
		return 'width: auto;'
	}


	onMounted(() => {
		itemIds.value = buildIdList(innerList.value.length)
		applyPreviewOrder(createIdentityOrder(innerList.value.length))
		nextTick(() => {
			measureLayouts()
		})
	})
</script>

<style>
	.drag-cell-host {
		position: relative;
		width: 100%;
		overflow: visible;
	}

	.drag-cell {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: flex-start;
		width: 100%;
		position: relative;
		overflow: visible;
	}

	.drag-cell-row {
		justify-content: flex-start;
	}

	.drag-cell-grid {
		justify-content: flex-start;
	}

	.drag-cell-item {
		position: relative;
		display: flex;
		flex-direction: column;
		transition-property: transform;
		transition-duration: 200ms;
		transition-timing-function: ease;
		transform-origin: center center;
		overflow: visible;
		/* #ifdef WEB */
		cursor: grab;
		/* #endif */
	}

	.drag-cell-append {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: visible;
	}

	.drag-cell-item-active {
		transition-duration: 0ms;
	}

	.drag-cell-item-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		transition-property: transform;
		transition-duration: 200ms;
		transition-timing-function: ease;
		transform-origin: center center;
	}

	.drag-cell-slot-content {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
	}

	.drag-cell-handle {
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: flex-start;
		opacity: 0.82;
		transition-property: transform, opacity;
		transition-duration: 160ms;
		/* #ifdef WEB */
		cursor: grab;
		/* #endif */
	}

	.drag-cell-handle-active {
		opacity: 1;
		transform: scale(1.08);
	}


	.drag-cell-delete-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 56px;
		border-radius: 0px;
		background-color: rgba(255, 59, 48, 0.92);
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		transform: translateY(0px);
		z-index: 20;
	}

	.drag-cell-delete-bar-active {
		background-color: rgba(209, 33, 23, 0.96);
		transform: scale(1.02);
	}

	.drag-cell-delete-text {
		font-size: 16px;
		font-weight: bold;
		color: #ffffff;
		text-align: center;
	}

	.drag-cell-delete-proxy {
		position: fixed;
		z-index: 30;
		overflow: visible;
	}

	.drag-cell-delete-proxy-inner {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
	}

	.drag-cell-drag-layer {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0);
		z-index: 25;
	}
</style>














