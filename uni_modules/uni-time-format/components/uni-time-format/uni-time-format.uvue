<template>
  <text class="time-text">{{ formattedTime }}</text>
</template>

<script setup lang="uts">
  const props = defineProps({
    /**
     * @description 时间戳（毫秒）
     */
    timestamp: {
      type: Number,
      required: true
    },
    /**
     * @description 格式化模式: 'date' | 'time' | 'datetime' | 'relative'
     */
    format: {
      type: String,
      default: 'datetime'
    }
  })

  function padZero(num : number) : string {
    return num < 10 ? '0' + num.toString() : num.toString()
  }

  // 时间差分解函数
  function decomposeDiff(absDiff : number) : { days : number; hours : number; minutes : number } {
    const seconds = Math.floor(absDiff / 1000)
    const minutes = Math.floor(seconds / 60)
    const hours = Math.floor(minutes / 60)
    const days = Math.floor(hours / 24)
    return { days, hours, minutes }
  }

  function getRelativeTime(timestamp : number) : string {
    const now = Date.now()
    const diff = now - timestamp

    if (diff < 0) {
      const { days, hours, minutes } = decomposeDiff(-diff)
      if (days > 0) return `${days}天后`
      if (hours > 0) return `${hours}小时后`
      if (minutes > 0) return `${minutes}分钟后`
      return '即将'
    }

    const { days, hours, minutes } = decomposeDiff(diff)
    if (days > 0) return `${days}天前`
    if (hours > 0) return `${hours}小时前`
    if (minutes > 0) return `${minutes}分钟前`
    return '刚刚'
  }

  // 格式化时间
  const formattedTime = computed(() : string => {
    const date = new Date(props.timestamp)
    const formatType = props.format ?? 'datetime'

    const year = date.getFullYear()
    const month = padZero(date.getMonth() + 1)
    const day = padZero(date.getDate())
    const hours = padZero(date.getHours())
    const minutes = padZero(date.getMinutes())
    const seconds = padZero(date.getSeconds())

    if (formatType == 'date') {
      return `${year}-${month}-${day}`
    } else if (formatType == 'time') {
      return `${hours}:${minutes}:${seconds}`
    } else if (formatType == 'relative') {
      return getRelativeTime(props.timestamp)
    } else {
      return `${year}-${month}-${day} ${hours}:${minutes}`
    }
  })
</script>

<style>
  .time-text {
    font-size: 12px;
    color: #999999;
  }
</style>
