<template>
	<!-- 蒙层 -->
	<view v-if="!nonMask" :class="['mask', props.maskClass]" :style="['position: fixed; top: 0; left: 0; right: 0; bottom: 0;', props.maskStyle]" @click="handleMaskClick" @touchstart="handleMaskTouchStart" @touchmove="handleMaskTouchMove" @touchend="handleMaskTouchEnd" @wheel.prevent.stop></view>

	<!-- 弹出层 -->
	<view :class="['pop', popPositionClass, props.popClass]" :style="[popComputedStyle, props.popStyle]"
	 <!-- #ifdef WEB -->
	 @touchstart="handlePopTouchStart" @touchmove="handlePopTouchMove" @wheel="handlePopWheel"
	 <!-- #endif -->
	 >
		<!-- 跟随箭头 -->
		<view v-if="showFollowArrow" :class="['follow-arrow', followArrowPositionClass, props.followArrowClass]" :style="[followArrowComputedStyle, props.followArrowStyle]"></view>

		<!-- 内容插槽 -->
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	import { ComponentPublicInstance } from 'vue'

	// 定义组件属性接口
	type Props = {
		/**
		 * @description 弹出位置
		 */
		pos? : "center" | "left" | "right" | "top" | "bottom" | "custom",
		/**
		 * @description 是否显示蒙层
		 */
		nonMask? : boolean,
		/**
		 * @description 点击蒙层是否关闭
		 */
		maskClickClose? : boolean,
		/**
		 * @description 自动隐藏时间(毫秒)，0表示不自动隐藏
		 */
		autoHideDuration? : number,
		/**
		 * @description 通过class自定义pop的样式
		 */
		popClass? : string.ClassString,
		/**
		 * @description 通过style自定义pop的样式
		 */
		popStyle? : string,
		/**
		 * @description 通过class自定义蒙层的样式
		 */
		maskClass? : string.ClassString,
		/**
		 * @description 通过style自定义蒙层的样式
		 */
		maskStyle? : string,
		/**
		 * @description 通过class自定义跟随箭头的样式
		 */
		followArrowClass? : string.ClassString,
		/**
		 * @description 通过style自定义跟随箭头的样式
		 */
		followArrowStyle? : string,
		/**
		 * @description 要跟随的元素id
		 */
		followId? : string,
		/**
		 * @description 出现在跟随的元素的那一边
		 */
		followSide? : "up" | "down" | "left" | "right",
		/**
		 * @description 出现在跟随元素的位置后再偏移多少的x坐标值
		 */
		followOffsetX? : number,
		/**
		 * @description 出现在跟随元素的位置后再偏移多少的y坐标值
		 */
		followOffsetY? : number,
		/**
		 * @description 是否关闭显示跟随箭头
		 */
		nonFollowArrow? : boolean,
		/**
		 * @description 跟随元素的对齐方式
		 */
		followAlign? : "left" | "right" | "top" | "bottom" | "center-horizontal" | "center-vertical"
	}

	// 使用 withDefaults 设置默认值
	const props = withDefaults(defineProps<Props>(), {
		pos: "center",
		nonMask: false,
		maskClickClose: false,
		autoHideDuration: 0,
		popClass: '',
		popStyle: '',
		maskClass: '',
		maskStyle: '',
		followArrowClass: '',
		followArrowStyle: '',
		followId: '',
		followSide: 'down',
		followOffsetX: 0,
		followOffsetY: 0,
		nonFollowArrow: false,
		followAlign: 'center-horizontal'
	})

	// 定义发射事件
	const emit = defineEmits<{
		(e: 'close'): void
	}>()

	// 定义跟随元素数据类型
	type FollowElementData = {
		element: UniElement | null,
		elementId: string,  // 元素 ID，用于小程序平台查询
		side: "up" | "down" | "left" | "right",
		offsetX: number,
		offsetY: number,
		align: "left" | "right" | "top" | "bottom" | "center-horizontal" | "center-vertical",
		// #ifdef WEB
		anchorName?: string  // CSS Anchor Positioning 的锚点名称
		// #endif
	}

	// 响应式状态
	const showFollowArrow = ref<boolean>(false)
	const followElementData = ref<FollowElementData | null>(null)
	const isClosing = ref<boolean>(false)

	// #ifdef APP
	// APP 平台：Follow 元素位置是否就绪（用于防止初始位置跳动）
	const followPositionReady = ref<boolean>(false)
	// #endif

	// #ifdef MP-WEIXIN
	// 微信小程序：缓存跟随元素的位置信息（因为查询是异步的）
	const followElementRect = ref<any>(null)
	// #endif

	// 更新跟随元素位置信息的辅助函数
	const updateFollowElementRect = () => {
		if (followElementData.value == null) {
			return
		}

		// #ifdef MP-WEIXIN
		// 微信小程序：使用 uni.createSelectorQuery 异步查询
		uni.createSelectorQuery().select('#' + followElementData.value.elementId).boundingClientRect((rect : any) => {
			if (rect != null) {
				followElementRect.value = rect
			}
		}).exec()
		// #endif

		// #ifndef MP-WEIXIN
		// Web 和 APP：不需要做任何事，popComputedStyle 会直接调用 getBoundingClientRect
		// #endif
	}
	// 动画状态：'hidden' - 隐藏状态, 'showing' - 显示动画, 'shown' - 显示完成, 'hiding' - 隐藏动画
	const animationState = ref<string>('hidden')
	// 是否启用 transition（用于 Web/小程序的三步时序控制）
	const transitionEnabled = ref<boolean>(false)

	let autoHideTimer : number = 0

	// 触摸开始位置
	let touchStartX : number = 0
	let touchStartY : number = 0
	// 是否发生了滑动
	let hasMoved : boolean = false

	// #ifdef WEB
	// 弹层内容触摸开始位置 Web有穿透问题，需要这么处理
	let popTouchStartY : number = 0
	// CSS Anchor Positioning API 支持检测（仅 Web 平台）
	let supportsAnchorPositioning : boolean = false
	// #endif

	// 位置跟踪相关变量（Web 和 APP 平台都需要）
	let positionTrackerActive : boolean = false
	// RAF 节流标记
	let rafId : number = 0
	// 强制更新计数器
	const forceUpdateCounter = ref<number>(0)
	// #ifdef APP
	// APP 平台：requestAnimationFrame ID
	let positionCheckRafId : number = 0
	// APP 平台：上次记录的位置
	let lastElementTop : number = 0
	let lastElementLeft : number = 0
	// #endif

	// #ifdef MP-WEIXIN
	// 微信小程序：setTimeout ID（用于位置跟踪）
	let positionCheckTimerId : number = 0
	// #endif

	// 计算弹出层位置class
	const popPositionClass = computed(() : string.ClassString => {
		let classes = ''
		if (followElementData.value != null) {
			classes = 'pop-follow'
		} else {
			classes = `pop-${props.pos}`
			// 只有在四边弹出时才添加动画状态的 class
			if (props.pos == 'top' || props.pos == 'bottom' || props.pos == 'left' || props.pos == 'right') {
				if (animationState.value == 'showing') {
					classes += ' animate-showing'
				} else if (animationState.value == 'shown') {
					classes += ' animate-shown'
				} else if (animationState.value == 'hiding') {
					classes += ' animate-hiding'
				} else if (animationState.value == 'hidden') {
					classes += ' animate-hidden'
				}
			}
		}
		return classes as string.ClassString
	})

	// 计算弹出层样式
	const popComputedStyle = computed(() : string => {
		let style = 'position: fixed;'

		// 响应强制更新计数器的变化（用于触发重新计算）
		// 这里只是读取值以建立响应式依赖，不使用该值
		if (forceUpdateCounter.value >= 0) {
			// 计数器变化会触发此 computed 重新计算
		}

		// #ifdef APP
		// APP 平台：如果是 Follow 模式但位置还未就绪，隐藏弹层避免跳动
		if (props.followId != '' && !followPositionReady.value) {
			style += 'opacity: 0; pointer-events: none;'
			return style
		}
		// #endif

		// 如果有跟随元素，计算位置
		if (followElementData.value != null && followElementData.value.element != null) {

			// #ifdef WEB
			// 如果支持 CSS Anchor Positioning，使用原生 CSS 锚点定位
			if (supportsAnchorPositioning && followElementData.value.anchorName != null) {
				const anchorName = followElementData.value.anchorName
				const side = followElementData.value.side
				const offsetX = followElementData.value.offsetX
				const offsetY = followElementData.value.offsetY
				const align = followElementData.value.align

				// 设置 position-anchor
				style += `position-anchor: ${anchorName};`

				// 根据不同方向设置锚点位置
				if (side == 'up') {
					style += `bottom: anchor(top);`
					if (offsetY != 0) {
						style += `margin-bottom: ${offsetY}px;`
					}
					if (align == 'left') {
						style += `left: anchor(left);`
						if (offsetX != 0) style += `margin-left: ${offsetX}px;`
					} else if (align == 'right') {
						style += `right: anchor(right);`
						if (offsetX != 0) style += `margin-right: ${offsetX}px;`
					} else {
						// center-horizontal
						style += `left: anchor(center);`
						style += `transform: translateX(-50%);`
						if (offsetX != 0) style += `margin-left: ${offsetX}px;`
					}
				} else if (side == 'down') {
					style += `top: anchor(bottom);`
					if (offsetY != 0) {
						style += `margin-top: ${offsetY}px;`
					}
					if (align == 'left') {
						style += `left: anchor(left);`
						if (offsetX != 0) style += `margin-left: ${offsetX}px;`
					} else if (align == 'right') {
						style += `right: anchor(right);`
						if (offsetX != 0) style += `margin-right: ${offsetX}px;`
					} else {
						// center-horizontal
						style += `left: anchor(center);`
						style += `transform: translateX(-50%);`
						if (offsetX != 0) style += `margin-left: ${offsetX}px;`
					}
				} else if (side == 'left') {
					style += `right: anchor(left);`
					if (offsetX != 0) {
						style += `margin-right: ${offsetX}px;`
					}
					if (align == 'top') {
						style += `top: anchor(top);`
						if (offsetY != 0) style += `margin-top: ${offsetY}px;`
					} else if (align == 'bottom') {
						style += `bottom: anchor(bottom);`
						if (offsetY != 0) style += `margin-bottom: ${offsetY}px;`
					} else {
						// center-vertical
						style += `top: anchor(center);`
						style += `transform: translateY(-50%);`
						if (offsetY != 0) style += `margin-top: ${offsetY}px;`
					}
				} else if (side == 'right') {
					style += `left: anchor(right);`
					if (offsetX != 0) {
						style += `margin-left: ${offsetX}px;`
					}
					if (align == 'top') {
						style += `top: anchor(top);`
						if (offsetY != 0) style += `margin-top: ${offsetY}px;`
					} else if (align == 'bottom') {
						style += `bottom: anchor(bottom);`
						if (offsetY != 0) style += `margin-bottom: ${offsetY}px;`
					} else {
						// center-vertical
						style += `top: anchor(center);`
						style += `transform: translateY(-50%);`
						if (offsetY != 0) style += `margin-top: ${offsetY}px;`
					}
				}

				return style
			}
			// #endif

			// 降级方案：使用 JavaScript 计算位置
			const windowInfo = uni.getWindowInfo()

			// #ifdef MP-WEIXIN
			// 微信小程序：使用缓存的位置信息
			const rect = followElementRect.value
			if (rect == null) {
				return style  // 位置信息未准备好，返回基本样式
			}
			// #endif

			// #ifndef MP-WEIXIN
			// Web 和 APP：直接调用 getBoundingClientRect
			const rect = followElementData.value.element!.getBoundingClientRect()
			// #endif

			const side = followElementData.value.side
			const offsetX = followElementData.value.offsetX
			const offsetY = followElementData.value.offsetY
			const align = followElementData.value.align

			if (side == 'up') {
				// 在元素上方
				style += `bottom: ${windowInfo.windowHeight + windowInfo.windowTop - rect.top + offsetY}px;`
				if (align == 'left') {
					style += `left: ${rect.left + offsetX}px;`
				} else if (align == 'right') {
					style += `right: ${windowInfo.windowWidth - rect.right + offsetX}px;`
				} else {
					// center-horizontal 或默认
					style += `left: ${rect.left + rect.width / 2 + offsetX}px; transform: translateX(-50%);`
				}
			} else if (side == 'down') {
				// 在元素下方
				style += `top: ${rect.bottom + offsetY}px;`
				if (align == 'left') {
					style += `left: ${rect.left + offsetX}px;`
				} else if (align == 'right') {
					style += `right: ${windowInfo.windowWidth - rect.right + offsetX}px;`
				} else {
					// center-horizontal 或默认
					style += `left: ${rect.left + rect.width / 2 + offsetX}px; transform: translateX(-50%);`
				}
			} else if (side == 'left') {
				// 在元素左侧
				style += `right: ${windowInfo.windowWidth - rect.left + offsetX}px;`
				if (align == 'top') {
					style += `top: ${rect.top + offsetY}px;`
				} else if (align == 'bottom') {
					style += `bottom: ${windowInfo.windowHeight + windowInfo.windowTop - rect.bottom + offsetY}px;`
				} else {
					// center-vertical 或默认
					style += `top: ${rect.top + rect.height / 2 + offsetY}px; transform: translateY(-50%);`
				}
			} else if (side == 'right') {
				// 在元素右侧
				style += `left: ${rect.right + offsetX}px;`
				if (align == 'top') {
					style += `top: ${rect.top + offsetY}px;`
				} else if (align == 'bottom') {
					style += `bottom: ${windowInfo.windowHeight + windowInfo.windowTop - rect.bottom + offsetY}px;`
				} else {
					// center-vertical 或默认
					style += `top: ${rect.top + rect.height / 2 + offsetY}px; transform: translateY(-50%);`
				}
			}
		}

		// 非跟随元素的四边弹出：根据动画状态设置 transform 和 transition
		// Web/小程序：inline style 包含 transition（完整控制）
		// APP：inline style 只包含 transform，transition 由 CSS class 提供
		if (followElementData.value == null) {
			const pos = props.pos
			const state = animationState.value
			const hasTransition = transitionEnabled.value

			// #ifndef APP
			// Web 和 微信小程序：inline style 完整控制（包括 transition）
			if (pos == 'top') {
				if (state == 'showing' || state == 'hidden') {
					if (hasTransition) {
						style += 'transform: translateX(-50%) translateY(-100%); transition: transform 300ms ease-out;'
					} else {
						style += 'transform: translateX(-50%) translateY(-100%); transition: none;'
					}
				} else if (state == 'shown') {
					style += 'transform: translateX(-50%) translateY(0); transition: transform 300ms ease-out;'
				} else if (state == 'hiding') {
					style += 'transform: translateX(-50%) translateY(-100%); transition: transform 300ms ease-in;'
				}
			} else if (pos == 'bottom') {
				if (state == 'showing' || state == 'hidden') {
					if (hasTransition) {
						style += 'transform: translateX(-50%) translateY(100%); transition: transform 300ms ease-out;'
					} else {
						style += 'transform: translateX(-50%) translateY(100%); transition: none;'
					}
				} else if (state == 'shown') {
					style += 'transform: translateX(-50%) translateY(0); transition: transform 300ms ease-out;'
				} else if (state == 'hiding') {
					style += 'transform: translateX(-50%) translateY(100%); transition: transform 300ms ease-in;'
				}
			} else if (pos == 'left') {
				if (state == 'showing' || state == 'hidden') {
					if (hasTransition) {
						style += 'transform: translateY(-50%) translateX(-100%); transition: transform 300ms ease-out;'
					} else {
						style += 'transform: translateY(-50%) translateX(-100%); transition: none;'
					}
				} else if (state == 'shown') {
					style += 'transform: translateY(-50%) translateX(0); transition: transform 300ms ease-out;'
				} else if (state == 'hiding') {
					style += 'transform: translateY(-50%) translateX(-100%); transition: transform 300ms ease-in;'
				}
			} else if (pos == 'right') {
				if (state == 'showing' || state == 'hidden') {
					if (hasTransition) {
						style += 'transform: translateY(-50%) translateX(100%); transition: transform 300ms ease-out;'
					} else {
						style += 'transform: translateY(-50%) translateX(100%); transition: none;'
					}
				} else if (state == 'shown') {
					style += 'transform: translateY(-50%) translateX(0); transition: transform 300ms ease-out;'
				} else if (state == 'hiding') {
					style += 'transform: translateY(-50%) translateX(100%); transition: transform 300ms ease-in;'
				}
			}
			// #endif

			// #ifdef APP
			// APP 平台：inline style 只包含 transform（不含 transition，由 CSS class 提供）
			if (pos == 'top') {
				if (state == 'showing' || state == 'hidden') {
					style += 'transform: translateX(-50%) translateY(-100%);'
				} else if (state == 'shown') {
					style += 'transform: translateX(-50%) translateY(0);'
				} else if (state == 'hiding') {
					style += 'transform: translateX(-50%) translateY(-100%);'
				}
			} else if (pos == 'bottom') {
				if (state == 'showing' || state == 'hidden') {
					style += 'transform: translateX(-50%) translateY(100%);'
				} else if (state == 'shown') {
					style += 'transform: translateX(-50%) translateY(0);'
				} else if (state == 'hiding') {
					style += 'transform: translateX(-50%) translateY(100%);'
				}
			} else if (pos == 'left') {
				if (state == 'showing' || state == 'hidden') {
					style += 'transform: translateY(-50%) translateX(-100%);'
				} else if (state == 'shown') {
					style += 'transform: translateY(-50%) translateX(0);'
				} else if (state == 'hiding') {
					style += 'transform: translateY(-50%) translateX(-100%);'
				}
			} else if (pos == 'right') {
				if (state == 'showing' || state == 'hidden') {
					style += 'transform: translateY(-50%) translateX(100%);'
				} else if (state == 'shown') {
					style += 'transform: translateY(-50%) translateX(0);'
				} else if (state == 'hiding') {
					style += 'transform: translateY(-50%) translateX(100%);'
				}
			}
			// #endif
		}

		return style
	})

	// 计算箭头位置class
	const followArrowPositionClass = computed(() : string.ClassString => {
		if (followElementData.value != null) {
			return `arrow-${followElementData.value.side}` as string.ClassString
		}
		return ''
	})

	// 计算箭头样式
	const followArrowComputedStyle = computed(() : string => {
		if (followElementData.value == null || followElementData.value.element == null) {
			return ''
		}

		// #ifdef APP
		// APP 平台：如果位置还未就绪，返回空样式
		if (!followPositionReady.value) {
			return ''
		}
		// #endif

		const windowInfo = uni.getWindowInfo()

		// #ifdef MP-WEIXIN
		// 微信小程序：使用缓存的位置信息
		const rect = followElementRect.value
		if (rect == null) {
			return ''  // 位置信息未准备好，返回空样式
		}
		// #endif

		// #ifndef MP-WEIXIN
		// Web 和 APP：直接调用 getBoundingClientRect
		const rect = followElementData.value.element!.getBoundingClientRect()
		// #endif

		const side = followElementData.value.side
		const align = followElementData.value.align
		let style = ''

		// 计算箭头位置,使其指向触发元素的中心
		if (side == 'up' || side == 'down') {
			// 上下方向,箭头需要左右移动对准触发元素中心
			if (align == 'left') {
				// 弹层左对齐,箭头位置 = 触发元素中心 - 弹层左边缘
				const arrowLeft = rect.width / 2
				style += `left: ${arrowLeft}px; transform: translateX(0);`
			} else if (align == 'right') {
				// 弹层右对齐,箭头位置 = 触发元素中心
				const arrowRight = rect.width / 2
				style += `right: ${arrowRight}px; transform: translateX(0);`
			} else {
				// 居中对齐,箭头在中间
				style += `left: 50%; transform: translateX(-50%);`
			}
		} else if (side == 'left' || side == 'right') {
			// 左右方向,箭头需要上下移动对准触发元素中心
			if (align == 'top') {
				// 弹层顶部对齐,箭头位置 = 触发元素中心 - 弹层顶边缘
				const arrowTop = rect.height / 2
				style += `top: ${arrowTop}px; transform: translateY(0);`
			} else if (align == 'bottom') {
				// 弹层底部对齐,箭头位置 = 触发元素中心
				const arrowBottom = rect.height / 2
				style += `bottom: ${arrowBottom}px; transform: translateY(0);`
			} else {
				// 居中对齐,箭头在中间
				style += `top: 50%; transform: translateY(-50%);`
			}
		}

		return style
	})

	// 清除自动隐藏定时器
	const clearAutoHideTimer = () => {
		if (autoHideTimer != 0) {
			clearTimeout(autoHideTimer)
			autoHideTimer = 0
		}
	}

	// 关闭弹层
	const close = () => {
		isClosing.value = true
		clearAutoHideTimer()

		// #ifdef APP
		// APP 平台：重置位置就绪标志，下次打开时重新延迟
		followPositionReady.value = false
		// #endif

		// 只有在从四边弹出时才需要动画
		const needAnimation = followElementData.value == null && (props.pos == 'top' || props.pos == 'bottom' || props.pos == 'left' || props.pos == 'right')

		if (needAnimation) {
			// 触发隐藏动画
			animationState.value = 'hiding'
			// 等待动画完成后再触发close事件
			setTimeout(() => {
				animationState.value = 'hidden'
				emit('close')
				isClosing.value = false
			}, 300)
		} else {
			// 不需要动画，直接关闭
			emit('close')
			isClosing.value = false
		}
	}

	// 设置自动隐藏
	const startAutoHide = () => {
		clearAutoHideTimer()
		if (props.autoHideDuration > 0) {
			autoHideTimer = setTimeout(() => {
				close()
			}, props.autoHideDuration)
		}
	}

	// 处理蒙层点击
	const handleMaskClick = () => {
		if (props.maskClickClose) {
			close()
		}
	}

	// 处理蒙层触摸开始
	const handleMaskTouchStart = (e : TouchEvent) => {
		// #ifdef WEB
		// Web 平台：阻止默认行为以防止滚动穿透
		e.preventDefault()
		// #endif

		// 所有平台：阻止事件冒泡
		e.stopPropagation()

		if (e.touches.length > 0) {
			touchStartX = e.touches[0].clientX
			touchStartY = e.touches[0].clientY
			hasMoved = false
		}
	}

	// 处理蒙层触摸移动
	const handleMaskTouchMove = (e : TouchEvent) => {
		// #ifdef WEB
		// Web 平台：阻止默认行为以防止滚动穿透
		e.preventDefault()
		// #endif

		// 所有平台：阻止事件冒泡
		e.stopPropagation()

		if (e.touches.length > 0) {
			const moveX = Math.abs(e.touches[0].clientX - touchStartX)
			const moveY = Math.abs(e.touches[0].clientY - touchStartY)

			// 如果移动距离超过5px，认为发生了滑动
			if (moveX > 5 || moveY > 5) {
				hasMoved = true
			}
		}
	}

	// 处理蒙层触摸结束
	const handleMaskTouchEnd = (e : TouchEvent) => {
		// #ifdef WEB
		// Web 平台：阻止默认行为以防止滚动穿透
		e.preventDefault()
		// #endif

		// 所有平台：阻止事件冒泡
		e.stopPropagation()

		// 如果设置了maskClickClose，无论是点击还是滑动都关闭弹层
		if (props.maskClickClose) {
			close()
		}

		// 重置状态
		hasMoved = false
		touchStartX = 0
		touchStartY = 0
	}

	// 更新跟随元素位置（APP 平台和不支持 CSS Anchor Positioning 的浏览器使用）
	const updateFollowElementPosition = () => {
		// #ifdef WEB
		// Web 平台：只有在不支持 CSS Anchor Positioning 时才需要手动更新
		const needUpdate = followElementData.value != null && !supportsAnchorPositioning
		// #endif

		// #ifndef WEB
		// APP 平台：始终需要手动更新
		const needUpdate = followElementData.value != null
		// #endif

		if (needUpdate) {
			// #ifdef MP-WEIXIN
			// 微信小程序：更新跟随元素位置缓存
			updateFollowElementRect()
			// #endif

			// 取消之前的 RAF
			if (rafId != 0) {
				cancelAnimationFrame(rafId)
			}

			// 使用 RAF 节流，避免频繁更新
			rafId = requestAnimationFrame(() => {
				// 通过修改计数器触发 computed 重新计算
				forceUpdateCounter.value++
				rafId = 0
			})
		}
	}

	// 页面滚动处理函数
	const handlePageScroll = () => {
		updateFollowElementPosition()
	}

	// #ifdef APP
	// APP平台：位置检查实现函数
	const doPositionCheck = () : void => {
		if (followElementData.value != null && followElementData.value.element != null) {
			const rect = followElementData.value.element.getBoundingClientRect()
			// 检测位置是否变化（超过 1px）
			if (Math.abs(rect.top - lastElementTop) > 1 || Math.abs(rect.left - lastElementLeft) > 1) {
				lastElementTop = rect.top
				lastElementLeft = rect.left
				updateFollowElementPosition()
			}
		}
	}
	// #endif

	// 位置检查循环函数（先声明变量，再赋值，支持递归调用）
	let checkPosition : (() => void) | null = null
	checkPosition = () : void => {
		if (!positionTrackerActive) {
			// 如果跟踪已停止，不再继续循环
			return
		}

		// #ifndef WEB
		doPositionCheck()

		// 继续下一帧检查（使用非空断言调用自身）
		positionCheckRafId = requestAnimationFrame(() : void => {
			checkPosition!()
		})
		// #endif
	}

	// 启动位置跟踪（用于跟随元素模式）
	const startPositionTracker = () => {
		// #ifdef WEB
		// Web和小程序 平台：只有在不支持 CSS Anchor Positioning 时才启动监听
		const needTracker = !positionTrackerActive && followElementData.value != null && !supportsAnchorPositioning
		// #endif

		// #ifndef WEB
		// APP 平台：始终需要跟踪
		const needTracker = !positionTrackerActive && followElementData.value != null
		// #endif

		if (needTracker) {
			positionTrackerActive = true

			// #ifdef WEB
			// Web 平台：使用滚动事件监听
			window.addEventListener('scroll', handlePageScroll, { passive: true, capture: true })
			window.addEventListener('resize', handlePageScroll, { passive: true })
			// console.log('Web: Scroll listener started for follow element')
			// #endif

			// #ifdef APP
			// APP平台：使用 requestAnimationFrame 轮询检测位置变化
			// TODO 小程序平台没处理，小程序没有 requestAnimationFrame，用 setTimeout 模拟性能过低。未来可以研究css锚点定位，目前暂不支持了
			if (followElementData.value != null && followElementData.value.element != null) {
				const rect = followElementData.value.element.getBoundingClientRect()
				lastElementTop = rect.top
				lastElementLeft = rect.left
			}

			// 启动循环
			checkPosition!()

			// console.log('APP: Position tracker started for follow element with requestAnimationFrame')
			// #endif

			// #ifdef MP-WEIXIN
			// 微信小程序：使用 setTimeout 定期更新位置
			// 由于微信小程序没有 requestAnimationFrame，使用定时器轮询
			const checkPositionMP = () => {
				if (!positionTrackerActive) {
					return
				}

				// 更新位置缓存
				updateFollowElementRect()

				// 继续下一次检查（每 100ms 检查一次）
				positionCheckTimerId = setTimeout(checkPositionMP, 100)
			}

			// 启动定时器
			checkPositionMP()
			// console.log('MP-WEIXIN: Position tracker started with setTimeout')
			// #endif
		}
	}

	// 停止位置跟踪
	const stopPositionTracker = () => {
		if (positionTrackerActive) {
			positionTrackerActive = false

			// #ifdef WEB
			// Web 平台：移除事件监听器
			window.removeEventListener('scroll', handlePageScroll, true)
			window.removeEventListener('resize', handlePageScroll)
			// #endif

			// #ifdef APP
			// APP 平台：取消 requestAnimationFrame
			if (positionCheckRafId != 0) {
				cancelAnimationFrame(positionCheckRafId)
				positionCheckRafId = 0
			}
			// #endif

			// #ifdef MP-WEIXIN
			// 微信小程序：清除定时器
			if (positionCheckTimerId != 0) {
				clearTimeout(positionCheckTimerId)
				positionCheckTimerId = 0
			}
			// #endif

			// 取消待处理的 RAF
			if (rafId != 0) {
				cancelAnimationFrame(rafId)
				rafId = 0
			}
		}
	}

	// #ifdef WEB
	// Web 专用函数：处理滚动穿透

	// 检测浏览器是否支持 CSS Anchor Positioning API
	const checkAnchorPositioningSupport = () : boolean => {
		try {
			// 检测 CSS.supports API 是否可用
			if (typeof CSS !== 'undefined' && typeof CSS.supports === 'function') {
				return CSS.supports('anchor-name', '--test')
			}
		} catch (e) {
			// console.log('CSS Anchor Positioning check failed:', e)
		}
		return false
	}

	// 处理弹层内容触摸开始
	const handlePopTouchStart = (e : TouchEvent) => {
		if (e.touches.length > 0) {
			popTouchStartY = e.touches[0].clientY
		}
	}

	// 处理弹层内鼠标滚轮事件 - 智能处理滚动穿透
	const handlePopWheel = (e : WheelEvent) => {
		// 获取滚动目标元素
		const target = e.target as UniElement

		// 检查是否是可滚动元素或其子元素
		let element : UniElement | null = target
		let isScrollable = false

		// 向上遍历 DOM 树,查找可滚动容器
		while (element != null) {
			const tagName = element.tagName.toLowerCase()

			// 检查是否是可滚动组件
			if (tagName == 'scroll-view' || tagName == 'list-view' || tagName == 'swiper' || tagName == 'moveable-view' || tagName == 'waterflow' ) {
				isScrollable = true

				// 获取滚动信息
				const scrollTop = element.scrollTop
				const scrollHeight = element.scrollHeight
				const rect = element.getBoundingClientRect()
				const clientHeight = rect.height

				// 判断滚动方向
				const deltaY = e.deltaY
				const isAtBottom = scrollTop + clientHeight >= scrollHeight - 1
				const isAtTop = scrollTop <= 1

				// 如果向下滚动且已到底部，或向上滚动且已到顶部，阻止穿透
				if ((deltaY > 0 && isAtBottom) || (deltaY < 0 && isAtTop)) {
					e.preventDefault()
					e.stopPropagation()
				}

				break
			}

			element = element.parentElement
		}

		// 如果不是可滚动元素内部,阻止滚动穿透
		if (!isScrollable) {
			e.preventDefault()
			e.stopPropagation()
		}
	}

	// 处理弹层内容触摸移动 - 防止滚动穿透
	const handlePopTouchMove = (e : TouchEvent) => {
		// 获取触摸目标元素
		const target = e.target as UniElement

		// 检查是否是可滚动元素或其子元素
		let element : UniElement | null = target
		let isScrollable = false

		// 向上遍历 DOM 树,查找可滚动容器
		while (element != null) {
			const tagName = element.tagName.toLowerCase()

			// 检查是否是 scroll-view 或其他可滚动组件
			// TODO 如果未来扩展内置滚动容器，得增加这个名单。如果有三方插件作者做了原生滚动组件，这种机制无法处理
			if (tagName == 'scroll-view' || tagName == 'list-view' || tagName == 'swiper' || tagName == 'moveable-view' || tagName == 'waterflow' ) {
				isScrollable = true

				// 获取滚动容器的滚动信息
				const scrollTop = element.scrollTop
				const scrollHeight = element.scrollHeight
				const rect = element.getBoundingClientRect()
				const clientHeight = rect.height

				// 计算触摸移动方向
				if (e.touches.length > 0) {
					const currentY = e.touches[0].clientY
					const deltaY = currentY - popTouchStartY

					// 向上滑动(deltaY < 0)且已滚动到底部,或向下滑动(deltaY > 0)且已滚动到顶部
					const isAtBottom = scrollTop + clientHeight >= scrollHeight - 1
					const isAtTop = scrollTop <= 1

					if ((deltaY < 0 && isAtBottom) || (deltaY > 0 && isAtTop)) {
						// 到达边界,阻止滚动穿透
						e.preventDefault()
						e.stopPropagation()
					}

					popTouchStartY = currentY
				}

				break
			}

			element = element.parentElement
		}

		// 如果不是可滚动元素内部,阻止滚动穿透
		if (!isScrollable) {
			e.preventDefault()
			e.stopPropagation()
		}
	}
	// #endif

	// 暴露方法给外部调用
	defineExpose({
		close
	})

	// 组件挂载时
	onMounted(() => {
		// #ifdef WEB
		// Web 平台：检测 CSS Anchor Positioning 支持
		supportsAnchorPositioning = checkAnchorPositioningSupport()
		// console.log('Web platform - Component mounted, CSS Anchor Positioning support:', supportsAnchorPositioning)
		// #endif

		// #ifndef WEB
		// APP 平台：输出日志
		// console.log('APP platform - Component mounted, using scroll listener for follow element')
		// #endif

		// 如果设置了 followId，自动跟随元素
		if (props.followId != '') {
			// 延迟执行，确保目标元素已经渲染
			nextTick(() => {
				const targetElement = uni.getElementById(props.followId)
				if (targetElement != null) {
					// 设置跟随元素数据
					// #ifdef WEB
					let anchorName : string | null = null

					// 如果支持 CSS Anchor Positioning，为目标元素添加 anchor-name
					if (supportsAnchorPositioning) {
						try {
							anchorName = '--uni-pop-anchor-' + Date.now()
							targetElement.style.setProperty('anchor-name', anchorName)
							// console.log('CSS Anchor Positioning enabled with anchor name:', anchorName)
						} catch (e) {
							console.log('Failed to set anchor-name:', e)
							anchorName = null
						}
					} else {
						// 不支持则启动滚动监听
						// console.log('CSS Anchor Positioning not supported, using scroll listener fallback')
					}

					followElementData.value = {
						element: targetElement,
						elementId: props.followId,
						side: props.followSide,
						offsetX: props.followOffsetX,
						offsetY: props.followOffsetY,
						align: props.followAlign,
						anchorName: anchorName
					} as FollowElementData

					// Web 平台：如果不支持 CSS Anchor Positioning，启动位置跟踪
					if (!supportsAnchorPositioning) {
						startPositionTracker()
					}
					// #endif

					// #ifndef WEB
					// APP 平台始终使用 JavaScript 计算位置
					// 但这里会导致小程序也走了手动计算位置，性能会很差
					followElementData.value = {
						element: targetElement,
						elementId: props.followId,
						side: props.followSide,
						offsetX: props.followOffsetX,
						offsetY: props.followOffsetY,
						align: props.followAlign
					} as FollowElementData
					// console.log('APP platform: using scroll listener for follow element')

					// #ifdef APP
					// APP 平台：延迟一下确保位置计算准确，避免初始跳动
					setTimeout(() => {
						followPositionReady.value = true
					}, 50)
					// #endif

					// #ifdef MP-WEIXIN
					// 微信小程序：初始化查询跟随元素位置
					updateFollowElementRect()
					// #endif

					// APP 平台：始终启动位置跟踪
					startPositionTracker()
					// #endif

					showFollowArrow.value = !props.nonFollowArrow
				} else {
					console.warn(`followId "${props.followId}" not found`)
				}
			})
		} else {
			// 只有在从四边弹出时才需要动画
			const needAnimation = followElementData.value == null && (props.pos == 'top' || props.pos == 'bottom' || props.pos == 'left' || props.pos == 'right')

			if (needAnimation) {
				// 启动显示动画 - 使用三步时序控制
				// 步骤1：设置为 showing 状态（初始隐藏位置，无 transition）
				animationState.value = 'showing'
				transitionEnabled.value = false

				// 步骤2：延迟 50ms 后，启用 transition（但 transform 值不变）
				setTimeout(() => {
					// Web/小程序：启用 transition，popComputedStyle 会添加 transition 到 inline style
					// APP：transitionEnabled 不影响，transition 由 CSS class 提供
					transitionEnabled.value = true

					// 步骤3：再延迟 50ms，切换到 shown 状态（改变 transform，触发动画）
					setTimeout(() => {
						animationState.value = 'shown'
					}, 50)
				}, 50)
			}
		}

		startAutoHide()
	})

	// 组件卸载时清理
	onUnmounted(() => {
		// Web 和 APP 平台都需要清理位置跟踪器
		stopPositionTracker()
	})

	// 监听自动隐藏时间变化
	watch(() : number => {
		return props.autoHideDuration
	}, () => {
		startAutoHide()
	})
</script>

<style>
	.mask {
		z-index: 999; /* Web平台导航栏和tabbar的z-index都是998。弹层mask设999将覆盖到导航栏和tabbar上*/
		background-color: rgba(0, 0, 0, 0.5);
	}

	.pop {
		z-index: 1000; /* 比mask的z-index高1*/
		background-color: white;
		border-radius: 8px;
		padding: 16px;
		overflow: visible;
	}

	/* transition 只在动画状态类中添加，不在基础类中 */
	/* 这样可以避免首次渲染时的意外动画 */

	.pop-center {
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	/* top 位置的动画 */
	.pop-top {
		top: 0;
		left: 50%;
	}

	.pop-top.animate-hidden {
		transform: translateX(-50%) translateY(-100%);
	}

	.pop-top.animate-showing {
		transform: translateX(-50%) translateY(-100%);
		transition: transform 300ms ease-out;
	}

	.pop-top.animate-shown {
		transform: translateX(-50%) translateY(0);
		transition: transform 300ms ease-out;
	}

	.pop-top.animate-hiding {
		transform: translateX(-50%) translateY(-100%);
		transition: transform 300ms ease-in;
	}

	/* bottom 位置的动画 */
	.pop-bottom {
		bottom: 0;
		left: 50%;
	}

	.pop-bottom.animate-hidden {
		transform: translateX(-50%) translateY(100%);
	}

	.pop-bottom.animate-showing {
		transform: translateX(-50%) translateY(100%);
		transition: transform 300ms ease-out;
	}

	.pop-bottom.animate-shown {
		transform: translateX(-50%) translateY(0);
		transition: transform 300ms ease-out;
	}

	.pop-bottom.animate-hiding {
		transform: translateX(-50%) translateY(100%);
		transition: transform 300ms ease-in;
	}

	/* left 位置的动画 */
	.pop-left {
		top: 50%;
		left: 0;
	}

	.pop-left.animate-hidden {
		transform: translateY(-50%) translateX(-100%);
	}

	.pop-left.animate-showing {
		transform: translateY(-50%) translateX(-100%);
		transition: transform 300ms ease-out;
	}

	.pop-left.animate-shown {
		transform: translateY(-50%) translateX(0);
		transition: transform 300ms ease-out;
	}

	.pop-left.animate-hiding {
		transform: translateY(-50%) translateX(-100%);
		transition: transform 300ms ease-in;
	}

	/* right 位置的动画 */
	.pop-right {
		top: 50%;
		right: 0;
	}

	.pop-right.animate-hidden {
		transform: translateY(-50%) translateX(100%);
	}

	.pop-right.animate-showing {
		transform: translateY(-50%) translateX(100%);
		transition: transform 300ms ease-out;
	}

	.pop-right.animate-shown {
		transform: translateY(-50%) translateX(0);
		transition: transform 300ms ease-out;
	}

	.pop-right.animate-hiding {
		transform: translateY(-50%) translateX(100%);
		transition: transform 300ms ease-in;
	}

	.pop-custom {
		/* 自定义位置由外部样式控制 */
	}

	.pop-follow {
		/* 跟随元素位置由计算样式控制 */
	}

	.follow-arrow {
		position: absolute;
		width: 0;
		height: 0;
		border-width: 8px;
		border-style: solid;
		border-color: transparent;
		z-index: 1;
	}

	.arrow-up {
		bottom: -16px;
		border-top-color: #ccc;
	}

	.arrow-down {
		top: -16px;
		border-bottom-color: #ccc;
	}

	.arrow-left {
		right: -16px;
		border-left-color: #ccc;
	}

	.arrow-right {
		left: -16px;
		border-right-color: #ccc;
	}
</style>
