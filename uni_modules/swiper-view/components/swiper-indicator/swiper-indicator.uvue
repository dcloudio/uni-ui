<template>
	<view
		class="uni-swiper-indicator"
		:class="
			vertical
				? 'uni-swiper-indicator_vertical'
				: 'uni-swiper-indicator_horizontal'
		">
		<slot></slot>

		<!-- 默认圆点指示器 -->
		<template v-if="!hasSlotContent">
			<view
				v-for="i in total"
				:key="i"
				class="uni-swiper-indicator-item"
				:class="[props.itemClass, { 'active' : current == i - 1 }, { [props.itemActiveClass] : current == i - 1 }]"
				:style="mergeStyle(current == i - 1)"
				@click="handleClick(i - 1)">
			</view>
		</template>
	</view>
</template>

<script setup lang="uts">
import { computed, inject, ref, Ref, useSlots } from 'vue'
import { UniSwiperIndicatorProps } from './types.uts'

const props = withDefaults(defineProps<UniSwiperIndicatorProps>(), {
	itemClass: '',
	itemStyle: '',
	itemActiveClass: '',
	itemActiveStyle: ''
})

const slots = useSlots()
const hasSlotContent = computed(() : boolean => {
	return slots['default'] != null
})

// 从父组件注入（inject的是ref对象）
const vertical = inject<boolean>('swiper-vertical', false)
const current = inject<Ref<number>>('swiper-current', ref(0))
const total = inject<Ref<number>>('swiper-total', ref(0))
const onChange = inject<(index : number) => void>('swiper-change', (index : number) => { })

// 合并item样式
const mergeStyle = (isActive : boolean) : string => {
	let style = props.itemStyle
	if (isActive && props.itemActiveStyle.length > 0) {
		style = style.length > 0 ? style + '; ' + props.itemActiveStyle : props.itemActiveStyle
	}
	return style
}

const handleClick = (index : number) => {
	onChange(index)
}
</script>

<style>
.uni-swiper-indicator {
	position: absolute;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10;
	pointer-events: auto;
}

.uni-swiper-indicator.uni-swiper-indicator_horizontal {
	bottom: 0px;
	left: 0px;
	right: 0px;
	height: 40px;
	flex-direction: row;
}

.uni-swiper-indicator.uni-swiper-indicator_vertical {
	top: 0px;
	bottom: 0px;
	right: 0px;
	width: 40px;
	flex-direction: column;
}

.uni-swiper-indicator .uni-swiper-indicator-item {
	width: 8px;
	height: 8px;
	border-radius: 4px;
	border: 0.1px solid rgba(230, 230, 230, 0.3);
	background-color: rgba(0, 0, 0, 0.3);
	margin: 2px 4px;
}

.uni-swiper-indicator .uni-swiper-indicator-item.active {
	border: 0.1px solid rgba(225, 225, 225, 0.9);
	background-color: rgba(255, 255, 255, 0.9);
}
</style>
