<template>
	<view
		ref="wrapper"
		class="uni-swiper-wrapper"
		:class="
			vertical ? 'uni-swiper-wrapper_vertical' : 'uni-swiper-wrapper_horizontal'
		"
		@touchstart="onTouchStart"
		@touchmove="onTouchMove"
		@touchend="onTouchEnd"
		@touchcancel="onTouchEnd">
		<view class="uni-swiper-container" :style="containerStyle">
			<slot></slot>
		</view>
		<view
			v-if="showDefaultIndicator"
			class="uni-swiper-indicator uni-swiper-indicator_default"
			:class="
				vertical
					? 'uni-swiper-indicator_vertical'
					: 'uni-swiper-indicator_horizontal'
			">
			<view
				v-for="i in sliderCount"
				:key="i"
				class="uni-swiper-indicator-item"
				:class="{ active: currentIndex == i - 1 }"
				@touchstart="(e: TouchEvent) => {e.stopPropagation();}"
				@touchmove="(e: TouchEvent) => {e.stopPropagation();}"
				@touchend="(e: TouchEvent) => {e.stopPropagation();}"
				@touchcancel="(e: TouchEvent) => {e.stopPropagation();}"
				@click="handleIndicatorClick(i - 1)">
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch, onMounted, onUnmounted, provide } from 'vue'
import { UniSwiperViewProps, UniSwiperViewChangeEventDetail, UniSwiperViewChangeEvent, UniSwiperViewTransitionEventDetail, UniSwiperViewTransitionEvent,  UniSwiperViewAnimationFinishEvent, ContainerSize } from './types.uts'
import { parsePxRpx, getDirection } from './utils.uts'

const props = withDefaults(defineProps<UniSwiperViewProps>(), {
	// 是否纵向滑动
	vertical: false,
	// 当前显示的slide索引
	current: 0,
	// 是否启用循环切换
	circular: false,
	// 是否自动切换
	autoplay: false,
	// 自动切换时间间隔，单位ms
	interval: 3000,
	// 切换动画时长，单位ms
	duration: 500,
	// 动画缓动函数
	easingFunction: 'default',
	// 前后预留边距，支持px和rpx单位
	previousMargin: '0px',
	nextMargin: '0px',
	// 是否启用边界回弹效果
	rebound: true
})

// 要向开发者 emit 的事件
const emit = defineEmits<{
	change : [event: UniSwiperViewChangeEvent]
	transition : [event: UniSwiperViewTransitionEvent]
	animationfinish : [event: UniSwiperViewAnimationFinishEvent]
}>()

// swiper wrapper,最外层容器
const wrapper = ref<UniElement | null>(null)
// 当前索引
const currentIndex = ref(props.current)
// swiper-slider 数量
const sliderCount = ref(0)
// container translate 位置
const translate = ref(0)
// 是否正在动画
const animating = ref(false)
// auto play setInterval timer
const autoPlayTimer = ref(0)
// 是否显示默认指示器，默认为true
const showDefaultIndicator = ref(true)

// setTimeout 等待动画结束后通知 transition finish 及重置 animating 状态的 timer
let waitAnimationFinishTimer = 0,
touchStartX = 0,
touchStartY = 0,
touchStartTime = 0,
dragging = false,
touchStartTranslate = 0,
isPreventDefault = false,
prevMargin = parsePxRpx(props.previousMargin),
nextMargin = parsePxRpx(props.nextMargin),
sliderItemSize = 0,
autoHeightEnabled = true

const { vertical, circular, autoplay, interval, duration, rebound } = props

const containerStyle = computed(() => {
	const direction = getDirection(vertical)
	const transitionDuration = animating.value ? duration : 0;
	const offset = translate.value + prevMargin

	return `transform: translate${direction}(${offset}px); transition-duration:${transitionDuration}ms;`
})

function getSliders() : UniElement[] | null {
	const wrapperEl = wrapper.value
	if (wrapperEl == null) return null

	const container = wrapperEl.querySelector('.uni-swiper-container')
	if (container == null) return null

	const sliders = container.querySelectorAll('.uni-swiper-slider')
	if (sliders == null || sliders.length == 0) return null
	return sliders
}

function resetSlidersPosition() {
	const sliders = getSliders()
	if (sliders == null) return

	// 循环滑动到第0个的时候，重置第0个和 container 的位置
	if(translate.value <= -1 * sliderCount.value * sliderItemSize){
		translate.value = 0
		sliders[0].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
	// 循环滑动到最后一个的时候，将最后一个和 container 的位置调整到正向滑动到最后一个的位置
	} else if(translate.value > 0){
		translate.value = -(sliderCount.value -1) * sliderItemSize
		sliders[sliders.length - 1].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
	}
}

// 开启衔接滑动时，滑动到边界，如果继续滑动，需要调整前后元素位置以实现无缝衔接
// TODO: 需要考虑要移动的元素不在可视区域时再移动，比如三个 slider & circular & prevMargin/nextMargin > 0 时
function adjustSliderPosition(targetIndex : number, direction? : number | null) {
	// 非衔接滑动 | 少于两个 slider | 两个 slider 且 prevMargin > 0 || nextMargin > 0 时 不支持衔接滑动，不需要调整位置
	if (!circular || sliderCount.value < 2 || (sliderCount.value == 2 && (prevMargin > 0 || nextMargin > 0))) return

	const sliders = getSliders()
	if (sliders == null) return

	resetSlidersPosition()
	// 最后一个 向后继续滑动到 第一个时，将第一个移动到最后一个的后面
	if(targetIndex == 0 && currentIndex.value == sliderCount.value -1 && direction == 1){
		const firstSlider = sliders[0] as UniElement
		firstSlider.style.setProperty('transform', `translate${getDirection(vertical)}(${(sliderCount.value) * sliderItemSize}px)`)
	// 第一个 向前继续滑动到 最后一个时，将最后一个移动到第一个的前面
	} else if (targetIndex == sliderCount.value - 1 && currentIndex.value == 0 && direction == -1){
		const lastSlider = sliders[sliders.length - 1] as UniElement
		lastSlider.style.setProperty('transform', `translate${getDirection(vertical)}(-${sliderCount.value * sliderItemSize}px)`)
	}
}

function slideTo(targetIndex : number, source : string, direction? : number | null) {
	if (targetIndex < 0 || targetIndex >= sliderCount.value) return

	adjustSliderPosition(targetIndex, direction)

	animating.value = true
	if(circular){
		// 第一个 向前继续滑动到 最后一个时
		if(currentIndex.value == 0 && targetIndex == sliderCount.value -1 && direction == -1){
			translate.value = (1 * sliderItemSize)
		// 最后一个 向后继续滑动到 第一个时
		} else if(currentIndex.value == sliderCount.value -1 && targetIndex == 0 && direction == 1){
			translate.value = (sliderCount.value * sliderItemSize * -1)
		} else {
			translate.value = targetIndex * sliderItemSize * -1
		}
	} else {
		translate.value = targetIndex * sliderItemSize * -1
	}

	emit('change', { detail: { current: targetIndex, source } as UniSwiperViewChangeEventDetail } as UniSwiperViewChangeEvent)
	currentIndex.value = targetIndex

	// 清除之前的动画timer
	if (waitAnimationFinishTimer > 0) {
		clearTimeout(waitAnimationFinishTimer)
		waitAnimationFinishTimer = 0
	}

	waitAnimationFinishTimer = setTimeout(() => {
		animating.value = false
		waitAnimationFinishTimer = 0
		emit('animationfinish', { detail: { current: targetIndex, source } as UniSwiperViewChangeEventDetail } as UniSwiperViewAnimationFinishEvent)
		resetSlidersPosition()
	}, duration)
}

function startAutoPlay() {
	if (!autoplay || sliderCount.value <= 1) return

	autoPlayTimer.value = setInterval(() => {
		const next = currentIndex.value == sliderCount.value - 1 ? 0 : currentIndex.value + 1;
		slideTo(next, 'autoplay', 1)
	}, interval)
}

function stopAutoPlay() {
	if (autoPlayTimer.value > 0) {
		clearInterval(autoPlayTimer.value)
		autoPlayTimer.value = 0
	}
}

// 默认指示器点击处理
const handleIndicatorClick = (index : number) => {
	console.log('handle indicator click:', index)
	slideTo(index, 'click', 1)
}

// 更新container高度以适配当前slider的高度（for auto-height）
function updateContainerHeight(index : number) {
	if (!autoHeightEnabled) {
		return
	}

	const sliders = getSliders()
	if (sliders == null) return
	let currentSlider : UniElement | null = sliders[index]

	if (currentSlider != null) {
		const sliderContent = currentSlider.querySelector('.uni-swiper-slider-content') as UniElement | null
		let measuredHeight = 0
		if (sliderContent != null) {
			// harmony 上 scrollHeight 未实现，需要确认这里的逻辑是否合理，如果合理，实现 harmony UniElement.scrollHeight
			measuredHeight = sliderContent.scrollHeight
			if (measuredHeight <= 0) {
				measuredHeight = sliderContent.offsetHeight
			}
		}
		if (measuredHeight <= 0) {
			measuredHeight = currentSlider.scrollHeight
		}
		if (measuredHeight <= 0) {
			measuredHeight = currentSlider.offsetHeight
		}
		if (measuredHeight <= 0) {
			try {
				const rect = currentSlider.getBoundingClientRect()
				measuredHeight = rect.height
			} catch (err) {
				// ignore: fall back to previous height
				console.error('updateContainerHeight fail', err)
			}
		}
		if (measuredHeight > 0) {
			wrapper.value!.style.setProperty('height', measuredHeight + 'px')
		} else {
			wrapper.value!.style.removeProperty('height')
		}
	}
}

// 为swiper-indicator提供数据（provide ref对象以保持响应性）
provide('swiper-vertical', props.vertical)
provide('swiper-current', currentIndex)
provide('swiper-total', sliderCount) // 总是provide真实数量，不包括克隆的
provide('swiper-change', (targetIndex : number) => {
	slideTo(targetIndex, 'click', 1)
})

watch(() : number => props.current, (newVal : number) => {
	if (newVal == currentIndex.value || newVal < 0 || newVal >= sliderCount.value) return
	slideTo(newVal, 'prop', 1)
})

watch(currentIndex, (newVal : number) => {
	updateContainerHeight(newVal)
})

function initIndicators(){
	const wrapperEl = wrapper.value!
	const container = wrapperEl.querySelector('.uni-swiper-container')!
	const indicators = container.querySelectorAll('.uni-swiper-indicator')
	if (indicators == null || indicators.length == 0) return

	// 开发者自定义了指示器组件，将其移动到 wrapper 下，并移除默认指示器
	for (let i = 0; i < indicators.length; i++) {
		const indicator = indicators[i] as UniElement
		wrapperEl.appendChild(indicator)
	}
	showDefaultIndicator.value = false
}

function initSliderCount(){
	const sliders = getSliders()
	if (sliders == null) return
	sliderCount.value = sliders.length
}

function calculateSliderContainerSize() : ContainerSize {
	const wrapperEl = wrapper.value!
	let containerWidth = wrapperEl.offsetWidth
	let containerHeight = wrapperEl.offsetHeight

	if (containerWidth <= 0 || containerHeight <= 0) {
		const rect = wrapperEl.getBoundingClientRect()
		if (containerWidth <= 0 && rect.width > 0) {
			containerWidth = rect.width
		}
		if (containerHeight <= 0 && rect.height > 0) {
			containerHeight = rect.height
		}
	}

	if (containerWidth <= 0) {
		const wrapperWidth = wrapperEl.style.getPropertyValue('width')
		if (wrapperWidth.endsWith("px") || wrapperWidth.endsWith("rpx")) {
			const parsedWidth = parsePxRpx(wrapperWidth)
			if (parsedWidth > 0) {
				containerWidth = parsedWidth
			}
		}
	}
	if (containerHeight <= 0) {
		const wrapperHeight = wrapperEl.style.getPropertyValue('height')
		if (wrapperHeight.endsWith("px") || wrapperHeight.endsWith("rpx")) {
			const parsedHeight = parsePxRpx(wrapperHeight)
			if (parsedHeight > 0) {
				containerHeight = parsedHeight
			}
		}
	}

	if (containerWidth <= 0) {
		containerWidth = uni.getWindowInfo().windowWidth
	}
	return {
		containerWidth,
		containerHeight
	}
}

onMounted(() => {
	const init = () : void => {
		const sliders = getSliders()
		if (sliders == null) return
		initSliderCount()
		initIndicators()
		let { containerWidth, containerHeight } = calculateSliderContainerSize()

		const wrapperEl = wrapper.value!
		const wrapperHeight = wrapperEl.style.getPropertyValue('height')
		let hasFixedHeight = false
		if (wrapperHeight.length > 0 && wrapperHeight !== 'auto') {
			hasFixedHeight = true
			if (containerHeight <= 0) {
				containerHeight = parsePxRpx(wrapperHeight)
			}
		}
		if (!hasFixedHeight && containerHeight <= 0) {
			containerHeight = 0
		}
		autoHeightEnabled = !hasFixedHeight

		// 设置wrapper和slider尺寸
		// itemSize是每个slider的尺寸,需要减去margin,这样slider+margin才等于container宽度
		// 对于水平方向,使用container宽度; 垂直方向,如果container有高度则使用,否则让内容撑开
		if (vertical) {
			if (hasFixedHeight && containerHeight > 0) {
				sliderItemSize = containerHeight - prevMargin - nextMargin
			} else {
				// 垂直方向且container没有固定高度,让每个slider自己决定高度
				sliderItemSize = 0
			}
		} else {
			sliderItemSize = containerWidth - prevMargin - nextMargin
			if (sliderItemSize <= 0) {
				sliderItemSize = containerWidth
			}
		}
		if (sliderItemSize < 0) {
			sliderItemSize = 0
		}

		// 设置container尺寸
		const container = wrapperEl.querySelector('.uni-swiper-container')!
		if (vertical) {
			if (containerWidth > 0) {
				container.style.setProperty('width', containerWidth + 'px')
			}
			if (sliderItemSize > 0) {
				const totalSize = sliderItemSize * sliders.length
				container.style.setProperty('height', totalSize + 'px')
			}
		} else {
			const totalSize = sliderItemSize * sliders.length
			container.style.setProperty('width', totalSize + 'px')
			// 水平方向,如果container有固定高度则设为100%,否则不设置让内容撑开
			if (hasFixedHeight) {
				container.style.setProperty('height', '100%')
			}
		}

		// 设置每个slider的尺寸
		for (let i = 0; i < sliders.length; i++) {
			const s = sliders[i] as UniElement
			if (vertical) {
				if (containerWidth > 0) {
					s.style.setProperty('width', containerWidth + 'px')
				}
				if (sliderItemSize > 0) {
					s.style.setProperty('height', sliderItemSize + 'px')
				}
				// 如果itemSize为0,不设置高度,让内容自己撑开
			} else {
				if (sliderItemSize > 0) {
					s.style.setProperty('width', sliderItemSize + 'px')
				} else if (containerWidth > 0) {
					s.style.setProperty('width', containerWidth + 'px')
				}
				// 水平方向,如果container有固定高度则设为100%,否则让内容自己撑开
				if (hasFixedHeight) {
					s.style.setProperty('height', '100%')
				}
				// 否则不设置高度,让内容自己撑开
			}
		}

		// 设置container的overflow:水平方向visible显示前后,垂直方向hidden裁剪
		if (prevMargin > 0 || nextMargin > 0) {
			if (vertical) {
				// 垂直方向:上下需要显示margin区域,左右裁剪
				wrapperEl.style.setProperty('overflow-x', 'hidden')
				wrapperEl.style.setProperty('overflow-y', 'visible')
			} else {
				// 水平方向:左右需要显示margin区域,上下裁剪
				wrapperEl.style.setProperty('overflow-x', 'visible')
				wrapperEl.style.setProperty('overflow-y', 'hidden')
			}
		}

		// 初始位置
		const initialIndex = props.current > 0 && props.current < sliderCount.value ? props.current : 0
		currentIndex.value = initialIndex

		if(initialIndex != 0) {
			translate.value = -(initialIndex * sliderItemSize)
		}

		startAutoPlay()
		updateContainerHeight(initialIndex)
	}

	setTimeout(function () {
		Promise.resolve().then(init)
	}, 100)
})

onUnmounted(() => stopAutoPlay())

const onTouchStart = (e : TouchEvent) => {
	console.log('onTouchStart ------------------------');
	stopAutoPlay()

	// 如果正在动画中,停止动画
	if (animating.value) {
		animating.value = false
		if (waitAnimationFinishTimer > 0) {
			clearTimeout(waitAnimationFinishTimer)
			waitAnimationFinishTimer = 0
		}
	}
	resetSlidersPosition()

	const t = e.touches[0]
	touchStartX = t.pageX
	touchStartY = t.pageY
	touchStartTime = Date.now()
	dragging = true
	touchStartTranslate = translate.value
	isPreventDefault = false
}

const onTouchMove = (e : TouchEvent) => {
	console.log('onTouchMove ------------------------');
	if (!dragging) return

	const t = e.touches[0]
	const dx = t.pageX - touchStartX
	const dy = t.pageY - touchStartY
	let delta = vertical ? dy : dx
	let targetIndex = currentIndex.value
	const direction = delta > 0 ? -1 : 1
	if(delta > 0){
		// 向前拖动
		targetIndex = currentIndex.value -1
	} else if(delta < 0){
		// 向后拖动
		targetIndex = currentIndex.value +1
	}
	if(targetIndex < 0){
		targetIndex = circular ? sliderCount.value -1 : 0
	} else if(targetIndex >= sliderCount.value){
		targetIndex = circular ? 0 : sliderCount.value -1
	}
	adjustSliderPosition(targetIndex, direction)

	// 先计算是否在边界
	let atBoundary = false
	let shouldPreventDefault = true

	if (!circular && !rebound && sliderCount.value > 0) {
		// rebound=false时，检查是否到达边界
		const minTranslate = -(sliderCount.value - 1) * sliderItemSize
		const maxTranslate = 0
		const newTranslate = touchStartTranslate + delta

		if ((newTranslate > maxTranslate && delta > 0) || (newTranslate < minTranslate && delta < 0)) {
			// 到达边界且继续往边界外拉，不阻止默认事件
			atBoundary = true
			shouldPreventDefault = false
		}
	}

	if (!isPreventDefault) {
		const adx = Math.abs(dx), ady = Math.abs(dy)
		if ((vertical && ady > adx) || (!vertical && adx > ady)) {
			isPreventDefault = true
			// 只在确定滑动方向后才开始emit transition事件
			emit('transition', { detail: { dx, dy } as UniSwiperViewTransitionEventDetail } as UniSwiperViewTransitionEvent)
		}
		// 根据边界情况决定是否阻止默认事件
		if (isPreventDefault && !atBoundary && (adx > 5 || ady > 5)) {
			e.preventDefault()
		}
	} else {
		// 如果不在边界，阻止默认事件；在边界则允许冒泡
		if (!atBoundary) {
			e.preventDefault()
		}
		emit('transition', { detail: { dx, dy } as UniSwiperViewTransitionEventDetail } as UniSwiperViewTransitionEvent)
	}

	if (circular && sliderCount.value > 1) {
		translate.value = touchStartTranslate + delta
	} else {
		// 非circular模式
		const minTranslate = -(sliderCount.value - 1) * sliderItemSize
		const maxTranslate = 0
		const newTranslate = touchStartTranslate + delta

		if (rebound) {
			// rebound=true: 允许超出边界，但有阻尼效果
			if (newTranslate > maxTranslate) {
				// 超出上边界，应用阻尼（减速到30%）
				const overScroll = newTranslate - maxTranslate
				translate.value = maxTranslate + overScroll * 0.3
			} else if (newTranslate < minTranslate) {
				// 超出下边界，应用阻尼
				const overScroll = newTranslate - minTranslate
				translate.value = minTranslate + overScroll * 0.3
			} else {
				translate.value = newTranslate
			}
		} else {
			// rebound=false: 不允许超出边界
			if (newTranslate > maxTranslate) {
				translate.value = maxTranslate
			} else if (newTranslate < minTranslate) {
				translate.value = minTranslate
			} else {
				translate.value = newTranslate
			}
		}
	}
}

const onTouchEnd = (e : TouchEvent) => {
	console.log('onTouchEnd ------------------------');
	if (!dragging) return
	dragging = false

	const t = e.changedTouches[0]
	const dx = t.pageX - touchStartX
	const dy = t.pageY - touchStartY
	const dt = Date.now() - touchStartTime
	// < 0, 表示向前滑动，要向后切换
	const delta = vertical ? dy : dx
	const direction = delta < 0 ? 1 : -1
	const abs = Math.abs(delta)

	const shouldChange = (dt < 300 && abs > 30) || abs > 100
	if (!shouldChange){
		slideTo(currentIndex.value, 'touch', direction)
		return
	}

	// 两个 slider 且没有前后边距 或者 多于两个 slider 时，才支持循环切换
	if (circular && (sliderCount.value > 2 || (sliderCount.value ==2 && prevMargin == 0 && nextMargin == 0))) {
		// 判断拖动到哪个位置
		if (delta > 0) {
			// 向前切换
			const nextIndex = (currentIndex.value - 1 + sliderCount.value) % sliderCount.value
			slideTo(nextIndex, 'touch', -1)
		} else if (delta < 0) {
			// 向后切换
			const nextIndex = (currentIndex.value + 1) % sliderCount.value
			slideTo(nextIndex, 'touch', 1)
		}
	} else {
		// 非circular模式
		const minTranslate = -(sliderCount.value - 1) * sliderItemSize
		const maxTranslate = 0
		const currentTranslate = translate.value

		// 检查是否超出边界（rebound效果）
		if (rebound && (currentTranslate > maxTranslate || currentTranslate < minTranslate)) {
			// 有回弹效果：回弹到边界
			if (currentTranslate > maxTranslate) {
				slideTo(0, 'touch', direction)
			} else {
				slideTo(sliderCount.value - 1, 'touch', direction)
			}
		} else {
			if (delta > 0 && currentIndex.value > 0) {
				slideTo(currentIndex.value - 1, 'touch', direction)
			} else if (delta < 0 && currentIndex.value < sliderCount.value - 1) {
				slideTo(currentIndex.value + 1, 'touch', direction)
			} else {
				slideTo(currentIndex.value, 'touch', direction)
			}
		}
	}

	startAutoPlay()
}
</script>

<style>
.uni-swiper-wrapper {
	position: relative;
	width: 100%;
	overflow: hidden;
}

/* #ifdef WEB */
/* 隐藏滚动条但保持overflow功能 */
.uni-swiper-wrapper::-webkit-scrollbar {
	display: none;
}
.uni-swiper-wrapper {
	/* IE and Edge */
	-ms-overflow-style: none;
	/* Firefox */
	scrollbar-width: none;
}
/* #endif */

.uni-swiper-container {
	position: relative;
	display: flex;
	width: 100%;
	flex: 1;
	flex-direction: row;
	transition: transform;
	overflow: visible;
}

.uni-swiper-wrapper_horizontal .uni-swiper-container {
	flex-direction: row;
}

.uni-swiper-wrapper_vertical .uni-swiper-container {
	flex-direction: column;
	width: 100%;
}

/* 默认指示器样式 */
.uni-swiper-indicator {
	position: absolute;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10;
