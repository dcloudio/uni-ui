<template>
	<view
		ref="wrapper"
		class="new-uni-swiper-wrapper relative w-100"
		@touchstart="onTouchStart"
		@touchmove="onTouchMove"
		@touchend="onTouchEnd"
		@touchcancel="onTouchEnd">
		<view
			class="new-uni-swiper-container w-100 overflow-visible"
			:class="vertical ? 'w-100 flex-column' : 'flex-row'"
			:style="containerStyle">
			<slot></slot>
		</view>
		<view
			v-if="showDefaultIndicator"
			class="new-uni-swiper-indicator absolute justify-center align-center"
			:class="
				vertical
					? 'new-uni-swiper-indicator_vertical flex-column'
					: 'new-uni-swiper-indicator_horizontal flex-row'
			">
			<view
				v-for="i in sliderCount"
				:key="i"
				class="new-uni-swiper-indicator-item"
				:class="{ active: currentIndex == i - 1 }"
				@touchstart="(e: TouchEvent) => {e.stopPropagation();}"
				@touchmove="(e: TouchEvent) => {e.stopPropagation();e.preventDefault()}"
				@touchend="(e: TouchEvent) => {e.stopPropagation();}"
				@touchcancel="(e: TouchEvent) => {e.stopPropagation();}"
				@click="handleIndicatorClick(i - 1)">
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch, onMounted, onUnmounted, provide } from 'vue'
import { UniSwiperViewProps, UniSwiperViewChangeEventDetail, UniSwiperViewChangeEvent, UniSwiperViewTransitionEventDetail, UniSwiperViewTransitionEvent,  UniSwiperViewAnimationFinishEvent, ContainerSize } from './types.uts'
import { parsePxRpx, getDirection } from './utils.uts'

const props = withDefaults(defineProps<UniSwiperViewProps>(), {
	vertical: false,
	current: 0,
	circular: false,
	autoplay: false,
	interval: 3000,
	duration: 500,
	easingFunction: 'default',
	previousMargin: '0px',
	nextMargin: '0px',
	disableBounce: false
})

const emit = defineEmits<{
	change : [event: UniSwiperViewChangeEvent]
	transition : [event: UniSwiperViewTransitionEvent]
	animationfinish : [event: UniSwiperViewAnimationFinishEvent]
}>()

const wrapper = ref<UniElement | null>(null)
const currentIndex = ref(props.current)
const sliderCount = ref(0)
const translate = ref(0)
const animating = ref(false)
const autoPlayTimer = ref(0)
const showDefaultIndicator = ref(true)

let waitAnimationFinishTimer = 0,
touchStartX = 0,
touchStartY = 0,
touchStartTime = 0,
dragging = false,
touchStartTranslate = 0,
prevMargin = parsePxRpx(props.previousMargin),
nextMargin = parsePxRpx(props.nextMargin),
sliderItemSize = 0,
autoHeightEnabled = true,
firstSliderPosition = 'start',
lastSliderPosition = 'end',
maxTranslate = 0,
minTranslate = 0


const { vertical, circular, autoplay, interval, duration, disableBounce } = props

const containerStyle = computed(() => {
	const transitionDuration = animating.value ? duration : 0;
	const offset = translate.value + prevMargin

	return `transform: translate${getDirection(vertical)}(${offset}px); transition-duration:${transitionDuration}ms; transition-timing-function: ${props.easingFunction};`
})

const isMarginAndMultipleSliders = computed(() => {
	return (prevMargin > 0 || nextMargin > 0) && sliderCount.value > 2
})

const sliders = computed(() : UniElement[] | null => {
	const wrapperEl = wrapper.value
	if (wrapperEl == null) return null

	const container = wrapperEl.querySelector('.new-uni-swiper-container')
	if (container == null) return null

	const sliders = container.querySelectorAll('.uni-swiper-slider')
	if (sliders == null || sliders.length == 0) return null
	return sliders
})

function clearWaitAnimationFinishTimer() {
	if (waitAnimationFinishTimer > 0) {
		clearTimeout(waitAnimationFinishTimer)
		waitAnimationFinishTimer = 0
	}
}

function isStartToEndSlide(targetIndex: number, direction? : number | null) : boolean {
	return currentIndex.value == 0 && targetIndex == sliderCount.value - 1 && direction == -1
}

function isEndToStartSlide(targetIndex: number, direction? : number | null) : boolean {
	return currentIndex.value == sliderCount.value - 1 && targetIndex == 0 && direction == 1
}

function isSupportCircular() : boolean {
	return circular && (sliderCount.value > 2 || (sliderCount.value == 2 && prevMargin == 0 && nextMargin == 0))
}

let resetSlidersPosition = () => {}

function adjustSliderPositionWhenNoMargin(targetIndex : number, direction? : number | null) {
	const isEndToStartNeedAdjustPosition = isEndToStartSlide(targetIndex, direction) && firstSliderPosition == 'start'
	const isStartToEndNeedAdjustPosition = isStartToEndSlide(targetIndex, direction) && lastSliderPosition == 'end'

	if(isStartToEndNeedAdjustPosition || isEndToStartNeedAdjustPosition){
		resetSlidersPosition()
		const _sliders = sliders.value!
		if(isEndToStartNeedAdjustPosition){
			const firstSlider = _sliders[0] as UniElement
			firstSlider.style.setProperty('transform', `translate${getDirection(vertical)}(${(sliderCount.value) * sliderItemSize}px)`)
			firstSliderPosition = 'end'
			return
		}
		const lastSlider = _sliders[_sliders.length - 1] as UniElement
		lastSlider.style.setProperty('transform', `translate${getDirection(vertical)}(${-(sliderCount.value) * sliderItemSize}px)`)
		lastSliderPosition = 'start'
	}
}

function adjustSliderPositionWhenHasMargin(targetIndex? : number | null, direction? : number | null){
	const _sliders = sliders.value!
	if(targetIndex == 0){
		if(firstSliderPosition == 'start' && direction == 1){
			_sliders[0].style.setProperty('transform', `translate${getDirection(vertical)}(${(sliderCount.value) * sliderItemSize}px)`)
			firstSliderPosition = 'end'
			return
		}
		if(lastSliderPosition == 'end' && currentIndex.value != sliderCount.value -1 && !animating.value){
			_sliders[_sliders.length - 1].style.setProperty('transform', `translate${getDirection(vertical)}(${-(sliderCount.value) * sliderItemSize}px)`)
			lastSliderPosition = 'start'
		}
		return
	}
	if(targetIndex == sliderCount.value -1 && firstSliderPosition == 'start' && lastSliderPosition == 'end'){
		_sliders[0].style.setProperty('transform', `translate${getDirection(vertical)}(${(sliderCount.value) * sliderItemSize}px)`)
		firstSliderPosition = 'end'
		return
	}
	if(targetIndex != 0 && firstSliderPosition != 'start'){
		_sliders[0].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
		firstSliderPosition = 'start'
	}
	if(targetIndex != sliderCount.value -1 && lastSliderPosition != 'end'){
		_sliders[_sliders.length - 1].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
		lastSliderPosition = 'end'
	}
}

function adjustSliderPosition(targetIndex? : number | null, direction? : number | null) {
	if (!isSupportCircular()) return
	if(isMarginAndMultipleSliders.value){
		adjustSliderPositionWhenHasMargin(targetIndex, direction)
	} else {
		adjustSliderPositionWhenNoMargin(targetIndex!, direction)
	}
}

function resetSlidersPositionWhenHasMargin(){
	const _sliders = sliders.value!
	if(currentIndex.value != sliderCount.value - 1 && firstSliderPosition != 'start'){
		translate.value = 0
		_sliders[0].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
		firstSliderPosition = 'start'
		adjustSliderPosition(currentIndex.value, null)
		return
	}
	if(currentIndex.value != 0 && lastSliderPosition != 'end'){
		_sliders[_sliders.length - 1].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
		lastSliderPosition = 'end'
		if(currentIndex.value == sliderCount.value -1){
			translate.value = -(sliderCount.value -1) * sliderItemSize
			adjustSliderPosition(currentIndex.value, null)
		}
	}
	if(currentIndex.value > 0 && currentIndex.value < sliderCount.value - 1 && (lastSliderPosition != 'end' && firstSliderPosition != 'start')){
		adjustSliderPosition(currentIndex.value, null)
	}
}

function resetSlidersPositionWhenNoMargin() {
	const _sliders = sliders.value!
	if(translate.value <= -1 * sliderCount.value * sliderItemSize){
		translate.value = 0
		_sliders[0].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
		firstSliderPosition = 'start'
	} else if(translate.value > 0){
		translate.value = -(sliderCount.value -1) * sliderItemSize
		_sliders[_sliders.length - 1].style.setProperty('transform', `translate${getDirection(vertical)}(0px)`)
		lastSliderPosition = 'end'
	}
}

resetSlidersPosition = () => {
	if(isMarginAndMultipleSliders.value){
		resetSlidersPositionWhenHasMargin()
	} else {
		resetSlidersPositionWhenNoMargin()
	}
}

function slideTo(targetIndex : number, source : string, direction? : number | null) {
	if (targetIndex < 0 || targetIndex >= sliderCount.value) return


	animating.value = true
	adjustSliderPosition(targetIndex, direction)
	if(circular && isStartToEndSlide(targetIndex, direction)){
		translate.value = (1 * sliderItemSize)
	} else if(circular && isEndToStartSlide(targetIndex, direction)){
		translate.value = (sliderCount.value * sliderItemSize * -1)
	} else {
		translate.value = targetIndex * sliderItemSize * -1
	}
	currentIndex.value = targetIndex
	emit('change', { detail: { current: targetIndex, source } as UniSwiperViewChangeEventDetail } as UniSwiperViewChangeEvent)

	clearWaitAnimationFinishTimer()

	waitAnimationFinishTimer = setTimeout(() => {
		emit('animationfinish', { detail: { current: targetIndex, source } as UniSwiperViewChangeEventDetail } as UniSwiperViewAnimationFinishEvent)
		animating.value = false
		waitAnimationFinishTimer = 0
		resetSlidersPosition()
	}, duration)
}

function startAutoPlay() {
	if (!autoplay || sliderCount.value <= 1) return

	autoPlayTimer.value = setInterval(() => {
		const next = currentIndex.value == sliderCount.value - 1 ? 0 : currentIndex.value + 1;
		slideTo(next, 'autoplay', 1)
	}, interval)
}

function stopAutoPlay() {
	if (autoPlayTimer.value > 0) {
		clearInterval(autoPlayTimer.value)
		autoPlayTimer.value = 0
	}
}

const handleIndicatorClick = (index : number) => {
	slideTo(index, 'click', 1)
}

function updateWrapperHeight(index : number) {
	if (!autoHeightEnabled) return

	const _sliders = sliders.value!
	const currentSlider : UniElement | null = _sliders[index]
	if (currentSlider != null) {
		const sliderContent = currentSlider.querySelector('.uni-swiper-slider-content') as UniElement
		wrapper.value!.style.setProperty('height', `${sliderContent.offsetHeight}px`)
	}
}

function initIndicators(){
	const wrapperEl = wrapper.value!
	const container = wrapperEl.querySelector('.new-uni-swiper-container')!
	const indicators = container.querySelectorAll('.new-uni-swiper-indicator')
	if (indicators == null || indicators.length == 0) return

	for (let i = 0; i < indicators.length; i++) {
		const indicator = indicators[i] as UniElement
		wrapperEl.appendChild(indicator)
	}
	showDefaultIndicator.value = false
}

function initSliderCount(){
	sliderCount.value = sliders.value!.length
}

function updateMinTranslate() {
	minTranslate = -(sliderCount.value - 1) * sliderItemSize
}

function fixIndex(index: number): number {
	if(index < 0){
		return circular ? sliderCount.value - 1 : 0
	} else if(index >= sliderCount.value){
		return circular ? 0 : sliderCount.value - 1
	}
	return index
}

function calculateSliderContainerSize() : ContainerSize {
	const wrapperEl = wrapper.value!
	let containerWidth = wrapperEl.offsetWidth
	let containerHeight = wrapperEl.offsetHeight

	if (containerWidth <= 0 || containerHeight <= 0) {
		const rect = wrapperEl.getBoundingClientRect()
		if (containerWidth <= 0 && rect.width > 0) {
			containerWidth = rect.width
		}
		if (containerHeight <= 0 && rect.height > 0) {
			containerHeight = rect.height
		}
	}

	if (containerWidth <= 0) {
		const wrapperWidth = wrapperEl.style.getPropertyValue('width')
		if (wrapperWidth.endsWith("px") || wrapperWidth.endsWith("rpx")) {
			const parsedWidth = parsePxRpx(wrapperWidth)
			if (parsedWidth > 0) {
				containerWidth = parsedWidth
			}
		}
	}
	if (containerHeight <= 0) {
		const wrapperHeight = wrapperEl.style.getPropertyValue('height')
		if (wrapperHeight.endsWith("px") || wrapperHeight.endsWith("rpx")) {
			const parsedHeight = parsePxRpx(wrapperHeight)
			if (parsedHeight > 0) {
				containerHeight = parsedHeight
			}
		}
	}

	return {
		containerWidth,
		containerHeight
	}
}

function calculateSliderItemSize(hasFixedHeight: boolean, containerWidth: number, containerHeight: number) {
	if (vertical) {
		if (hasFixedHeight && containerHeight > 0) {
			sliderItemSize = containerHeight - prevMargin - nextMargin
		} else {
			sliderItemSize = 0
		}
	} else {
		sliderItemSize = containerWidth - prevMargin - nextMargin
		if (sliderItemSize <= 0) {
			sliderItemSize = containerWidth
		}
	}
	if (sliderItemSize < 0) {
		sliderItemSize = 0
	}
}

function updateContainerSize(containerWidth: number, containerHeight: number, hasFixedHeight: boolean) {
	const container = wrapper.value!.querySelector('.new-uni-swiper-container')!
	const _sliders = sliders.value!
	if (vertical) {
		if (containerWidth > 0) {
			container.style.setProperty('width', containerWidth + 'px')
		}
		if (sliderItemSize > 0) {
			const totalSize = sliderItemSize * _sliders.length
			container.style.setProperty('height', totalSize + 'px')
		}
	} else {
		const totalSize = sliderItemSize * _sliders.length
		container.style.setProperty('width', totalSize + 'px')
		if (hasFixedHeight) {
			container.style.setProperty('height', '100%')
		}
	}
}

function updateSlidersSize(containerWidth: number, sliderItemSize: number, hasFixedHeight: boolean){
	let sliderWidth = '', sliderHeight = ''
	if (vertical) {
		if (containerWidth > 0) {
			sliderWidth = containerWidth + 'px'
		}
		if (sliderItemSize > 0) {
			sliderHeight = sliderItemSize + 'px'
		}
	} else {
		if (sliderItemSize > 0) {
			sliderWidth = sliderItemSize + 'px'
		} else if (containerWidth > 0) {
			sliderWidth = containerWidth + 'px'
		}
		if (hasFixedHeight) {
			sliderHeight = '100%'
		}
	}

	const _sliders = sliders.value!
	for (let i = 0; i < _sliders.length; i++) {
		const item = _sliders[i]
		if (sliderWidth.length > 0) {
			item.style.setProperty('width', sliderWidth)
		}
		if (sliderHeight.length > 0) {
			item.style.setProperty('height', sliderHeight)
		}
	}
}

function updateWrapperOverflow() {
	if (prevMargin > 0 || nextMargin > 0) {
		if (vertical) {
			wrapper.value!.style.setProperty('overflow-x', 'hidden')
			wrapper.value!.style.setProperty('overflow-y', 'visible')
		} else {
			wrapper.value!.style.setProperty('overflow-x', 'visible')
			wrapper.value!.style.setProperty('overflow-y', 'hidden')
		}
	}
}

function init(){
	if (sliders.value == null) return

	initSliderCount()
	initIndicators()

	let { containerWidth, containerHeight } = calculateSliderContainerSize()
	const wrapperHeight = wrapper.value!.style.getPropertyValue('height')
	let hasFixedHeight = false
	if (wrapperHeight.length > 0 && wrapperHeight !== 'auto') {
		hasFixedHeight = true
		if (containerHeight <= 0) {
			containerHeight = parsePxRpx(wrapperHeight)
		}
	}
	if (!hasFixedHeight && containerHeight <= 0) {
		containerHeight = 0
	}
	autoHeightEnabled = !hasFixedHeight

	calculateSliderItemSize(hasFixedHeight, containerWidth, containerHeight)

	updateContainerSize(containerWidth, containerHeight, hasFixedHeight)

	updateSlidersSize(containerWidth, sliderItemSize, hasFixedHeight)

	updateWrapperOverflow()

	currentIndex.value = props.current > 0 && props.current < sliderCount.value ? props.current : 0

	if(currentIndex.value != 0) {
		translate.value = -(currentIndex.value * sliderItemSize)
	}

	adjustSliderPosition(currentIndex.value, null)
	updateMinTranslate()
	updateWrapperHeight(currentIndex.value)
	startAutoPlay()
}

const onTouchStart = (e : TouchEvent) => {
	// #ifdef APP-ANDROID
	e.preventDefault()
	// #endif
	stopAutoPlay()

	if (animating.value) {
		animating.value = false
		clearWaitAnimationFinishTimer()
	}
	resetSlidersPosition()

	const t = e.touches[0]
	touchStartX = t.pageX
	touchStartY = t.pageY
	touchStartTime = Date.now()
	dragging = true
	touchStartTranslate = translate.value
}

const onTouchMove = (e : TouchEvent) => {
	if (!dragging) return

	const t = e.touches[0]
	const dx = t.pageX - touchStartX
	const dy = t.pageY - touchStartY
	const delta = vertical ? dy : dx
	const direction = delta > 0 ? -1 : 1
	const currentTranslate = touchStartTranslate + delta

	const targetIndex = fixIndex(currentIndex.value + direction)
	adjustSliderPosition(targetIndex, direction)

	const atBoundary = !circular && disableBounce && sliderCount.value > 0 && ((currentTranslate > maxTranslate && delta > 0) || (currentTranslate < minTranslate && delta < 0))
	if (!atBoundary) {
		e.preventDefault()
	}

	if (delta != 0) {
		emit('transition', { detail: { dx, dy } as UniSwiperViewTransitionEventDetail } as UniSwiperViewTransitionEvent)
	}

	if (disableBounce) {
		if(currentTranslate > maxTranslate){
			translate.value = maxTranslate
			return
		}
		if (currentTranslate < minTranslate) {
			translate.value = minTranslate
			return
		}
	}
	if (!disableBounce) {
		if(currentTranslate > maxTranslate){
			const overScroll = currentTranslate - maxTranslate
			translate.value = maxTranslate + overScroll * 0.3
			return
		}
		if (currentTranslate < minTranslate) {
			const overScroll = currentTranslate - minTranslate
			translate.value = minTranslate + overScroll * 0.3
			return
		}
	}
	translate.value = currentTranslate
}

const onTouchEnd = (e : TouchEvent) => {
	if (!dragging) return
	dragging = false

	const t = e.changedTouches[0]
	const dx = t.pageX - touchStartX
	const dy = t.pageY - touchStartY
	const dt = Date.now() - touchStartTime
	const delta = vertical ? dy : dx
	const abs = Math.abs(delta)
	const source = 'touch'
	let direction = delta < 0 ? 1 : -1

	const shouldChange = (dt < 300 && abs > 30) || abs > 100
	if (!shouldChange){
		slideTo(currentIndex.value, source, direction)
		return
	}

	let nextIndex = currentIndex.value
	if (isSupportCircular()) {
		if (delta > 0) {
			nextIndex = (currentIndex.value - 1 + sliderCount.value) % sliderCount.value
		} else if (delta < 0) {
			nextIndex = (currentIndex.value + 1) % sliderCount.value
		}
	} else {
		if (!disableBounce && (translate.value > maxTranslate || translate.value < minTranslate)) {
			if (translate.value > maxTranslate) {
				nextIndex = 0
			} else {
				nextIndex = sliderCount.value - 1
			}
		} else {
			if (delta > 0 && currentIndex.value > 0) {
				nextIndex = currentIndex.value - 1
			} else if (delta < 0 && currentIndex.value < sliderCount.value - 1) {
				nextIndex = currentIndex.value + 1
			}
		}
	}
	slideTo(nextIndex, source, direction)

	startAutoPlay()
}

provide('swiper-vertical', props.vertical)
provide('swiper-current', currentIndex)
provide('swiper-total', sliderCount)
provide('swiper-change', (targetIndex : number) => {
	slideTo(targetIndex, 'click', 1)
})

watch(() : number => props.current, (newVal : number) => {
	if (newVal == currentIndex.value || newVal < 0 || newVal >= sliderCount.value) return
	slideTo(newVal, 'prop', 1)
})

watch(currentIndex, (newVal : number) => {
	updateWrapperHeight(newVal)
})

onMounted(() => {
	// #ifdef APP
	setTimeout(() => {
		init()
	}, 100);
	// #endif
	// #ifndef APP
	init()
	// #endif
})

onUnmounted(() => {
	stopAutoPlay()
	clearWaitAnimationFinishTimer()
})
</script>

<style>
@import url('../styles/common.css');
@import url('../styles/indicator.css');

/* #ifdef WEB */
.new-uni-swiper-wrapper {
	display: block;
}
.new-uni-swiper-wrapper::-webkit-scrollbar {
	display: none;
}
.new-uni-swiper-wrapper {
	/* IE and Edge */
	-ms-overflow-style: none;
	/* Firefox */
	scrollbar-width: none;
}
/* #endif */

.new-uni-swiper-container {
	transition: transform;
}

.new-uni-swiper-indicator {
	z-index: 10;
	background-color: transparent;
	bottom: 0px;
	right: 0px;
	/* #ifdef APP || MP */
	pointer-events: none;
	/* #endif */
}

.new-uni-swiper-indicator.new-uni-swiper-indicator_horizontal {
	left: 0px;
	height: 40px;
}

.new-uni-swiper-indicator.new-uni-swiper-indicator_vertical {
	top: 0px;
	width: 40px;
}
</style>
