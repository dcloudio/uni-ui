<template>
  <view
    v-if="loadinging"
    class="uni-button"
    :class="hasLoadingViewClass"
    :hover-class="disabled ? 'none' : hoverClass"
    :hover-start-time="hoverStartTime"
    :hover-stay-time="hoverStayTime"
    :hover-stop-propagation="hoverStopPropagation"
    @click="handleTap">
    <loading :style="loadingStyle" />
    <text class="uni-button-text" :class="hasLoadingTextClass">
      <slot></slot>
    </text>
  </view>
  <text
    v-else
    class="uni-button uni-button-text"
    :class="notLoadingTextClass"
    :hover-class="disabled ? 'none' : hoverClass"
    :hover-start-time="hoverStartTime"
    :hover-stay-time="hoverStayTime"
    :hover-stop-propagation="hoverStopPropagation"
    @click="handleTap">
    <slot></slot>
  </text>
</template>

<script lang="uts" setup>
  const FORM_KEY = 'UNI_FORM_CTX'

  type ButtonSize = 'default' | 'mini'
  type ButtonType = 'default' | 'primary' | 'warn'
  type FormType = 'submit' | 'reset'

  const emit = defineEmits<{
    click: []
  }>()

  const props = defineProps({
    disabled: {
      type: Boolean,
      default: false
    },
    type: {
      type: String,
      default: "default"
    },
    size: {
      type: String,
      default: "default"
    },
    plain: {
      type: Boolean,
      default: false,
    },
    hoverClass: {
      type: String,
      default: 'button-hover',
    },
    hoverStartTime: {
      type: Number,
      default: 20,
    },
    hoverStayTime: {
      type: Number,
      default: 70,
    },
    hoverStopPropagation: {
      type: Boolean,
      default: false,
    },
    loadinging: {
      type: Boolean,
      default: false,
    },
    loadingStyle: {
      type: String as PropType<string>,
      default: '',
    },
    formType: {
      type: String,
      default: '',
    },
    openType: {
      type: String,
      default: '',
    },
  })

  interface InjectedFormContext {
    registerField: (field: any) => void
    unregisterField: (name: string) => void
    submit: () => void
    reset: () => void
  }

  const formCtx = inject<InjectedFormContext | null>(FORM_KEY, null)

  const getViewClass = () : Array<string> => {
    const classes : Array<string> = []
    switch (props.type) {
      case 'default':
        classes.push('uni-button-type-default_view')
        break;
      case 'primary':
        classes.push('uni-button-type-primary_view')
        break;
      case 'warn':
        classes.push('uni-button-type-warn_view')
        break;
    }
    if (props.plain) {
      classes.push('uni-button-view-plain')
    }
    if (props.disabled) {
      classes.push('uni-button-disabled')
    }
    switch (props.size) {
      case 'mini':
        classes.push('uni-button-size-mini')
        break;
    }
    return classes
  }

  const getTextClass = () : Array<string> => {
    const classes : Array<string> = []
    switch (props.type) {
      case 'default':
        classes.push('uni-button-type-default_text')
        break;
      case 'primary':
        classes.push('uni-button-type-primary_text')
        break;
      case 'warn':
        classes.push('uni-button-type-warn_text')
        break;
    }
    switch (props.size) {
      case 'mini':
        classes.push('uni-button-text-size-mini')
        break;
    }
    return classes
  }

  const hasLoadingViewClass = computed(() : Array<string> => {
    return getViewClass()
  })

  const hasLoadingTextClass = computed(() : Array<string> => {
    return getTextClass()
  })

  const notLoadingTextClass = computed(() : Array<string> => {
    const viewClasses = getViewClass()
    const textClasses = getTextClass()
    return [...viewClasses, ...textClasses]
  })

  const checkFormAndSubmitOrReset = () => {
    if (props.formType != 'submit' && props.formType != 'reset') {
      return
    }
    if (formCtx == null) {
      return
    }
    if (props.formType == 'submit') {
      formCtx.submit()
    } else if (props.formType == 'reset') {
      formCtx.reset()
    }
  }
	
	const handleTap = () => {
	  if (props.disabled) {
	    return
	  }

	  emit('click')
	  checkFormAndSubmitOrReset()
	}
</script>

<style>
  .uni-button {
    position: relative;
    box-sizing: border-box;
    border-radius: 5px;
    overflow: hidden;
    border-style: solid;
    border-width: 0.5px;
    border-color: rgba(0, 0, 0, 0.2);
    padding: 0 15px;
  }

  .uni-button-text {
    line-height: 44px;
    text-align: center;
    padding: 0 15px;
  }

  .uni-button-text-size-mini {
    line-height: 28px;
  }

  .uni-button-size-mini {
    padding: 4px 12px;
  }

  .uni-button-disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .button-hover {
    opacity: 0.8;
  }

  .uni-button-type-default_view {
    background-color: #f8f8f8;
  }

  .uni-button-type-primary_view {
    background-color: #007aff;
  }

  .uni-button-type-warn_view {
    background-color: #e64340;
  }

  .uni-button-type-default_text {
    color: #000000;
  }

  .uni-button-type-primary_text {
    color: #ffffff;
  }

  .uni-button-type-warn_text {
    color: #ffffff;
  }

  .uni-button-view-plain {
    border-width: 1px;
    background-color: transparent;
  }

  .uni-button-view-plain.uni-button-type-default_view {
    border-color: rgba(0, 0, 0, 0.2);
  }

  .uni-button-view-plain.uni-button-type-primary_view {
    border-color: #007aff;
  }

  .uni-button-view-plain.uni-button-type-warn_view {
    border-color: #e64340;
  }

  .uni-button-view-plain .uni-button-type-default_text {
    color: #000000;
  }

  .uni-button-view-plain .uni-button-type-primary_text {
    color: #007aff;
  }

  .uni-button-view-plain .uni-button-type-warn_text {
    color: #e64340;
  }

  .uni-button-view-plain.uni-button-type-default_text {
    color: #000000;
  }

  .uni-button-view-plain.uni-button-type-primary_text {
    color: #007aff;
  }

  .uni-button-view-plain.uni-button-type-warn_text {
    color: #e64340;
  }
</style>