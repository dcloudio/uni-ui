<template>
	<view class="uni-rate" @click="handleClick">
		<text 
			v-for="(star, index) in stars" 
			:key="index"
			class="uni-rate__star"
			:class="[
				star.filled ? 'selected' : '',
				star.filled ? selectedClass : '',
				plain && !star.filled ? 'uni-rate__star--plain' : ''
			]"
			:style="getStarStyle(star.filled)"
		>
			{{ getStarSymbol(star.filled, index) }}
		</text>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'

	// 定义星星对象类型
	type StarItem = {
		filled: boolean
		half?: boolean
	}

	// 定义样式对象类型
	type StyleObject = {
		fontSize?: string
		color?: string
	}

	// Props定义
	type Props = {
		value?: number
		readonly?: string | null
		plain?: boolean
		selectedClass?: string
		selectedStyle?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		value: 0,
		readonly: null,
		plain: false,
		selectedClass: '',
		selectedStyle: ''
	})

	// Emits定义
	type Emits = {
		click: [value: number]
		'update:modelValue': [value: number]
	}

	const emit = defineEmits<Emits>()

	// 计算属性：星星数组
	const stars = computed(() => {
		const result: StarItem[] = []
		const currentValue = props.value ?? 0
		
		for (let i = 0; i < 5; i++) {
			if (currentValue >= i + 1) {
				// 完整星星
				result.push({ filled: true })
			} else if (currentValue > i && currentValue < i + 1) {
				// 半星 - 根据小数部分判断
				const decimal = currentValue - i
				result.push({ filled: decimal >= 0.5, half: decimal < 0.5 })
			} else {
				// 空星星
				result.push({ filled: false })
			}
		}
		
		return result
	})

	// 获取星星符号
	function getStarSymbol(filled: boolean, index: number): string {
		if (filled) {
			return '★'
		} else if (props.plain) {
			return '☆'
		} else {
			return '★'
		}
	}

	// 解析style字符串为对象
	function parseStyleString(styleStr: string): StyleObject {
		const styleObj: StyleObject = {}
		if (styleStr != '') {
			const declarations = styleStr.split(';')
			for (const declaration of declarations) {
				if (declaration.trim() != '') {
					const colonIndex = declaration.indexOf(':')
					if (colonIndex > 0) {
						const property = declaration.substring(0, colonIndex).trim()
						const value = declaration.substring(colonIndex + 1).trim()
						
						// 只处理已知的样式属性
						if (property == 'color') {
							styleObj.color = value
						} else if (property == 'fontSize') {
							styleObj.fontSize = value
						}
					}
				}
			}
		}
		return styleObj
	}

	// 获取星星样式
	function getStarStyle(filled: boolean): StyleObject {
		const baseStyle: StyleObject = {}
		
		if (filled) {
			// 选中的星星颜色
			if (props.selectedStyle != '') {
				// 解析selectedStyle字符串，只保留非文字样式
				const styleObj = parseStyleString(props.selectedStyle)
				// 在UTS中，文字样式应该通过CSS类处理，这里只返回布局相关的样式
				return baseStyle
			} else {
				// 默认选中颜色为黄色，通过CSS类处理
				return baseStyle
			}
		} else {
			// 未选中的星星颜色为灰色，通过CSS类处理
			return baseStyle
		}
	}

	// 点击处理函数
	function handleClick(e: any) {
		// 如果是只读状态，不处理点击
		if (props.readonly != null && props.readonly != '') {
			return
		}

		// 简化点击处理，使用索引方式
		// 由于UTS对事件对象属性访问的限制，我们使用更简单的方式
		// 这里假设点击的是整个rate组件，我们通过计算来模拟点击位置
		
		// 获取当前值并递增
		let currentValue = props.value ?? 0
		let newValue: number
		
		// 简单的递增逻辑：每次点击增加0.5，到5后重置为0
		if (currentValue < 5) {
			newValue = currentValue + 0.5
		} else {
			newValue = 0
		}
		
		// 确保值在有效范围内
		newValue = Math.max(0, Math.min(5, newValue))
		
		// 触发事件
		emit('click', newValue)
		emit('update:modelValue', newValue)
	}
</script>

<style>
	.uni-rate {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.uni-rate__star {
		transition: color 0.2s;
		cursor: pointer;
		user-select: none;
		line-height: 1;
		font-size: 16px;
		letter-spacing: 2px;
		color: #ececec;
	}

	.uni-rate__star--plain {
		color: #ececec;
	}

	/* 选中状态的样式 */
	.uni-rate__star.selected {
		color: #ffca3e;
	}

	.uni-rate__star.selected.plain {
		color: #ffca3e;
	}
</style>
