<template>
	<!-- TODO  Android/iOS平台不支持裁剪显示半个文字，高性能场景包裹一层view不合适，需要等App平台解决-->
	<text v-if="props.full!=true" style="white-space: nowrap;" class="active-color" :class="props.starActiveClass ?? ''" :style="props.starActiveStyle ?? ''">{{ stars }}</text> <!-- 高性能，单层，只读，不显示灰星，不支持小数。必须给value-->
  <view v-else id="rate-parent" style="position: relative;align-self: flex-start;" @click="onTap">
    <text class="stars-pos gray-stars easy-touch" :class="props.starClass ?? ''" :style="props.starStyle ?? ''">{{ stars }}</text> <!-- 背景灰星-->
    <!-- Android/iOS平台不支持裁剪显示半个文字，需通过包裹一层view裁剪实现 -->
		<view class="stars-pos active-init-width" :style="'width:'+calculatedWidth">
			<text v-if="props.full" class="active-color easy-touch" :class="props.starActiveClass ?? ''" style="white-space: nowrap;align-self: flex-start;" 
		:style=" starStyle + ';' + starActiveStyle + ';'">★★★★★</text>
		</view>
		<!-- 前景亮星，宽度根据value变化-->
  </view>
</template>

<script setup lang="uts">
defineOptions({
	externalClasses: ['star-class','star-active-class']
})
const props = defineProps<{
  /**
	 * @description 当前评分。值域为大于等于0、小于等于5的数字
	 */
	value?: number,
  /**
   * @description v-model绑定值
   */
	modelValue?: number, 
	/**
	 * @description 是否显示全部5颗星。当黄色不够5星时，是否填充灰星以达到5星的固定长度。不填充灰星性能更高
	 */
	full?: boolean, 
	/**
	 * @description 是否响应点击变化。full属性为false时不生效，即无灰星时一定只读
	 */
	readonly?: boolean, 
	/**
	 * @description 灰星是否镂空
	 */
	plain?: boolean, 
	/**
	 * @description 灰星的样式类
	 */
	starClass?: string.ClassString, 
	/**
	 * @description 灰星的内联样式
	 */
	starStyle?: string 
	/**
	 * @description 选中星星的样式类
	 */
	starActiveClass?: string.ClassString, 
	/**
	 * @description 选中星星的内联样式
	 */
	starActiveStyle?: string 
}>()

// 计算星星显示
const stars = computed(() => {
  if (props.full!=true) {
    const value = Math.max(0, Math.min(5, props.value ?? 0))
    return '★'.repeat(Math.round(value)) //返回亮星数量
  } else {
    return props.plain == true ? '☆'.repeat(5) : '★'.repeat(5) //返回灰星数量
  }
})

// 问题：props.full != true 时，下面的Script其实都没有意义，但却需要执行。但vue里又无法用if包裹下面的代码，不灵活

const emit = defineEmits<{
  change: [value: number]
  'update:modelValue': [value: number]
}>()

// 响应式数据 - 优先使用modelValue，其次使用value
const currentValue = ref<number>(0)
currentValue.value = props.modelValue ?? props.value ?? 0

// 监听props变化
watch(() : number | null => {
  return props.modelValue ?? props.value ?? null
}, (newValue : number | null) => {
  if (newValue != null && typeof newValue === 'number' && !isNaN(newValue as number)) {
    currentValue.value = newValue as number
  }
}, { immediate: true })

// 计算点亮层的宽度
const calculatedWidth = computed(() => {
  // 确保在 0 到 5 之间
  const value = currentValue.value
  const rate = Math.max(0, Math.min(5, value))
	// console.log('rate: ',rate);
	// TODO Android端小数无法正常渲染，不是宽度计算的问题
  return `${(rate / 5) * 100}%`
})
// #ifdef MP
const instance = getCurrentInstance()!.proxy!
// #endif
// 处理点击事件
function onTap(event: UniPointerEvent) : void {
  // 如果是禁用模式，不处理点击
  if (props.readonly == true) {
    return
  }

  let clickX = event.x
  let containerWidth = 0.0
  // #ifndef MP
  try {
    const target = event.currentTarget as UniElement
    if (target != null) {
      containerWidth = target.offsetWidth
    }
  } catch (e) {
    // 忽略错误
  }
	if (containerWidth > 0) {
	  const finalValue = Math.round(clickX / containerWidth * 5)
	  currentValue.value = finalValue
	  emit('change', finalValue)
	  emit('update:modelValue', finalValue)
	  return
	}
	// #endif
	// #ifdef MP
	// 小程序必须通过createSelectorQuery异步获取容器宽度且在组件中需要用 .in(instance) 指定组件作用域
	// const instance = getCurrentInstance()!.proxy! //写在这里会报错，必须写在外面
	// console.log('instance: ', instance)
	if (instance != null) {
		uni.createSelectorQuery().in(instance).select('#rate-parent').boundingClientRect((rect) => {
			// console.log('rect: ', rect)
			if (rect != null) {
				const width = rect.width
				const left = rect.left
				// 小程序的 event.x 是 clientX，需要减去 left 得到相对坐标
				let relativeX = clickX - left
				if (relativeX < 0) relativeX = 0
				if (relativeX > width) relativeX = width

				const finalValue = Math.round(relativeX / width * 5)
				currentValue.value = finalValue
				emit('change', finalValue)
				emit('update:modelValue', finalValue)
			}
		}).exec()
	}
	// #endif

  
}

// TODO 接入form表单规范，可以submit
</script>

<style>

.stars-pos {
  /* 确保两个 star 的位置重叠 */
  position: absolute;
  top: 0;
  left: 0;
  white-space: nowrap; /* 确保星不会换行 */
  overflow: hidden; /* 关键：裁剪点亮层 */
}
.gray-stars {
  color: #ccc; /* 未点亮颜色 */
  position: relative; /* 确保底层可见 */
}
.active-init-width {
  width: 0%; /* full时高亮星的初始宽度 */
}
.active-color{
 color: #ffca3e; /* 点亮颜色 */
}
.easy-touch {
	letter-spacing: 3px;
	font-size: 20px;
}
</style>