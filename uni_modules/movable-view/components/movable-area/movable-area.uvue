<template>
	<view 
		class="movable-area"
		:class="{ 'movable-area-scale': scaleArea }"
		ref="areaRef"
	>
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	type Props = {
		scaleArea?: boolean
	}
	
	const props = withDefaults(defineProps<Props>(), {
		scaleArea: false
	})
	
	const areaRef = ref<UniElement | null>(null)
	
	// 暴露给子组件的方法，用于获取区域尺寸
	type Rect = {
		width: number
		height: number
		left: number
		top: number
		right: number
		bottom: number
	}
	
	const getAreaRect = (): Promise<Rect | null> => {
		return new Promise<Rect | null>((resolve) => {
			if (areaRef.value == null) {
				resolve(null)
				return
			}
			
			// #ifdef APP
			// APP平台直接使用getBoundingClientRect
			if (areaRef.value != null) {
				const rect = areaRef.value.getBoundingClientRect()
				resolve({
					width: rect.width,
					height: rect.height,
					left: rect.left,
					top: rect.top,
					right: rect.right,
					bottom: rect.bottom
				} as Rect)
				return
			}
			// #endif
			
			// #ifndef APP
			// Web平台使用createSelectorQuery
			const query = uni.createSelectorQuery()
			query.select('.movable-area').boundingClientRect((rect: any) => {
				if (rect != null) {
					resolve({
						width: rect.width as number,
						height: rect.height as number,
						left: rect.left as number,
						top: rect.top as number,
						right: rect.right as number,
						bottom: rect.bottom as number
					} as Rect)
				} else {
					resolve(null)
				}
			}).exec()
			// #endif
		})
	}
	
	defineExpose({
		getAreaRect
	})
</script>

<style>
.movable-area {
	position: relative;
	overflow: hidden;
}

.movable-area-scale {
	/* 当启用缩放区域时，可能需要特殊的样式处理 */
}
</style>
