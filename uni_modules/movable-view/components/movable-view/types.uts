export type MovableViewChangeEventDetail = {
	x: number
	y: number
	source: string
}

export type MovableViewChangeEvent = {
	detail: MovableViewChangeEventDetail
}

export type MovableViewScaleEventDetail = {
	scale: number
	x: number
	y: number
}

export type MovableViewScaleEvent = {
	detail: MovableViewScaleEventDetail
}
