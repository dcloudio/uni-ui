<template>
	<view 
		class="movable-view"
		:style="viewStyle"
		ref="viewRef"
		@touchstart="handleTouchStart"
		@touchmove="handleTouchMove"
		@touchend="handleTouchEnd"
		@touchcancel="handleTouchCancel"
	>
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	import { MovableViewChangeEvent, MovableViewScaleEvent, MovableViewChangeEventDetail, MovableViewScaleEventDetail } from './types.uts'

	type Props = {
		x?: number
		y?: number
		direction?: "all" | "vertical" | "horizontal" | "none"
		inertia?: boolean
		outOfBounds?: boolean
		damping?: number
		friction?: number
		scale?: boolean
		scaleMin?: number
		scaleMax?: number
		scaleValue?: number
	}
	
	const props = withDefaults(defineProps<Props>(), {
		x: 0,
		y: 0,
		direction: "none",
		inertia: false,
		outOfBounds: false,
		damping: 20,
		friction: 2,
		scale: false,
		scaleMin: 0.5,
		scaleMax: 2,
		scaleValue: 1
	})
	
	const emit = defineEmits<{
		change: [event: MovableViewChangeEvent]
		scale: [event: MovableViewScaleEvent]
	}>()
	
	const viewRef = ref<UniElement | null>(null)
	
	// 内部状态
	const innerX = ref<number>(props.x)
	const innerY = ref<number>(props.y)
	const innerScale = ref<number>(props.scaleValue)
	
	// 触摸相关状态
	let touchStartX = 0
	let touchStartY = 0
	let touchStartTime = 0
	let viewStartX = 0
	let viewStartY = 0
	let isDragging = false
	let isScaling = false
	let initialDistance = 0
	let initialScale = 1
	
	// 区域和视图尺寸
	let areaWidth = 0
	let areaHeight = 0
	let viewWidth = 0
	let viewHeight = 0
	
	type Rect = {
		width: number
		height: number
		left: number
		top: number
		right: number
		bottom: number
	}

	type Position = {
		x: number
		y: number
	}

	type Delta = {
		deltaX: number
		deltaY: number
	}
	
	// 惯性相关
	let velocityX = 0
	let velocityY = 0
	let lastMoveTime = 0
	let lastMoveX = 0
	let lastMoveY = 0
	const isAnimating = ref<boolean>(false)
	
	// 计算视图样式
	const viewStyle = computed((): string => {
		let transforms : string[] = []
		transforms.push(`translate(${innerX.value}px, ${innerY.value}px)`)
		if (props.scale) {
			transforms.push(`scale(${innerScale.value})`)
		}
		let style = `transform: ${transforms.join(' ')};`

		// 惯性动画时添加 transition
		if (isAnimating.value && props.inertia) {
			// 根据速度计算持续时间，速度越大持续时间越长
			const speed = Math.sqrt(velocityX * velocityX + velocityY * velocityY)
			const duration = Math.min(Math.max(speed * 100, 300), 1000) // 300ms - 1000ms
			style += ` transition: transform ${duration}ms cubic-bezier(0.25, 0.46, 0.45, 0.94);`
		}

		return style
	})
	
	// 获取区域尺寸（从父组件）
	const getAreaRect = (): Promise<Rect | null> => {
		return new Promise<Rect | null>((resolve) => {
			if (viewRef.value != null) {
				const parentElement = viewRef.value.parentElement
				if (parentElement != null) {
					const rect = parentElement.getBoundingClientRect()
					resolve({
						width: rect.width,
						height: rect.height,
						left: rect.left,
						top: rect.top,
						right: rect.right,
						bottom: rect.bottom
					} as Rect)
					return
				}
			}
			resolve(null)
		})
	}
	
	// 获取视图尺寸
	const getViewRect = (): Promise<Rect | null> => {
		return new Promise<Rect | null>((resolve) => {
			if (viewRef.value == null) {
				resolve(null)
				return
			}

			const rect = viewRef.value.getBoundingClientRect()
			resolve({
				width: rect.width,
				height: rect.height,
				left: rect.left,
				top: rect.top,
				right: rect.right,
				bottom: rect.bottom
			} as Rect)
		})
	}
	
	// 初始化尺寸
	const initSizes = async (): Promise<void> => {
		const areaRect = await getAreaRect()
		const viewRect = await getViewRect()
		
		if (areaRect != null) {
			areaWidth = areaRect.width
			areaHeight = areaRect.height
		}
		
		if (viewRect != null) {
			viewWidth = viewRect.width
			viewHeight = viewRect.height
		}
	}
	
	// 限制坐标在边界内
	const clampPosition = (x: number, y: number): Position => {
		let clampedX = x
		let clampedY = y

		// 计算缩放后的实际尺寸
		const scaledWidth = viewWidth * innerScale.value
		const scaledHeight = viewHeight * innerScale.value

		// 超出边界的最大距离（仅当 outOfBounds 为 true 时生效）
		const maxOutOfBounds = 5

		// X轴限制
		if (scaledWidth <= areaWidth) {
			const minX = props.outOfBounds ? -maxOutOfBounds : 0
			const maxX = props.outOfBounds ? areaWidth - scaledWidth + maxOutOfBounds : areaWidth - scaledWidth
			clampedX = Math.max(minX, Math.min(x, maxX))
		} else {
			// 视图大于区域时，确保区域在视图内
			const minX = props.outOfBounds ? areaWidth - scaledWidth - maxOutOfBounds : areaWidth - scaledWidth
			const maxX = props.outOfBounds ? maxOutOfBounds : 0
			clampedX = Math.max(minX, Math.min(x, maxX))
		}

		// Y轴限制
		if (scaledHeight <= areaHeight) {
			const minY = props.outOfBounds ? -maxOutOfBounds : 0
			const maxY = props.outOfBounds ? areaHeight - scaledHeight + maxOutOfBounds : areaHeight - scaledHeight
			clampedY = Math.max(minY, Math.min(y, maxY))
		} else {
			const minY = props.outOfBounds ? areaHeight - scaledHeight - maxOutOfBounds : areaHeight - scaledHeight
			const maxY = props.outOfBounds ? maxOutOfBounds : 0
			clampedY = Math.max(minY, Math.min(y, maxY))
		}

		return { x: clampedX, y: clampedY }
	}
	
	// 根据方向限制移动
	const applyDirection = (deltaX: number, deltaY: number): Delta => {
		if (props.direction == "all") {
			return { deltaX, deltaY }
		} else if (props.direction == "horizontal") {
			return { deltaX, deltaY: 0 }
		} else if (props.direction == "vertical") {
			return { deltaX: 0, deltaY }
		} else {
			return { deltaX: 0, deltaY: 0 }
		}
	}
	
	// 更新位置并触发事件
	const updatePosition = (x: number, y: number, source: string): void => {
		const clamped = clampPosition(x, y)
		innerX.value = clamped.x
		innerY.value = clamped.y

		const eventDetail : MovableViewChangeEventDetail = {
			x: innerX.value,
			y: innerY.value,
			source: source
		}
		const event : MovableViewChangeEvent = {
			detail: eventDetail
		}
		emit('change', event)
	}
	
	// 计算两点间距离
	const getDistance = (touches: Touch[]): number => {
		if (touches.length < 2) {
			return 0
		}
		const touch1 = touches[0]
		const touch2 = touches[1]
		const dx = touch1.clientX - touch2.clientX
		const dy = touch1.clientY - touch2.clientY
		return Math.sqrt(dx * dx + dy * dy)
	}
	
	// 触摸开始
	const handleTouchStart = (e: TouchEvent): void => {
		// 取消惯性动画
		isAnimating.value = false

		isDragging = false
		isScaling = false
		
		if (e.touches.length == 1) {
			// 单指拖动
			touchStartX = e.touches[0].clientX
			touchStartY = e.touches[0].clientY
			touchStartTime = Date.now()
			viewStartX = innerX.value
			viewStartY = innerY.value
			lastMoveX = innerX.value
			lastMoveY = innerY.value
			lastMoveTime = touchStartTime
			velocityX = 0
			velocityY = 0
		} else if (e.touches.length == 2 && props.scale) {
			// 双指缩放
			isScaling = true
			initialDistance = getDistance(e.touches)
			initialScale = innerScale.value
		}
	}
	
	// 触摸移动
	const handleTouchMove = (e: TouchEvent): void => {
		const now = Date.now()

		if (isScaling && e.touches.length == 2 && props.scale) {
			// 缩放时阻止默认事件
			e.preventDefault()
			// 双指缩放
			const currentDistance = getDistance(e.touches)
			if (initialDistance > 0) {
				const scaleDelta = currentDistance / initialDistance
				let newScale = initialScale * scaleDelta
				newScale = Math.max(props.scaleMin, Math.min(newScale, props.scaleMax))
				innerScale.value = newScale

				const scaleEventDetail : MovableViewScaleEventDetail = {
					scale: innerScale.value,
					x: innerX.value,
					y: innerY.value
				}
				const scaleEvent : MovableViewScaleEvent = {
					detail: scaleEventDetail
				}
				emit('scale', scaleEvent)
			}
		} else if (e.touches.length == 1 && !isScaling) {
			// 单指拖动
			const deltaX = e.touches[0].clientX - touchStartX
			const deltaY = e.touches[0].clientY - touchStartY

			// 判断是否应该阻止默认事件（防止与外层滚动冲突）
			const absDeltaX = Math.abs(deltaX)
			const absDeltaY = Math.abs(deltaY)

			// 根据移动方向和组件的 direction 属性决定是否阻止默认事件
			let shouldPreventDefault = false

			if (props.direction == "all") {
				// 全方向移动：只要有移动就阻止默认事件
				if (absDeltaX > 5 || absDeltaY > 5) {
					shouldPreventDefault = true
				}
			} else if (props.direction == "horizontal") {
				// 水平移动：当水平移动大于垂直移动时阻止默认事件
				if (absDeltaX > absDeltaY && absDeltaX > 5) {
					shouldPreventDefault = true
				}
			} else if (props.direction == "vertical") {
				// 垂直移动：当垂直移动大于水平移动时阻止默认事件
				if (absDeltaY > absDeltaX && absDeltaY > 5) {
					shouldPreventDefault = true
				}
			}

			if (shouldPreventDefault) {
				e.preventDefault()
				isDragging = true
			}

			if (isDragging) {
				const directionLimited = applyDirection(deltaX, deltaY)
				const newX = viewStartX + directionLimited.deltaX
				const newY = viewStartY + directionLimited.deltaY

				updatePosition(newX, newY, "touch")

				// 计算速度（用于惯性）
				if (props.inertia) {
					const timeDelta = now - lastMoveTime
					if (timeDelta > 0) {
						velocityX = (innerX.value - lastMoveX) / timeDelta
						velocityY = (innerY.value - lastMoveY) / timeDelta
					}
					lastMoveX = innerX.value
					lastMoveY = innerY.value
					lastMoveTime = now
				}
			}
		}
	}

	// 惯性动画
	const startInertiaAnimation = (): void => {
		if (!props.inertia) {
			return
		}

		// 速度太小，不启动动画
		if (Math.abs(velocityX) < 0.1 && Math.abs(velocityY) < 0.1) {
			return
		}

		// 计算惯性滑动的目标位置
		// 根据速度和摩擦力计算最终位置
		const friction = props.friction / 100
		const timeToStop = Math.log(0.01) / Math.log(1 - friction) // 速度衰减到1%所需的帧数
		const framesPerMs = 60 / 1000 // 假设60fps

		// 计算总位移（等比数列求和）
		const totalDeltaX = velocityX * 16 * (1 - Math.pow(1 - friction, timeToStop)) / friction
		const totalDeltaY = velocityY * 16 * (1 - Math.pow(1 - friction, timeToStop)) / friction

		const directionLimited = applyDirection(totalDeltaX, totalDeltaY)
		const targetX = innerX.value + directionLimited.deltaX
		const targetY = innerY.value + directionLimited.deltaY

		// 启动动画标记
		isAnimating.value = true

		// 更新到目标位置（CSS transition 会自动处理动画）
		updatePosition(targetX, targetY, "friction")

		// 动画结束后重置标记
		const speed = Math.sqrt(velocityX * velocityX + velocityY * velocityY)
		const duration = Math.min(Math.max(speed * 100, 300), 1000)
		setTimeout(() => {
			isAnimating.value = false
		}, duration)
	}
	
	// 触摸结束
	const handleTouchEnd = (e: TouchEvent): void => {
		isScaling = false
		
		if (isDragging && props.inertia) {
			// 启动惯性动画
			startInertiaAnimation()
		}
		
		isDragging = false
	}
	
	// 触摸取消
	const handleTouchCancel = (e: TouchEvent): void => {
		isScaling = false
		isDragging = false
	}
	
	// 监听props变化
	watch((): number => props.x, (newVal: number) => {
		if (!isDragging) {
			innerX.value = newVal
			updatePosition(innerX.value, innerY.value, "touch")
		}
	})
	
	watch((): number => props.y, (newVal: number) => {
		if (!isDragging) {
			innerY.value = newVal
			updatePosition(innerX.value, innerY.value, "touch")
		}
	})
	
	watch((): number => props.scaleValue, (newVal: number) => {
		if (!isScaling) {
			innerScale.value = Math.max(props.scaleMin, Math.min(newVal, props.scaleMax))
			const scaleEventDetail : MovableViewScaleEventDetail = {
				scale: innerScale.value,
				x: innerX.value,
				y: innerY.value
			}
			const scaleEvent : MovableViewScaleEvent = {
				detail: scaleEventDetail
			}
			emit('scale', scaleEvent)
		}
	})
	
	// 初始化
	onMounted(() => {
		innerX.value = props.x
		innerY.value = props.y
		innerScale.value = props.scaleValue
		setTimeout(() => {
			initSizes()
		}, 100)
	})
	
	onUnmounted(() => {
		// 清理动画状态
		isAnimating.value = false
	})
</script>

<style>
.movable-view {
	position: absolute;
}
</style>
