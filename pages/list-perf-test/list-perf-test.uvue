<script setup lang="uts">
import timeFormat from '@/components/time-format/time-format.uvue'
import { mockListData, type ListItemData } from './mock-data.uts'

// 使用预生成的数据
const listData = ref<ListItemData[]>([])

onMounted(() => {
	// console.log('加载预生成的4000条数据')
	listData.value = mockListData
	// console.log('数据加载完成')
})

function onTitleClick(index: number) {
	uni.showToast({
		title: `序号: ${index}`,
		icon: 'none'
	})
}

function onImageClick(urls: string[], current: number) {
	uni.previewImage({
		urls: urls,
		current: current
	})
}
</script>

