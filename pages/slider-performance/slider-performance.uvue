<template>
  <view class="page">
    <view class="header">
      <text class="title">Slider 性能测试</text>
      <text class="subtitle">100个slider共享同一个值</text>
    </view>

    <view class="content">
      <view class="control-section">
        <view style="flex:1;">
          <slider2 :value="sharedValue" @input="onSharedInput" @change="onSharedChange" show-value />
        </view>
      </view>

      <scroll-view class="sliders-scroll" scroll-y>
        <view class="sliders-section">
          <view v-for="index in 100" :key="index" class="slider-item">
            <text class="slider-label">{{ displayIndex(index) }}</text>
                <view style="flex:1;">
                  <slider2 :value="sharedValue" @input="onSharedInput" />
                </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import slider2 from '@/uni_modules/slider/components/slider/slider.uvue'

  const sharedValue = ref(50)
  
  function displayIndex(index: number): string {
    index = index - 1
    return index < 10 ? `0${index}` : index + ''
  }

  function onSharedInput(val: number) {
    sharedValue.value = val
  }

  function onSharedChange(val: number) {
    console.log('change:', val)
  }
</script>

