<template>
	<!-- #ifdef APP -->
	<scroll-view class="page" style="flex: 1;">
	<!-- #endif -->
		<!-- #ifndef APP -->
		<view class="page">
		<!-- #endif -->
			<text class="page-title">movable-view 可拖动视图</text>

			<!-- 事件监听演示 -->
			<!-- <view class="section event-section">
				<text class="section-title">事件监听实时演示</text>
				<view class="event-info-box">
					<view class="event-row">
						<text class="event-label">@change 事件：</text>
