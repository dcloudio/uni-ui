		border-left-color: #007AFF;
		padding-left: 10px;
	}

	.example {
		margin-bottom: 20px;
	}

	.example-title {
		font-size: 14px;
		font-weight: bold;
		color: #333;
		margin-bottom: 5px;
	}

	.example-desc {
		font-size: 12px;
		color: #666;
		margin-bottom: 10px;
	}

	.movable-area {
		height: 150px;
		width: 100%;
		background-color: #E8E8E8;
		border-radius: 4px;
		overflow: hidden;
		margin-bottom: 10px;
	}

	.movable-view {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 75px;
		width: 75px;
		background-color: #007AFF;
		border-radius: 4px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}

	.max {
		width: 250px;
		height: 250px;
	}

	.link {
		color: #007AFF;
		font-size: 14px;
		text-decoration-line: underline;
		/* #ifdef WEB */
		cursor: pointer;
		/* #endif */
	}

	.info-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-top: 5px;
	}

	.info-text {
		font-size: 12px;
		color: #666;
	}

	.event-section {
		background-color: #FFF9E6;
		border-width: 2px;
		border-color: #FFD700;
	}

	.event-info-box {
		background-color: #ffffff;
		border-radius: 4px;
		padding: 10px;
		margin-bottom: 10px;
	}

	.event-row {
		flex-direction: row;
		margin-bottom: 8px;
	}

	.event-label {
		font-size: 13px;
		font-weight: bold;
		color: #666;
		width: 120px;
	}

	.event-value {
		font-size: 13px;
		color: #007AFF;
		font-weight: bold;
		flex: 1;
	}

	.event-tip {
		font-size: 12px;
		color: #999;
		font-style: italic;
		text-align: center;
	}

	.event-detail {
		background-color: #F0F8FF;
		border-radius: 4px;
		padding: 8px;
		margin-top: 8px;
	}

	.event-detail-text {
		font-size: 12px;
		color: #007AFF;
		font-family: monospace;
	}
</style>
