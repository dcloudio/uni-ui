<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex: 1; padding: 15px;">
	<!-- #endif -->
	<!-- #ifndef APP -->
	<view style="padding: 15px;">
	<!-- #endif -->
		<text style="font-size: 18px; font-weight: bold; color: #333; margin-bottom: 20px;">NumberBox 数字输入框</text>

		<!-- 基础用法 -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">基础用法：</text>
			<uni-number-box v-model="value1" @change="onChange" />
			<text style="color: #999; margin-top: 5px;">当前值：{{ value1 }}</text>
		</view>

		<!-- 设置最小值和最大值 -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">设置范围 (min=5, max=20)：</text>
			<uni-number-box v-model="value2" :min="5" :max="20" />
			<text style="color: #999; margin-top: 5px;">当前值：{{ value2 }}</text>
		</view>

		<!-- 设置步长 -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">步长为5 (step=5)：</text>
			<uni-number-box v-model="value3" :step="5" />
			<text style="color: #999; margin-top: 5px;">当前值：{{ value3 }}</text>
		</view>

		<!-- 小数步长 -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">小数步长 (step=0.1)：</text>
			<uni-number-box v-model="value4" :step="0.1" :min="0" :max="10" />
			<text style="color: #999; margin-top: 5px;">当前值：{{ value4 }}</text>
		</view>

		<!-- 禁用状态 -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">禁用状态：</text>
			<uni-number-box :value="5" :disabled="true" />
		</view>

		<!-- 自定义样式 btn-class -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">自定义按钮样式 (btn-class)：</text>
			<uni-number-box v-model="value5" btn-class="custom-btn" />
		</view>

		<!-- 自定义样式 input-class -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">自定义输入框样式 (input-class)：</text>
			<uni-number-box v-model="value6" input-class="custom-input" />
		</view>

		<!-- 自定义样式组合 -->
		<view style="margin-bottom: 20px;">
			<text style="color: #666; margin-bottom: 10px;">自定义样式组合 (蓝色主题)：</text>
			<uni-number-box v-model="value7" btn-class="blue-btn" input-class="blue-input" icon-class="blue-icon" />
		</view>

		<!-- 暗黑模式 -->
		<view style="margin-bottom: 20px; background-color: #1a1a1a; padding: 15px; border-radius: 8px;">
			<text style="color: #fff; margin-bottom: 10px;">暗黑模式：</text>
			<uni-number-box v-model="value8" btn-class="dark-btn" input-class="dark-input" icon-class="dark-icon" />
			<text style="color: #999; margin-top: 5px;">当前值：{{ value8 }}</text>
		</view>

	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	<!-- #ifndef APP -->
	</view>
	<!-- #endif -->
</template>

<script setup lang="uts">
const value1 = ref<number>(1)
const value2 = ref<number>(10)
const value3 = ref<number>(0)
const value4 = ref<number>(0.5)
const value5 = ref<number>(1)
const value6 = ref<number>(1)
const value7 = ref<number>(1)
const value8 = ref<number>(1)

const onChange = (value : number) : void => {
	console.log('number-box change:', value)
}
</script>

<style>
.custom-btn {
	background-color: #28a745;
}

.custom-input {
	background-color: #fff3cd;
	color: #856404;
	width: 80px;
}

.dark-btn {
	background-color: #333;
}

.dark-input {
	background-color: #333;
	color: #fff;
}

.dark-icon {
	background-color: #fff;
}

.blue-btn {
	background-color: #007aff;
}

.blue-input {
	background-color: #e8f4ff;
	color: #007aff;
}

.blue-icon {
	background-color: #fff;
}
</style>
