	}

	const closeScrollPenetrationPop = () => {
		showScrollPop.value = false
	}

	// 自定义动画弹层方法
	const showCustomAnimationPop = () => {
		// #ifdef APP
		// APP 平台：使用 CSS class 控制 transition
		// 步骤1：先设置初始状态（缩小+完全透明），无 transition class
		customAnimClass.value = '' // 无 transition，避免首次渲染时的意外动画
		customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0;'
		showCustomAnimPop.value = true

		// 步骤2：延迟 50ms 后添加 transition class（但值保持在初始状态）
		setTimeout(() => {
			customAnimClass.value = 'custom-anim-transition' // 添加 CSS class 的 transition

			// 步骤3：再延迟 50ms 改变值，触发动画
			setTimeout(() => {
				customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(1); opacity: 1;'
			}, 50)
		}, 50)
		// #endif

		// #ifndef APP
		// Web 和 微信小程序：使用 inline style 控制 transition
		// 步骤1：先设置初始状态（缩小+完全透明，无 transition）
		customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; transition: none;'
		showCustomAnimPop.value = true

		// 步骤2：延迟 50ms 后添加 transition（但值保持在初始状态）
		setTimeout(() => {
			customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; transition: transform 300ms ease-out, opacity 300ms ease-out;'

			// 步骤3：再延迟 50ms 改变值，触发动画
			setTimeout(() => {
				customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(1); opacity: 1; transition: transform 300ms ease-out, opacity 300ms ease-out;'
			}, 50)
		}, 50)
		// #endif
	}

	const closeCustomAnimationPop = () => {
		// #ifdef APP
		// APP 平台：使用 CSS class 控制 transition
		customAnimClass.value = 'custom-anim-transition-close'
		customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0;'

		setTimeout(() => {
			showCustomAnimPop.value = false
			// 重置状态，为下次打开做准备
			customAnimClass.value = ''
			customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0;'
		}, 350)
		// #endif

		// #ifndef APP
		// Web 和 微信小程序：使用 inline style 控制 transition
		customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; transition: transform 300ms ease-in, opacity 300ms ease-in;'

		setTimeout(() => {
			showCustomAnimPop.value = false
			// 重置状态，为下次打开做准备
			customAnimStyle.value = 'top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; transition: none;'
		}, 350)
		// #endif
	}
</script>

<style>
	.custom-pop {
		box-shadow: 4px 4px 12px rgba(0, 0, 0, 0.15);
	}

	/* #ifdef APP */
	/* 自定义动画的 transition class（APP 平台通过 CSS class 控制 transition） */
	.custom-anim-transition {
		transition-duration: 300ms;
		transition-property: transform, opacity;
		transition-timing-function: ease-out;
	}

	.custom-anim-transition-close {
		transition-duration: 300ms;
		transition-property: transform, opacity;
		transition-timing-function: ease-in;
	}
	/* #endif */

	.button-wrap{
		flex-direction: row;
		flex-wrap: wrap;
		/* #ifndef APP */
		gap: 10px;
		/* #endif */
		/* #ifdef APP */
		justify-content: space-around;
		/* #endif */
	}
</style>