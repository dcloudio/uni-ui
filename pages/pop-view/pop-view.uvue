	// 自定义动画弹层方法
	const showCustomAnimationPop = () => {
		showCustomAnimPop.value = true
		// 初始状态：缩小+透明
		customAnimClass.value = 'custom-anim-start'
		// 延迟一帧后触发动画：正常大小+不透明
		setTimeout(() => {
			customAnimClass.value = 'custom-anim-end'
		}, 50)
	}

	const closeCustomAnimationPop = () => {
		// 先触发关闭动画：缩小+透明
		customAnimClass.value = 'custom-anim-start'
		// 等待动画完成后关闭弹层
		setTimeout(() => {
			showCustomAnimPop.value = false
		}, 300)
	}
</script>

<style>
	.custom-pop {
		box-shadow: 4px 4px 12px rgba(0, 0, 0, 0.15);
	}

	/* 自定义动画样式 */
	.custom-anim-start {
		transition-duration: 300ms;
		transition-property: transform, opacity;
		transition-timing-function: ease-out;
		transform: translate(-50%, -50%) scale(0.8);
		opacity: 0.3;
	}

	.custom-anim-end {
		transition-duration: 300ms;
		transition-property: transform, opacity;
		transition-timing-function: ease-out;
		transform: translate(-50%, -50%) scale(1);
		opacity: 1;
	}

	.button-wrap{
		flex-direction: row;
		flex-wrap: wrap;
		/* #ifndef APP */
		gap: 10px;
		/* #endif */
		/* #ifdef APP */
		justify-content: space-around;
		/* #endif */
	}
</style>