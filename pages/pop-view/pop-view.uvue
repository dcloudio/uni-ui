<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex: 1; padding: 15px;">
	<!-- #endif -->
	<!-- #ifndef APP -->
	<view style="padding: 15px;">
	<!-- #endif -->
		<text style="font-size: 18px; font-weight: bold; color: #333; margin-bottom: 20px;">Pop-View 组件演示</text>

		<!-- 基础弹出位置演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">基础弹出位置</text>

			<view class="button-wrap">
				<button @click="showCenterPop" size="mini">居中弹出</button>
				<button @click="showTopPop" size="mini">顶部弹出</button>
				<button @click="showBottomPop" size="mini">底部弹出</button>
				<button @click="showLeftPop" size="mini">左侧弹出</button>
				<button @click="showRightPop" size="mini">右侧弹出</button>
				<button @click="showCustomPop" size="mini">自定义弹出位置</button>
			</view>
		</view>

		<!-- 蒙层演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">蒙层演示</text>

			<view class="button-wrap">
				<button @click="showMaskPop" size="mini">显示蒙层</button>
				<button @click="showMaskClickClosePop" size="mini">点击蒙层关闭</button>
				<button @click="showTransparentMaskPop" size="mini">透明蒙层</button>
				<button @click="nonMaskPop" size="mini">不要蒙层</button>
			</view>
		</view>

		<!-- 跟随元素演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">跟随元素演示</text>

			<view style="align-items: center;">
				<button ref="followBtnUp" @click="showFollowPopUp" size="mini">向上弹出</button>
				<button ref="followBtnDown" @click="showFollowPopDown" size="mini" style="margin-top: 5px;">向下弹出</button>
				<button ref="followBtnLeft" @click="showFollowPopLeft" size="mini" style="margin-top: 5px;">向左弹出</button>
				<button ref="followBtnRight" @click="showFollowPopRight" size="mini" style="margin-top: 5px;">向右弹出</button>
			</view>

			<view style="margin-top: 10px; align-items: center;">
				<button ref="followBtnArrow" @click="showFollowPopWithArrow" size="mini">带箭头</button>
				<button ref="followBtnOffset" @click="showFollowPopWithOffset" size="mini" style="margin-top: 5px;">带偏移</button>
			</view>
		</view>

		<!-- 对齐方式演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">跟随元素对齐方式演示</text>

			<view class="button-wrap">
				<button ref="alignBtnDownLeft" @click="showAlignDownLeft" size="mini">下方左对齐</button>
				<button ref="alignBtnDownCenter" @click="showAlignDownCenter" size="mini">下方水平居中</button>
				<button ref="alignBtnDownRight" @click="showAlignDownRight" size="mini">下方右对齐</button>
			</view>

			<view class="button-wrap">
				<button ref="alignBtnRightTop" @click="showAlignRightTop" size="mini">右侧上对齐</button>
				<button ref="alignBtnRightCenter" @click="showAlignRightCenter" size="mini">右侧垂直居中</button>
				<button ref="alignBtnLeftBottom" @click="showAlignLeftBottom" size="mini">左侧下对齐</button>
			</view>
		</view>

		<!-- 自动隐藏演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">自动隐藏演示</text>

			<view class="button-wrap">
				<button @click="showAutoHidePop" size="mini">2秒后自动关闭</button>
			</view>
		</view>

		<!-- 自定义样式演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">自定义样式</text>

			<view class="button-wrap">
				<button @click="showCustomStylePop" size="mini">自定义弹层样式</button>
				<button @click="showCustomMaskPop" size="mini">自定义蒙层样式</button>
			</view>
		</view>
		
		<!-- 自定义动画演示 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">自定义动画</text>

			<view class="button-wrap">
				<button @click="showCustomAnimationPop" size="mini">自定义弹层动画</button>
			</view>
		</view>

		<!-- 自定义动画弹层 -->
		<uni-pop-view
			v-if="showCustomAnimPop"
			pos="center"
			:mask-click-close="true"
			:pop-class="customAnimClass"
			@close="closeCustomAnimationPop"
		>
			<view style="min-width: 200px;">
				<text style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">自定义动画弹层</text>
				<text style="font-size: 14px; color: #666; margin-bottom: 15px;">这个弹层使用了自定义的缩放+透明度动画</text>
				<button @click="closeCustomAnimationPop" size="mini">关闭</button>
			</view>
		</uni-pop-view>

		<!-- 多层堆叠测试 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">多层堆叠测试</text>

			<view class="button-wrap">
				<button @click="showStackedLayer1" size="mini">打开第1层弹层</button>
			</view>
		</view>

		<!-- 滚动穿透测试 -->
		<view style="margin-bottom: 30px;">
			<text style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 10px;">滚动穿透测试</text>

			<view class="button-wrap">
				<button @click="showScrollPenetrationPop" size="mini">打开滚动穿透测试弹层</button>
			</view>
			<text style="font-size: 12px; color: #999; margin-top: 5px;">测试弹层内scroll-view滚动到顶部或底部时是否会影响主页面滚动</text>
		</view>
		
		<!-- uni-pop-view 组件 -->
		<uni-pop-view
			v-if="showPop"
			ref="popViewRef"
			:pos="popPos"
			:non-mask="popNonMask"
			:mask-click-close="popMaskClickClose"
			:auto-hide-duration="popAutoHideDuration"
			:pop-class="popClass"
			:pop-style="popStyle"
			:mask-class="popMaskClass"
			:mask-style="popMaskStyle"
			:menu-arrow-class="popMenuArrowClass"
			:menu-arrow-style="popMenuArrowStyle"
			@close="handleClose"
		>
			<view style="min-width: 200px;">
				<text style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">{{ popTitle }}</text>
				<text style="font-size: 14px; color: #666; margin-bottom: 15px;">{{ popContent }}</text>
				<button @click="handleClose" size="mini">关闭</button>
			</view>
		</uni-pop-view>

		<!-- 多层堆叠弹层 - 第1层 -->
		<uni-pop-view
			v-if="showStackedPop1"
			:mask-click-close="true"
			@close="closeStackedLayer1"
		>
			<!-- TODO 下面的3个弹层在Web上，手机模式下width是50%，挤在一起。Android相对正常。3层都有差异，都要拉齐 @王亚琪 -->
			<view style="padding: 10px; background-color: #fff; border-radius: 8px;">
				<text style="font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333;">第1层弹层</text>
				<text style="font-size: 14px; color: #666; margin-bottom: 15px;">这是第1层弹层,点击下方按钮可以打开第2层</text>
				<view style="flex-direction: row;justify-content: space-around;">
					<button @click="showStackedLayer2" size="mini" type="primary">打开第2层</button>
					<button @click="closeStackedLayer1" size="mini">关闭本层</button>
				</view>
			</view>
		</uni-pop-view>

		<!-- 多层堆叠弹层 - 第2层 -->
		<uni-pop-view
			v-if="showStackedPop2"
			:mask-click-close="true"
			@close="closeStackedLayer2"
		>
			<view style="padding: 10px; background-color: #f0f0f0; border-radius: 8px;">
				<text style="font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333;">第2层弹层</text>
				<text style="font-size: 14px; color: #666; margin-bottom: 15px;">这是第2层弹层,点击下方按钮可以打开第3层</text>
				<view style="flex-direction: row; justify-content: space-around;">
					<button @click="showStackedLayer3" size="mini" type="primary">打开第3层</button>
					<button @click="closeStackedLayer2" size="mini">关闭本层</button>
				</view>
			</view>
		</uni-pop-view>

		<!-- 多层堆叠弹层 - 第3层 -->
		<uni-pop-view
			v-if="showStackedPop3"
			:mask-click-close="true"
			@close="closeStackedLayer3"
		>
			<view style="padding: 10px; background-color: #e0e0e0; border-radius: 8px;">
				<text style="font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333;">第3层弹层</text>
				<text style="font-size: 14px; color: #666; margin-bottom: 15px;">这是第3层弹层,最顶层的弹层</text>
				<button @click="closeStackedLayer3" size="mini">关闭本层</button>
			</view>
		</uni-pop-view>

		<!-- 滚动穿透测试弹层 -->
		<uni-pop-view
			v-if="showScrollPop"
			:mask-click-close="true"
			@close="closeScrollPenetrationPop"
		>
			<view
				style="width: 600rpx; height: 300px; padding: 20px; background-color: #fff; border-radius: 8px;"
				@touchmove.stop.prevent
			>
				<text style="font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333;">滚动穿透测试</text>
				<text style="font-size: 14px; color: #666; margin-bottom: 15px;">滑动下方内容到顶部或底部,观察主页面是否跟随滚动</text>

				<!-- scroll-view内部滚动,外层容器阻止穿透 -->
				<scroll-view
					ref="scrollViewRef"
					class="scroll-container"
					style="flex: 1; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 15px;"
					scroll-y="true"
				>
					<view style="padding: 15px;">
						<text style="font-size: 14px; color: #333; line-height: 24px;">
							这是一个可滚动的内容区域。
							{{ '\n\n' }}
							请向上或向下滚动此区域。
							{{ '\n\n' }}
							当滚动到顶部或底部边界时
							{{ '\n\n' }}
							测试主页面是否会跟随滚动(滚动穿透问题)
							{{ '\n\n' }}
							理想情况下,当弹层内的scroll-view滚动到边界时,不应该触发主页面的滚动。
							{{ '\n\n' }}
							已到达底部,现在可以测试向上滚动到顶部的情况。
						</text>
					</view>
				</scroll-view>

				<button @click="closeScrollPenetrationPop" size="mini">关闭</button>
			</view>
		</uni-pop-view>

	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	<!-- #ifndef APP -->
	</view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { ComponentPublicInstance } from 'vue'

	// 定义 uni-pop-view 组件暴露的方法接口
	type PopViewExpose = {
		followElement: (element: Element, side: "up" | "down" | "left" | "right", offsetX: number, offsetY: number, showArrow: boolean, align: "left" | "right" | "top" | "bottom" | "center-horizontal" | "center-vertical") => void
		close: () => void
	}

	// 弹层状态
	const showPop = ref<boolean>(false)
	const popPos = ref<"center" | "left" | "right" | "top" | "bottom" | "custom">("center")
	const popNonMask = ref<boolean>(false)
	const popMaskClickClose = ref<boolean>(false)
	const popAutoHideDuration = ref<number>(0)
	const popClass = ref<string>('')
	const popStyle = ref<string>('')
	const popMaskClass = ref<string>('')
	const popMaskStyle = ref<string>('')
	const popMenuArrowClass = ref<string>('')
	const popMenuArrowStyle = ref<string>('')
	const popTitle = ref<string>('弹层标题')
	const popContent = ref<string>('这是弹层内容')

	// 多层堆叠弹层状态
	const showStackedPop1 = ref<boolean>(false)
	const showStackedPop2 = ref<boolean>(false)
	const showStackedPop3 = ref<boolean>(false)

	// 滚动穿透测试弹层状态
	const showScrollPop = ref<boolean>(false)

	// 自定义动画弹层状态
	const showCustomAnimPop = ref<boolean>(false)
	const customAnimClass = ref<string>('custom-anim-start')

	// 引用
	const popViewRef = ref<ComponentPublicInstance | null>(null)
	const followBtnUp = ref<Element | null>(null)
	const followBtnDown = ref<Element | null>(null)
	const followBtnLeft = ref<Element | null>(null)
	const followBtnRight = ref<Element | null>(null)
	const followBtnArrow = ref<Element | null>(null)
	const followBtnOffset = ref<Element | null>(null)
	const alignBtnDownLeft = ref<Element | null>(null)
	const alignBtnDownRight = ref<Element | null>(null)
	const alignBtnDownCenter = ref<Element | null>(null)
	const alignBtnRightTop = ref<Element | null>(null)
	const alignBtnLeftBottom = ref<Element | null>(null)
	const alignBtnRightCenter = ref<Element | null>(null)

	// 定义配置类型
	type PopViewConfig = {
		pos?: "center" | "left" | "right" | "top" | "bottom" | "custom",
		nonMask?: boolean,
		maskClickClose?: boolean,
		autoHideDuration?: number,
		popClass?: string,
		popStyle?: string,
		maskClass?: string,
		maskStyle?: string,
		menuArrowClass?: string,
		menuArrowStyle?: string,
		title?: string,
		content?: string
	}

	// 显示弹层的通用方法
	const showPopView = (config: PopViewConfig) => {
		popPos.value = config.pos ?? "center"
		popNonMask.value = config.nonMask ?? false
		popMaskClickClose.value = config.maskClickClose ?? false
		popAutoHideDuration.value = config.autoHideDuration ?? 0
		popClass.value = config.popClass ?? ''
		popStyle.value = config.popStyle ?? ''
		popMaskClass.value = config.maskClass ?? ''
		popMaskStyle.value = config.maskStyle ?? ''
		popMenuArrowClass.value = config.menuArrowClass ?? ''
		popMenuArrowStyle.value = config.menuArrowStyle ?? ''
		popTitle.value = config.title ?? '弹层标题'
		popContent.value = config.content ?? '这是弹层内容'
		showPop.value = true
	}

	// 基础弹出位置
	const showCenterPop = () => {
		showPopView({
			pos: "center",
			maskClickClose: true,
			title: '居中弹出',
			content: '这是一个居中显示的弹层'
		})
	}

	const showTopPop = () => {
		showPopView({
			pos: "top",
			nonMask: true,
			popStyle: "width:720rpx;border:1px solid #ccc;border-radius:0px 0px 6px 6px", // TODO 四边弹出时，有些样式应预置
			title: '顶部弹出',
			content: '这是一个顶部显示的弹层'
		})
	}

	const showBottomPop = () => {
		showPopView({
			pos: "bottom",
			popStyle: "width:750rpx;border-radius:6px 6px 0px 0px", // TODO 四边弹出时，有些样式应预置
			maskClickClose:true,
			title: '底部弹出',
			content: '这是一个底部显示的弹层'
		})
	}

	const showLeftPop = () => {
		showPopView({
			pos: "left",
			popStyle: "width:220px;height:100%;border-radius:0px 0px 0px 0px",
			maskClickClose:true,
			title: '左侧弹出',
			content: '这是一个左侧显示的弹层'
		})
	}

	const showRightPop = () => {
		showPopView({
			pos: "right",
			popStyle: "width:220px;height:100%;border-radius:0px 0px 0px 0px",
			maskClickClose:true,
			title: '右侧弹出',
			content: '这是一个右侧显示的弹层'
		})
	}
	
	const showCustomPop = () => {
		showPopView({
			pos: "custom",
			maskClickClose:true,
			popStyle: "bottom:20%;background-color:#ccc;align-self: center;",
			title: '弹层'
		})
	}

	// 蒙层演示
	const showMaskPop = () => {
		showPopView({
			pos: "center",
			title: '显示蒙层',
			content: '这个弹层有蒙层，但点击蒙层不会关闭'
		})
	}

	const showMaskClickClosePop = () => {
		showPopView({
			pos: "center",
			maskClickClose: true,
			title: '点击蒙层关闭',
			content: '点击或滑动蒙层可以关闭这个弹层'
		})
	}

	const showTransparentMaskPop = () => {
		showPopView({
			pos: "center",
			maskStyle: 'background-color: transparent;',
			popStyle: 'background-color: #ccc;',
			title: '透明蒙层',
			content: '这个弹层的蒙层是透明的，并且点击蒙层不会关闭'
		})
	}
	
	const nonMaskPop = () => {
		showPopView({
			pos: "center",
			nonMask: true,
			title: '不要蒙层',
			content: '这个弹层没有蒙层。会有滚动穿透问题'
		})
	}

	// 自动隐藏
	const showAutoHidePop = () => {
		showPopView({
			autoHideDuration: 2000,
			nonMask: true,
			popStyle: 'background-color:#eee',
			title: '自动隐藏',
			content: '弹层将在2秒后自动关闭'
		})
	}

	// 自定义样式
	const showCustomStylePop = () => {
		showPopView({
			pos: "center",
			nonMask: false,
			maskClickClose: true,
			popClass: 'custom-pop',
			popStyle: 'background-color: #4CAF50; border-radius: 40px; padding: 24px; height: 240px;',  /* TODO App的border-radius很小 @颜伊林*/
			title: '自定义样式',
			content: '这是一个使用自定义样式的弹层'
		})
	}

	const showCustomMaskPop = () => {
		showPopView({
			pos: "center",
			maskClickClose: true,
			maskStyle: 'background-color: rgba(76, 175, 80, 0.3);',
			title: '自定义蒙层',
			content: '这个弹层使用了绿色半透明蒙层'
		})
	}

	// 跟随元素
	const showFollowPopUp = () => {
		showPopView({
			pos: "custom",
			maskClickClose: true,
			popStyle: 'background-color: #ccc;',
			title: '向上弹出',
			content: '跟随按钮向上显示'
		})
		nextTick(() => {
			if (popViewRef.value != null && followBtnUp.value != null) {
				popViewRef.value.$callMethod('followElement', followBtnUp.value, 'up', 0, 10, false, 'center-horizontal')
			}
		})
	}

	const showFollowPopDown = () => {
		showPopView({
			pos: "custom",
			maskStyle: "background-color: transparent",
			maskClickClose: true,
			popStyle: 'background-color: #ccc;',
			title: '向下弹出',
			content: '跟随按钮向下显示'
		})
		nextTick(() => {
			if (popViewRef.value != null && followBtnDown.value != null) {
				popViewRef.value.$callMethod('followElement', followBtnDown.value, 'down', 0, 10, false, 'center-horizontal')
			}
		})
	}

	const showFollowPopLeft = () => {
		showPopView({
			pos: "custom",
			maskClickClose: true,
			popStyle: 'background-color: #ccc;',
			title: '向左弹出',
			content: '跟随按钮向左显示'
		})
		nextTick(() => {
			if (popViewRef.value != null && followBtnLeft.value != null) {
				popViewRef.value.$callMethod('followElement', followBtnLeft.value, 'left', 10, 0, false, 'center-vertical')
			}
		})
	}

	const showFollowPopRight = () => {
		showPopView({
			pos: "custom",
			maskClickClose: true,
			popStyle: 'background-color: #ccc;',
			title: '右侧弹出',
			content: '跟随按钮向右显示'
		})
		nextTick(() => {
			if (popViewRef.value != null && followBtnRight.value != null) {
				popViewRef.value.$callMethod('followElement', followBtnRight.value, 'right', 10, 0, false, 'center-vertical')
			}
		})
	}

	const showFollowPopWithArrow = () => {
		showPopView({
			pos: "custom",
			maskClickClose: true,
			popStyle: 'background-color: #ccc;',
			menuArrowStyle: 'border-bottom-color: #ccc;',
			title: '带箭头',
			content: '这个弹层带有指向按钮的箭头'
		})
		nextTick(() => {
			if (popViewRef.value != null && followBtnArrow.value != null) {
				popViewRef.value.$callMethod('followElement', followBtnArrow.value, 'down', 0, 10, true, 'center-horizontal')
			}
		})
	}

	const showFollowPopWithOffset = () => {
		showPopView({
			pos: "custom",
			maskClickClose: true,
			popStyle: 'background-color: #ccc;',
			menuArrowStyle: 'border-bottom-color: #ccc;',
			title: '带偏移',
			content: '这个弹层使用了偏移量'
		})
		nextTick(() => {
			if (popViewRef.value != null && followBtnOffset.value != null) {
				popViewRef.value.$callMethod('followElement', followBtnOffset.value, 'down', 50, 20, true, 'center-horizontal')
			}
		})
	}

	// 对齐方式演示
