  }

  .dark-arrow-strong {
    border-right-width: 2px;
    border-bottom-width: 2px;
  }

  .log-section {
    padding: 12px;
    border-radius: 8px;
    background-color: #ffffff;
  }

  .log-title {
    font-size: 13px;
