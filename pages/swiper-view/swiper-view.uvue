</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import { UniSwiperViewChangeEvent, UniSwiperViewTransitionEvent, UniSwiperViewAnimationFinishEvent } from '../../uni_modules/swiper-view/components/swiper-view/types.uts'

	// 3D卡片缩放演示
	const scaleCurrentIndex = ref<number>(0)

	// 事件演示
	const eventCurrentIndex = ref<number>(0)
	const eventSource = ref<string>('none')
	const transitionDx = ref<number>(0)
	const transitionDy = ref<number>(0)

	// 自定义数字指示器
	const customIndicatorIndex = ref<number>(0)
	const customIndicatorTotal = ref<number>(3)

	const handleScaleChange = (e: UniSwiperViewChangeEvent) => {
		scaleCurrentIndex.value = e.detail.current
	}

	const handleChange = (e: UniSwiperViewChangeEvent) => {
		eventCurrentIndex.value = e.detail.current
		eventSource.value = 'change-' + e.detail.source
	}

	const handleTransition = (e: UniSwiperViewTransitionEvent) => {
		transitionDx.value = Math.round(e.detail.dx)
		transitionDy.value = Math.round(e.detail.dy)
	}

	const handleAnimationFinish = (e: UniSwiperViewAnimationFinishEvent) => {
		eventSource.value = 'animationfinish-' + e.detail.source
	}

	const handleCustomIndicatorChange = (e: UniSwiperViewChangeEvent) => {
		customIndicatorIndex.value = e.detail.current
	}
</script>

<style lang="scss">
	/* 3D卡片缩放效果 */
	.scale-card {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: scale(0.9);
		opacity: 0.7;
		transition: all 300ms ease;
	}

	.scale-card-active {
		transform: scale(1);
		opacity: 1;
	}

	/* 自定义指示器class样式 - 使用 :deep() 穿透组件作用域 */
	:deep(.uni-swiper-indicator .uni-swiper-indicator-item.custom-item) {
		width: 16px;
		height: 4px;
		border-radius: 2px;
		background-color: rgba(255, 165, 0, 0.5);
	}

	:deep(.uni-swiper-indicator .uni-swiper-indicator-item.custom-item.custom-item-active) {
		width: 24px;
		background-color: rgba(255, 165, 0, 1);
	}
</style>
