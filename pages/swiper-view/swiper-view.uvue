					</view>
				</swiper-slider>
				<swiper-slider>
					<view style="width: 100%; height: 100%; background-color: #b2bec3; align-items: center; justify-content: center;">
						<text style="color: white; font-size: 24px;">Event 3</text>
					</view>
				</swiper-slider>
			</swiper-view>
