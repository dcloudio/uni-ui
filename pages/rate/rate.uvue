<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex: 1;padding: 5px;">
	<!-- #endif -->
	<!-- #ifndef APP -->
	<view style="padding: 5px;">
	<!-- #endif -->
		<text>评分组件用于商品评价打分、服务态度评价、用户满意度等场景。\n
		如果不需要修改评分，建议直接使用text而不是rate组件。尤其是长列表中的评分仅是显示，直接用text即可</text>
		
		<text class="title">只读评分文字</text>
		<text style="color: #ffca3e;">★★★★</text>
		
		<text class="title">高性能：只读，不显示灰星，不支持小数</text>
			<uni-rate :value="3.6"/>
		<text class="title">只读，显示灰星</text>
			<uni-rate :full="true"/>
		<text class="title">只读，小数4.3</text>
			<uni-rate :full="true" :value="4.3"/>
		<text class="title">只读，value大于5超限测试</text>
			<uni-rate :full="true" :value="100"/>
		<text class="title">只读，value小于0超限测试</text>
			<uni-rate :full="true" :value="-1"/>
		<text class="title">未选中的星星为镂空状态" </text>
			<uni-rate :full="true" :value="3.5" :plain="true" />
		<text class="title">响应点击</text>
			<uni-rate :full="true" :readonly="false" @change="onRateChange" />
		<text class="title">响应点击并双向绑定响应式变量</text>
			<uni-rate :full="true" :readonly="false" v-model="vModelRateValue" />
			<text>{{vModelRateValue}}</text>
		<text class="title">只读，程序动态赋值，不触发change</text>
			<uni-rate :value="rateValue" @change="onRateChange"/>
		<text class="title">只读，不触发change" </text>
			<uni-rate :readonly="true" :value="5" @change="onRateChange" />
		<text class="title">高性能版，自定义大小和颜色（style方式）</text>
			<uni-rate style="font-size: 32px" star-active-style="color:red" :value="4.6" />
			<!-- 仅高性能版，因为单层，可以在组件的style属性上写作用于text的样式。但规范的写法是使用star-active-style -->
		<text class="title">高性能版，自定义间隔letter-space（class方式）" </text>
			<uni-rate :value="4" star-active-class=""/>
		<text class="title">自定义默认颜色和选中颜色 class方式</text>
			<uni-rate :value="3" :full="true" star-class="custom-default" star-active-class="custom-selected"/>
			<!-- TODO 以上web不生效，需解决样式的强制scope问题 @王亚琪 -->
		<text class="title">自定义默认颜色和选中颜色 style方式</text>
			<uni-rate :value="3" :full="true" star-style="color:lightgreen" star-active-style="color:green"/>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	<!-- #ifndef APP -->
	</view>
	<!-- #endif -->
</template>
