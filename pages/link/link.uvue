<template>
  <scroll-view class="page" :class="isDarkMode ? 'theme-dark' : 'theme-light'">
    <view class="section">
      <text class="section-title">基础用法</text>
      <uni-link href="https://uniapp.dcloud.net.cn" @error="onError">https://uniapp.dcloud.net.cn</uni-link>
    </view>

    <view class="section">
      <text class="section-title">自定义样式</text>
      <uni-link href="https://doc.dcloud.net.cn/uni-app-x/" class="custom-link" @error="onError" >
        查看 uni-app x 文档
      </uni-link>
    </view>

    <view class="section">
      <text class="section-title">target="_self" (默认)</text>
      <uni-link href="https://uniapp.dcloud.net.cn" target="_self" @error="onError" >
        在 webview 中打开
      </uni-link>
      <text class="tip-text">小程序和 APP 使用 webview 页面打开链接</text>
    </view>

    <view class="section">
      <text class="section-title">target="_blank"</text>
      <uni-link href="https://uniapp.dcloud.net.cn" target="_blank" @error="onError" >
        使用外部浏览器打开
      </uni-link>
      <text class="tip-text">APP 使用 openSchema 插件，小程序复制链接提示，Web 新窗口打开</text>
    </view>

    <view class="section">
      <text class="section-title">失败示例</text>
      <uni-link href="" @error="onError" >
        空链接（触发 error）
      </uni-link>
    </view>

    <view class="log-section">
      <text class="log-title">最近事件</text>
      <text class="log-text">{{ data.lastEvent }}</text>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  import { state } from '@/store/index.uts'

  const isDarkMode = computed((): boolean => {
    return state.isDarkMode
  })

  type Data = {
    lastEvent: string
  }

  const data = reactive<Data>({
    lastEvent: '暂无事件'
  })

  function onError(message : string) {
    data.lastEvent = `error: ${message}`
    console.log(`[link] error: ${message}`)
  }

  defineExpose({
    data,
    onError
  })
</script>

<style>
  .page {
    flex: 1;
    padding: 12px;
    background-color: var(--background-color, #f8f8f8);
  }

  .section {
    padding: 12px;
    border-radius: 8px;
    background-color: var(--list-background-color, #ffffff);
    margin-bottom: 12px;
  }

  .section-title {
    font-size: 14px;
    color: var(--text-color, #333333);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .tip-text {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-color, #999999);
    opacity: 0.6;
  }

  .custom-link {
    color: #007aff;
    font-size: 20px;
  }

  .log-section {
    padding: 12px;
    border-radius: 8px;
    background-color: var(--list-background-color, #ffffff);
  }

  .log-title {
    font-size: 13px;
    color: var(--text-color, #333333);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .log-text {
    font-size: 13px;
    color: #007aff;
  }
</style>
