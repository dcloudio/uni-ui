<template>
  <!-- #ifdef APP -->
  <scroll-view scroll-x style="flex:1;">
  <!-- #endif -->
    <view class="page">
      <view class="header">
        <text class="title">Transform 性能测试</text>
        <text class="subtitle">100个元素持续使用 translateX 和 scaleX 动画</text>
      </view>

      <view class="controls">
        <button @click="toggleAnimation" class="btn">{{ isAnimating ? '停止动画' : '开始动画' }}</button>
        <text class="fps">FPS: {{ fps }}</text>
      </view>

      <view class="content">
        <view v-for="index in blockSize" :key="index" :id="`item-${index}`" class="item">
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  const blockSize = ref(100)
  const isAnimating = ref(false)
  const fps = ref(0)
  const transforms = ref<Array<UTSJSONObject>>([])
  let animationId = 0
  let lastTime = 0
  let frameCount = 0
  let fpsUpdateTime = 0

  // 初始化 transforms 数组
  function initTransforms() {
    const arr : Array<UTSJSONObject> = []
    for (let i = 0; i < 100; i++) {
      arr.push({
        x: 0,
        scale: 1,
        direction: Math.random() > 0.5 ? 1 : -1,
        speed: Math.random() * 2 + 1
      })
    }
    transforms.value = arr
  }

  let animate = (currentTime : number) => { }

  // 动画循环
  animate = (currentTime : number) => {
    if (isAnimating.value == false) {
      return
    }

    // 计算 FPS
    frameCount++
    if (Math.abs(currentTime - fpsUpdateTime) >= 1000) {
      fps.value = Math.round(frameCount * 1000 / (currentTime - fpsUpdateTime))
      frameCount = 0
      fpsUpdateTime = currentTime
    }

    // 更新每个元素的 transform
    for (let i = 0; i < transforms.value.length; i++) {
      const item = transforms.value[i]
      let x = item['x'] as number
      let scale = item['scale'] as number
      const direction = item['direction'] as number
      const speed = item['speed'] as number

      // 更新 translateX
      x += direction * speed
      if (x > 100) {
        x = 100
        item['direction'] = -1
      } else if (x < -100) {
        x = -100
        item['direction'] = 1
      }

      // 更新 scaleX (0.5 到 1.5 之间循环)
      scale += 0.01 * direction
      if (scale > 1.5) {
        scale = 1.5
      } else if (scale < 0.5) {
        scale = 0.5
      }

      // 更新数据
      item['x'] = x
      item['scale'] = scale

      const el = uni.getElementById(`item-${i + 1}`)
      if (el != null) {
        el.style.setProperty('transform', `translateX(${x}px) scaleX(${scale})`)
      }
    }

    animationId = requestAnimationFrame(animate)
  }

  // 切换动画状态
  function toggleAnimation() {
    isAnimating.value = !isAnimating.value
    if (isAnimating.value) {
      fpsUpdateTime = Date.now()
      frameCount = 0
      animationId = requestAnimationFrame(animate)
    } else {
      if (animationId != 0) {
        cancelAnimationFrame(animationId)
        animationId = 0
      }
    }
  }

  onMounted(() => {
    initTransforms()
  })

  onUnmounted(() => {
    if (animationId != 0) {
      cancelAnimationFrame(animationId)
    }
  })
</script>

<style>
  .page {
    width: 100%;
    display: flex;
    flex-direction: column;
    background-color: #f5f5f5;
  }

  .header {
    padding: 20px;
    background-color: #ffffff;
    border-bottom: 1px solid #e5e5e5;
  }

  .title {
    font-size: 24px;
    font-weight: bold;
    color: #333333;
  }

  .subtitle {
    font-size: 14px;
    color: #999999;
    margin-top: 5px;
  }

  .controls {
    padding: 15px 20px;
    background-color: #ffffff;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .btn {
    padding: 8px 20px;
    background-color: #007aff;
    color: #ffffff;
    border-radius: 4px;
    font-size: 14px;
    border: 0px;
  }

  .fps {
    margin-left: 20px;
    font-size: 16px;
    font-weight: bold;
    color: #007aff;
  }

  .content {
    flex: 1;
    padding: 20px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .item {
    width: 18%;
    height: 40px;
    margin: 1%;
    background-color: #007aff;
    border: 1px solid #000;
    /* #ifdef WEB */
    will-change: transform;
    /* #endif */
  }
</style>