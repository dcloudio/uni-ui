			</tab-list-item>

			<tab-list-item  badge-text="99+" badge-style="top:2px">
				<text class="tab-icon">🔔</text>
				<text class="tab-label" :class="activeIndex == 2 ? 'tab-label-active' : ''">通知</text>
			</tab-list-item>

			<tab-list-item  badge-style="top:2px">
