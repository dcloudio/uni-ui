		<!-- 底部选项卡 -->
		<tab-list>
			<!-- 图标高度20，文字字号10px，文字高度是14px(也就是行高大于1.4的底部会被裁剪），角标不能在图标的正右上角，需要向下偏移2px，避免角标画出tab-list之外) -->
			<tab-list-item  badge-text="5" badge-style="top:2px">
				<text class="tab-icon">🏠</text>
				<text class="tab-label" :class="activeIndex == 0 ? 'tab-label-active' : ''">首页</text>
			</tab-list-item>

			<tab-list-item  badge-text="" badge-style="top:2px">
				<text class="tab-icon">💬</text>
