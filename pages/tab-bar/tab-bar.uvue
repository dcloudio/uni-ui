	import tabContent3 from './tab-content3.uvue'
	import tabContent4 from './tab-content4.uvue'

	// 当前激活的索引
	const activeIndex = ref<number>(0)

	// 处理 tab-bar 的切换
	function handleChange(index : number) : void {
		activeIndex.value = index
		console.log('切换到索引：', index)
	}
</script>

